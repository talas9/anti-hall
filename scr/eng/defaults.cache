entry_audit.repo_cmd_roots	{"v":["docs","README.md","llms.txt","scripts/engine-deploy.sh"]}
entry_audit.rules	{"v":[{"id":"node-invocation","re":"(?:^|[\\s\\x22\\x27`(;&|=])node\\s+(?:(?:-[\\w-]+\\s+)*[\\x22\\x27]?(?:[~$/]|\\.{1,2}/|[\\w.-]*/|[\\w.-]*\\.(?:c|m)?js\\b)|-[ep]\\s)","reason":"runs a Node script; agent-facing commands call the engine directly"},{"id":"shell-invocation","re":"(?:^|[\\s\\x22\\x27`(;&|=])(?:sh|bash|zsh)\\s+(?:-\\w+\\s+)*[\\x22\\x27]?(?:[~$/]|\\.{1,2}/|[\\w.-]*/|[\\w.-]*\\.sh\\b)","reason":"runs a shell script; only the installer hooks/install.sh may be a shell file"},{"id":"script-path","re":"(?:[\\w.${}~@-]+/)+[\\w.-]*\\.(?:sh|js|mjs|cjs|py)\\b","reason":"names a js/sh/py file; commands call the engine directly"},{"id":"named-launcher","re":"\\b(?:devswarm|wake-watch)\\.js\\b","reason":"names a retired Node launcher; use `ah-engine devswarm ...` / `ah-engine mesh ...`"},{"id":"node-dir","re":"anti-hall-node","reason":"points into the retired Node backup tree"},{"id":"hook-verb","re":"(?:^|[/\\x22\\x27`])ah-hook(?:\\\\?[\\x22\\x27])?\\s+[a-z][\\w-]*","reason":"ah-hook is only the hook trigger (`ah-hook <Event>` in hooks.json), not a CLI; call `ah-engine <verb>`"},{"id":"hooks-form","line":"\"command\"\\s*:","must":"ah-hook\\\\?\"\\s+[A-Z]\\w+","path":"(^|/)hooks/hooks(\\.registry)?\\.json$","reason":"a hook command must run `ah-hook <Event>`","scope":["commands","live"]},{"id":"interp-arg","re":"<string>(?:[^<\\s]*/)?(?:node|sh|bash|zsh)</string>","reason":"a unit runs an interpreter","scope":["live"]}]}
