evidence.cfg	{"v":{"agentHealth":{"act_threshold":"0.7","ask_when":[],"backend":"haiku","choices":[["stuck","no path forward and not recovering"],["looping","repeating the same work without getting closer"],["busy","legitimately busy: a long build or test, waiting on CI or on another agent"],["done","its work is finished but it has not reported or exited"]],"daily_cap":0,"default_label":"","escalate_below":"0.75","escalate_model":"sonnet","escalate_pack_chars":3000,"kind":"labels","model":"haiku","pack_cap":6000,"question":"A tracker rule flagged this agent as unhealthy ({dur} without healthy progress). Judge from its goal, its last tool steps and outputs, its outcomes and the signal values: is it stuck (no path forward, not recovering), looping (repeating the same work), legitimately busy (a long build, a test run, waiting on CI or another agent it was told to wait for), or done but not reported (its work is finished and it has stopped)? Cite the evidence line you relied on.","required":["tool_calls:3"],"rules":[],"section_cap":2000,"sections":["goal","tool_calls","outcomes","signals"]},"agentWaste":{"act_threshold":"0.8","ask_when":[],"backend":"jev","choices":[["productive","making real progress toward its goal"],["slow-but-progressing","spending a lot but still getting closer to an outcome"],["looping","repeating the same work without getting closer"],["waiting-wasting","burning tokens while queued on a lock or waiting on a background task"],["stuck","no path to an outcome and not recovering"]],"daily_cap":0,"default_label":"","kind":"labels","pack_cap":4000,"question":"Is this agent wasting tokens? It has spent a lot over {dur} for the outcomes listed. Judge from the goal, the recent tool calls, the outcomes and the signal values: is it productive, slow but progressing, looping (repeating the same work), waiting-wasting (burning tokens while queued on a lock or a background task), or stuck (no path to an outcome)? A read-heavy role (reviewer, explorer) may spend without outcomes and still be productive.","required":["tool_calls:6"],"rules":[],"section_cap":1400,"sections":["goal","tool_calls","outcomes","signals"]},"devswarmLoop":{"act_threshold":"0.85","ask_when":["repeat_cmd_max>=3&!commits_on_step&git_known","repeat_error_max>=3&!commits_on_step&git_known","reverts>=1"],"backend":"haiku","daily_cap":10,"default_label":"not_looping","false_label":"not_looping","false_meaning":"making real progress","kind":"noul","pack_cap":3500,"question":"Is this child workspace LOOPING: repeating the same work without getting closer to finishing its current step? A rule already found a repeated command or a reverted change; confirm or refute it from the evidence and cite the line.","required":["tool_calls:10"],"rules":[{"id":"recent_progress","then":"label:not_looping","when":["minutes_since_progress<60"]}],"section_cap":1200,"sections":["tool_calls","repeats","git","heartbeats"],"true_label":"looping","true_meaning":"looping: the same work repeated with no progress"},"devswarmStepMap":{"act_threshold":"0.8","ask_when":[],"backend":"cascade","daily_cap":30,"default_label":"","kind":"steps","pack_cap":3500,"question":"Which numbered step of the plan does this progress summary describe? Use the earlier summaries and the step statuses as evidence, and cite the line you relied on.","required":["steps:2","summary_chars:15","earlier_with_step:1"],"rules":[{"id":"single_doing_step","then":"doing_step","when":["doing_count==1","!has_sequence_word"]},{"id":"summary_quotes_step","then":"overlap_step","when":["best_overlap>=0.6"]}],"section_cap":1500,"sections":["plan","summary","earlier"],"step_text_cap":60,"unknown_label":"unknown","unknown_meaning":"none of these steps"},"devswarmWaitKind":{"act_threshold":"0.85","ask_when":[],"backend":"haiku","daily_cap":30,"default_label":"","false_label":"waiting","false_meaning":"legitimately waiting on CI, the owner, a peer or a running job","kind":"noul","pack_cap":3500,"question":"No step progress for {dur}. From the evidence, is this child workspace STUCK, or legitimately waiting (on CI, the owner, a peer or a running job)? Cite the evidence line you relied on.","required":["tool_calls:5","assistant_texts:1","mesh_coverage:1"],"rules":[{"id":"child_done","then":"skip","when":["done_reported"]},{"id":"child_archived","then":"skip","when":["archived"]},{"id":"child_on_hold","then":"skip","when":["on_hold"]},{"id":"ci_running","then":"label:waiting","when":["ci_running"]},{"id":"unanswered_question_to_parent","then":"label:waiting","when":["unanswered_q_to_parent"]},{"id":"last_report_newer","then":"label:waiting","when":["last_report_newer"]},{"id":"usage_limit_pause","then":"label:waiting","when":["usage_limit_pause"]},{"id":"workspace_paused","then":"label:waiting","when":["paused"]}],"section_cap":1200,"sections":["tool_calls","assistant_texts","mesh","ci","errors"],"true_label":"stuck","true_meaning":"stuck: no outside thing it is waiting on"},"nudgeReason":{"act_threshold":"0.7","ask_when":[],"backend":"jev","daily_cap":0,"default_label":"","escalate_below":"0.8","escalate_model":"haiku","false_label":"implausible","false_meaning":"the child's activity does not fit the reason","kind":"noul","pack_cap":3000,"question":"A coordinator was told its child agent looks unhealthy and answered with the reason below to be left alone for a while. Given the child's actual recent activity, is that reason plausible?","required":["tool_calls:1"],"rules":[],"section_cap":1200,"sections":["reason","tool_calls","signals"],"true_label":"plausible","true_meaning":"the child's activity fits the reason"},"nudgeReply":{"act_threshold":"0.7","ask_when":[],"backend":"jev","choices":[["stop","it will stop the child"],["msg","it will message, redirect or unblock the child"],["snooze","it knows, the child is fine, remind it later"],["other","another reason to leave the child as it is"]],"daily_cap":0,"default_label":"","escalate_below":"0.8","escalate_model":"haiku","kind":"labels","pack_cap":2000,"question":"A coordinator was asked what to do about its unhealthy child agent and replied in prose. Which answer does the reply mean?","required":[],"rules":[],"section_cap":1200,"sections":["reply","child"]}}}
