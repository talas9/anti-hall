speculation_guard.cite_specific_re	{"v":"[./_0-9-]"}
speculation_guard.cite_token_re	{"v":"[A-Za-z0-9_./-]+"}
speculation_guard.claim_markers	{"v":["\\ball (done|set|good|fixed|green)\\b","\\b(it|that|this|everything|all of it) (now )?(works|is working|passes|is passing|is fixed|is done|is complete|is resolved)\\b","\\b(fixed|resolved|completed|finished|done|shipped|merged|pushed|deployed|verified)\\s*[.!]","\\b(fix|change|work|task|feature|migration|implementation) (is|are) (now )?(complete|done|fixed|working|merged|shipped|in place|deployed)\\b","\\b(tests|build|ci|checks) (are |is )?(now )?(all )?(green|passing|pass|passes)\\b"]}
speculation_guard.curly_double_re	{"v":"“[^“”\\n]*”"}
speculation_guard.curly_single_re	{"v":"‘[^‘’\\n]*’"}
speculation_guard.fence_line_re	{"v":"^[ \\t]{0,3}(`{3,}|~{3,})"}
speculation_guard.frame_heading	{"v":"^\\s*#{1,6}\\s+(.+?)\\s*#*\\s*$"}
speculation_guard.frame_heading_label	{"v":"^LABEL\\b"}
speculation_guard.frame_inline	{"v":"\\(unverified\\)|\\bnot yet measured\\b"}
speculation_guard.frame_label	{"v":"(?:expected|plan|should\\s+be\\s+\\w+|should\\s+still(?:\\s+\\w+)?|unverified|not\\s+yet\\s+measured)"}
speculation_guard.frame_line_prefix	{"v":"^\\s*(?:(?:[-*+\\u2022]|\\d+[.)])\\s+)?LABEL\\s*[:)]"}
speculation_guard.framed_false	{"v":"Genuine expectation/plan: a test-plan entry, acceptance criterion, or hypothesis about future or hypothetical work (\"Should be blocked: X\", \"Expected: Y\", \"not yet measured\") — not a claim about the project's actual current state."}
speculation_guard.framed_instructions	{"v":"This hedge sits under a heading or line labelled as a plan/expectation (e.g. \"Expected\", \"Plan\", \"Should be blocked:\", \"Unverified\", \"not yet measured\"). Is it still an unverified claim about the project's CURRENT/actual state presented as fact, or is it a stated expectation/plan/acceptance-criterion for work not yet done or measured?"}
speculation_guard.framed_true	{"v":"Unverified claim presented as fact: despite the label, it asserts what IS true right now about the project (a cause, a fix, a done/works/passes outcome) with no cited evidence — the framing is decorative, not honest."}
speculation_guard.guard_name	{"v":"speculation-guard"}
speculation_guard.inference_setting	{"v":{"aliases":[],"default":false,"env":"ANTIHALL_INFERENCE_CHECK","key":"inferenceCheck","option":"","section":"guards"}}
speculation_guard.jev_false	{"v":"Not speculative: it reports what a tool actually showed (command output such as \"12 pass, 0 fail\", a commit hash, grep results, a file:line reference like main.rs:42); or it honestly says something is not yet verified and names the check to run; or it makes no claim about the project at all (a question, a plan, code the user asked for, general technical knowledge, an explicit hypothetical, or small talk)."}
speculation_guard.jev_framed_id	{"v":"speculationFramed"}
speculation_guard.jev_gate	{"v":"claim"}
speculation_guard.jev_id	{"v":"speculation"}
speculation_guard.jev_instructions	{"v":"Is this assistant message speculative, i.e. does it assert a cause or an outcome about the project without cited evidence?"}
speculation_guard.jev_state_chars	{"n":1,"v":8000}
speculation_guard.jev_true	{"v":"Speculative: it asserts a cause, a fix, or a done/works/passes/resolved outcome about the project with no cited command output, test result, or file:line reference. Hedged guesses (\"probably\", \"should work\", \"I think\", \"it seems\") and confident but unsupported statements (\"Fixed.\", \"All done\") are both speculative."}
