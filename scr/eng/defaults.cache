triage.kind_criteria	{"v":[["question-needs-answer","The message asks the recipient a direct question that requires a reply before the sender can proceed."],["blocker","The message reports something actively blocking progress that the recipient needs to act on or unblock."],["status-report","The message is a routine progress/status update, not blocked and not asking anything."],["done-report","The message reports that a task or piece of work is complete/finished."],["fyi","The message is purely informational — nothing is being asked and nothing is blocked or finished."]]}
