msg.advisory_defaults	{"v":" Defaults: {count} setting(s) or file(s) fell back to a safe copy (last: {last}); fix the file or run `ah-engine config heal`."}
msg.advisory_degraded	{"v":"anti-hall engine degraded: {restarts} self-restarts, {fallbacks} Node fallbacks in the last {mins} min (`ah-engine status --json`, log {log})."}
msg.advisory_env	{"v":"⚠️ anti-hall · ah-engine: {hint}. Using the built-in checks instead."}
msg.advisory_permanent	{"v":"⚠️ anti-hall · ah-engine: stopped after repeated failures ({reason}). Using the built-in checks instead. Please file an issue: https://github.com/talas9/anti-hall/issues/new\n{diagnostics}"}
msg.agent_act_child	{"v":" Asked its coordinator {parent} to stop it."}
msg.agent_act_child_request	{"v":"agent tracker: your subagent {name} ({agent}) has been hung past the action limit. Stop it now (TaskStop {agent}) and take over or re-dispatch its work."}
msg.agent_act_codex	{"v":" Sent SIGTERM to Codex pid {pid} (it held the session's rollout open)."}
msg.agent_act_none	{"v":" Nothing was stopped: no process matched by pid; stop it by hand."}
msg.agent_act_workspace	{"v":" Asked the workspace to stop (agents send --stop-request)."}
msg.agent_armed_lapsed	{"v":"the last one lapsed {ago} ago"}
msg.agent_armed_never	{"v":"none seen"}
msg.agent_disabled	{"v":"agent tracker is off (agents.tracker)"}
msg.agent_drift	{"v":"agent tracker: your recent work does not match your declared step \"{step}\" (about {overlap}% of its words appear in what you edited or ran). Return to that step, or update the plan if the step changed."}
msg.agent_heartbeat_stale	{"v":"agent tracker: agent {agent} has not updated its heartbeat for {age} (its last step: {step}). It may be hung or finished without saying so."}
msg.agent_hung	{"v":"agent tracker: {kind} {agent} has produced no output for {idle} while still running (last activity: {tool}). Check on it, nudge it or stop it yourself; the tracker never stops an agent."}
msg.agent_idle_open_task	{"v":"agent tracker: {kind} {agent} has been idle for {idle} with its task still open ({task}). Re-task it (SendMessage) or stop it; the tracker never does either."}
msg.agent_looping	{"v":"agent tracker: {kind} {agent} has repeated the same step {count} times ({what}). It looks stuck in a loop; give it a different approach or take it over."}
msg.agent_monitor_unarmed	{"v":"agent tracker: {count} background task(s) running and no wake path armed ({armed}); you are not woken when they end. Arm `Monitor` (ah-engine agents wake-watch) with timeout_ms 1800000 (without it the Monitor expires after the 5-minute default) or `CronCreate` a check."}
msg.agent_monitor_unarmed_devswarm	{"v":"agent tracker: no Monitor wake-watch covers this workspace (its lock is missing, stale or its process is gone). Re-arm it now: call `Monitor` with command `{command}` and timeout_ms 1800000 (without it the Monitor expires after the 5-minute default; add persistent: true if your Monitor tool supports it). The cron tick stays your fallback wake path."}
msg.agent_no_tool	{"v":"its own reply"}
msg.agent_no_work	{"v":"agent tracker: {kind} {agent} finished with {tools} tool uses: it did no work, so its report is not a result. Do not count it as done; re-brief it or do the step yourself."}
msg.agent_nudge	{"v":"Your {kind} '{name}' has been running {dur}, used {tokens}, and looks unhealthy: {evidence}.{walked} Do you want to do something about it? {answer}"}
msg.agent_nudge_acted	{"v":"agent tracker: {kind} '{name}' stayed unhealthy after escalation.{action}"}
msg.agent_nudge_answer	{"v":"[nudge #{ref}] Start your reply with the ref: \"{ref}: stop\", \"{ref}: msg <text>\", \"{ref}: snooze 30 - reason\", \"{ref}: other <reason>\", or \"{ref}: \" and your answer in words. Or run: {cmd} {child} stop | msg \"<text>\" | snooze <min> [\"reason\"] | other \"<reason>\". To silence it: stop ends it; snooze <min> holds it up to {max} min; other holds it {other} min."}
msg.agent_nudge_dead	{"v":"Your {kind} '{name}' died {when} ago ({why}); marked dead."}
msg.agent_nudge_dead_batch	{"v":"{n} agents in {project} marked dead."}
msg.agent_nudge_escalate	{"v":"agent tracker escalation: {kind} '{name}' (parent {parent}) looks unhealthy ({evidence}) and {why}. {answer}"}
msg.agent_nudge_need_reason	{"v":"other needs a reason: agents nudge <child> other \"<reason>\""}
msg.agent_nudge_recorded	{"v":"nudge answer recorded for {child}: {answer} (the engine checks it at its next tick)"}
msg.agent_nudge_repeat	{"v":"Reminder {n}: your {kind} '{name}' still looks unhealthy ({evidence}). {answer}"}
msg.agent_nudge_snooze_clamped	{"v":"snoozed {child} for {min} min, the maximum (asked for {asked}); ask again when it runs out"}
msg.agent_nudge_snooze_floor	{"v":"snoozed {child} for {min} min, the shortest allowed (asked for {asked})"}
msg.agent_nudge_usage	{"v":"usage: {cmd} <child> stop | msg \"<text>\" | snooze <min> [\"reason\"] | other \"<reason>\" | <a reply in your own words>"}
msg.agent_nudge_walked	{"v":" (Its direct parent {direct} is not live, so this comes to you as the nearest live ancestor.)"}
