devswarm_cli.msg_ensure_not_owner	{"v":"existing descriptor does not belong to the current project"}
devswarm_cli.msg_ensure_tail	{"v":"run this from within that project's worktree to ensure it"}
devswarm_cli.msg_gate_merged_unverified	{"v":"[devswarm] gate: `merged` set, but HEAD does not appear to be an ancestor of the default branch (git ground-truth check) — this can be normal for a squash/rebase merge; the gate is still set (report-only, never blocked). See the parent roster for the \"(unverified)\" mark."}
devswarm_cli.msg_gate_no_block	{"v":"no active devswarm-parent-gate block is recorded for session {session} — an intent can only be attached to a condition the gate has already surfaced at least once"}
devswarm_cli.msg_gate_no_reason	{"v":"gate-intent needs --reason \"<text>\" (a non-empty stated reason)"}
devswarm_cli.msg_gate_no_session	{"v":"gate-intent needs a resolvable session id (CLAUDE_CODE_SESSION_ID not set in this environment; pass --session <id> explicitly)"}
devswarm_cli.msg_gate_tail	{"v":"run this from within that project's worktree to gate it"}
devswarm_cli.msg_gate_usage	{"v":"gate needs --set <csv> and/or --clear <csv>"}
devswarm_cli.msg_gate_write_failed	{"v":"gate write failed: {error}"}
devswarm_cli.msg_ids_join	{"v":", "}
devswarm_cli.msg_js_null_property	{"v":"Cannot read properties of null (reading '{prop}')"}
devswarm_cli.msg_live_child_warning	{"v":"child session still live for {id} (fresh heartbeat) — it may re-register and reappear; close its terminal or it will keep coming back"}
devswarm_cli.msg_lock_busy	{"v":"workspace {id} is locked by another operation in progress; retry shortly"}
devswarm_cli.msg_log_not_ok	{"v":"verb returned ok:false"}
devswarm_cli.msg_log_test_guard	{"v":"[anti-hall-log] anti-hall-log: refusing to fall back to the real home ({home}) while running under `node --test` (NODE_TEST_CONTEXT is set). This test never set ANTI_HALL_LOG_DIR, which would leak a log entry into the real ~/.anti-hall/logs/devswarm.jsonl (defect class be2c6c9e81a1/f3c1bc827d89). Set process.env.ANTI_HALL_LOG_DIR to an isolated tmp dir before requiring anything that may log."}
devswarm_cli.msg_notice_usage	{"v":"usage: notice --post \"<text>\" [--ttl 7d] | notice --list"}
devswarm_cli.msg_nudge_no_descriptor	{"v":"no descriptor for workspace {id}"}
devswarm_cli.msg_plan_bad_id	{"v":"usage: ah-engine mesh plan set|show <id> …"}
devswarm_cli.msg_plan_busy	{"v":"the plan file is locked by another writer — retry"}
