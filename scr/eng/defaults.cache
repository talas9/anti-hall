lane_test.msg_policy_why	{"v":"The owner chose to verify at deploy instead of running tests here."}
lane_test.msg_what	{"v":"a helper cannot run this full suite ({label}): {cmd}"}
lane_test.msg_why	{"v":"Full suites can queue behind a shared build lock and waste the work budget."}
