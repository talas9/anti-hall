claim_evidence.gap_skip_re	{"v":"^(?:the|a|an|this|that|these|those|it|its|their|our|my|your|his|her|all|every|each|both|any|some|of|and|or|#\\S*|v?\\d\\S*)$"}
claim_evidence.gap_word_re	{"v":"[\\w#@][\\w#@\\x27\\x{2019}/-]*"}
claim_evidence.guard_name	{"v":"claim-evidence-guard"}
claim_evidence.log_kind	{"v":"claim_evidence"}
claim_evidence.max_blocks	{"n":1,"v":2,"x":20}
claim_evidence.max_suppress_logs	{"n":0,"v":5,"x":50}
claim_evidence.modal_res	{"v":["\\b(?:will|would|shall|going to|gonna|should|might|may|must|can|could)\\b","\\b(?:to be|needs?\\s+to be|ready to be|waiting to be|yet to be|about to be)\\b"]}
claim_evidence.mode	{"v":"block"}
claim_evidence.msg_claim_instead	{"v":"run the check and show its result, or say it was not verified."}
claim_evidence.msg_claim_what	{"v":"\"{quote}\" ({claim}) has no matching check run this turn."}
claim_evidence.msg_pushed_instead	{"v":"check the run (gh run list, gh pr checks), or report it as pushed, not done."}
claim_evidence.msg_pushed_what	{"v":"pushed this turn, then called done, but CI and merge state were never checked."}
claim_evidence.msg_suppressed	{"v":"suppressed ({reason}): \"{quote}\" ({claim})"}
claim_evidence.neg_res	{"v":["\\b(?:is|are|was|were|am|be|been|has|have|had|do|does|did|can|could|will|would|should|may|might|must)\\s+not\\b","\\bnot\\s+(?:yet|fully|been)\\b","\\b(?:never|without|cannot|nothing|none|nobody|neither|nor)\\b","\\b(?:is|are|was|were|has|have|had|does|do|did|can|could|will|would|should|wo|ca)n.t\\b"]}
claim_evidence.neg_subject_res	{"v":["\\bno\\b"]}
claim_evidence.no_idiom_re	{"v":"^no\\s+(?:doubt|doubts|wonder|question|questions|kidding|way|problem|problems|worries|surprise|joke|matter|need|denying)\\b"}
claim_evidence.noun_before_re	{"v":"\\b(?:the|a|an|its|this|these|those|our|their|my|your)\\s+$"}
claim_evidence.opener_filler_re	{"v":"^(?:if|when|whenever)\\s+(?:you\\s+(?:ask|want|like|prefer|need|wish|insist)|you.d\\s+(?:like|prefer)|true|convenient|desired|curious|wanted|preferred|requested)\\b"}
claim_evidence.opener_idiom_re	{"v":"^(?:once\\s+(?:again|more)|(?:if|when|whenever)\\s+(?:asked|anything|needed|necessary|possible|so|ever)|until\\s+(?:now|today|tonight|then|yesterday|recently)|after\\s+all\\s+(?:it|this|that|they|we|the|everything)|before\\s+(?:now|today))\\b|^after\\s+all\\W*$|^whether\\b.*\\bor\\s+(?:not|no)\\b"}
claim_evidence.push_res	{"v":["\\bgit\\s+push\\b","\\bgh\\s+pr\\s+create\\b"]}
claim_evidence.quote_mark_re	{"v":"[\"“”]|\\B[\\x27‘’]|[\\x27‘’]\\B"}
claim_evidence.quoted_reason	{"v":"quoted"}
claim_evidence.reach_clause	{"n":0,"v":2,"x":6}
claim_evidence.reach_consequent	{"n":0,"v":1,"x":3}
claim_evidence.reach_label	{"n":0,"v":1,"x":3}
claim_evidence.reach_subject	{"n":0,"v":1,"x":3}
claim_evidence.reach_verb	{"n":0,"v":0,"x":3}
claim_evidence.reported_res	{"v":["\\b(?:says?|said|saying|reports?|reported|reporting|claims?|claimed|states?|stated|wrote|writes|written|mentions?|mentioned|shows?|showed|reads?|quotes?|quoted|asserts?|asserted)(?:\\s+that)?\\b","\\baccording\\s+to\\s+(?:the\\s+|a\\s+|its\\s+|this\\s+|that\\s+)?(?:pr\\s+(?:body|description)|report|logs?|bot|comment|changelog|release\\s+notes|docs?|issue|ticket|commit\\s+message|status\\s+page|dashboard)\\b"]}
claim_evidence.sentence_end_re	{"v":"[.!?]+\\s|\\n+"}
claim_evidence.skip_window	{"n":10,"v":60,"x":400}
claim_evidence.state_prefix	{"v":"claim-evidence-state-"}
claim_evidence.state_res	{"v":["\\bgh\\s+run\\s+(?:view|watch|list)\\b","\\bgh\\s+pr\\s+(?:checks|view|merge|status|list)\\b","\\bgh\\s+(?:api|workflow\\s+(?:view|run))\\b","\\bgh\\s+release\\s+(?:view|list)\\b","\\bgit\\s+(?:ls-remote|fetch)\\b"]}
claim_evidence.summary	{"v":"Stop (Claude): holds once a reply that claims a result (tests pass, verified, deployed, is fixed) with no matching tool call this turn (guards.claimEvidence), or that calls work done after a push with no look at CI or the merge state (guards.pushedNotDone)."}
claim_evidence.suppress	{"v":[{"list":"claim_evidence.neg_res","reach":"claim_evidence.reach_verb","reason":"negated"},{"idiom":"claim_evidence.no_idiom_re","list":"claim_evidence.neg_subject_res","reach":"claim_evidence.reach_subject","reason":"negated"},{"list":"claim_evidence.modal_res","reach":"claim_evidence.reach_verb","reason":"future"},{"chain":true,"idiom":"claim_evidence.opener_idiom_re","idiom_strict":"claim_evidence.opener_filler_re","list":"claim_evidence.future_res","reach":"claim_evidence.reach_clause","reason":"future"},{"compound":"claim_evidence.compound_after_re","list":"claim_evidence.reported_res","noun_before":"claim_evidence.noun_before_re","reach":"claim_evidence.reach_clause","reason":"reported"},{"list":"claim_evidence.criterion_res","reach":"claim_evidence.reach_clause","reason":"criterion"}]}
claim_evidence.sw_claim	{"v":{"default":true,"env":"ANTIHALL_CLAIM_EVIDENCE","key":"claimEvidence","option":"","section":"guards","type":"boolean"}}
