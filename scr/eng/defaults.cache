model_routing.msg_deploy_low_extra	{"v":" It also looks planning-shaped; consider opus or fable for deeper reasoning."}
model_routing.msg_deploy_low_instead	{"v":"use model:'{floor}' or higher.{extra}"}
model_routing.msg_deploy_low_what	{"v":"deploy/migration/secret-shaped spawn runs on '{model}'."}
model_routing.msg_deploy_omitted_instead	{"v":"set model:'{floor}' or higher, never haiku."}
model_routing.msg_deploy_omitted_what	{"v":"deploy/migration/secret-shaped spawn sets no explicit model."}
model_routing.msg_deploy_why	{"v":"Auth/secret edge cases get mishandled by a cheap model."}
model_routing.msg_handover_instead	{"v":"invoke the handover skill yourself in the session that holds the memory."}
model_routing.msg_handover_what	{"v":"this spawn looks like it writes a session handover."}
model_routing.msg_handover_why	{"v":"A subagent never lived this session, so its reconstruction loses decision/trial fidelity."}
model_routing.msg_row1_instead	{"v":"respawn with model:'haiku' (or 'sonnet' if it authors code)."}
model_routing.msg_row1_jev_instead	{"v":"if it is genuinely mechanical work, prefer model:'haiku'."}
model_routing.msg_row1_jev_what	{"v":"flagship spawn allowed after a non-mechanical verdict."}
model_routing.msg_row1_research_what	{"v":"flagship spawn allowed for research."}
model_routing.msg_row1_role_instead	{"v":"if it is genuinely mechanical work, prefer model:'haiku'."}
model_routing.msg_row1_role_what	{"v":"flagship spawn allowed for a debate role."}
model_routing.msg_row1_what	{"v":"routine execution was assigned to a flagship model."}
model_routing.msg_row1_why	{"v":"This hook cannot see the parent model; execution-only work needs an explicit cheap model."}
model_routing.msg_row2_adv_instead	{"v":"set model:'haiku' (or 'sonnet' if it authors code)."}
model_routing.msg_row2_adv_what	{"v":"execution-shaped spawn sets no explicit model."}
model_routing.msg_row2_adv_why	{"v":"An omitted model inherits the orchestrator's, so mechanical work may run on a flagship."}
model_routing.msg_row2_block_instead	{"v":"set model:'haiku' (or 'sonnet' for code) on the spawn."}
model_routing.msg_row2_block_override	{"v":"set ANTIHALL_MODEL_ROUTING=advisory to downgrade this block to an advisory"}
model_routing.msg_row2_block_what	{"v":"execution-shaped spawn with no explicit model is blocked (strict default)."}
model_routing.msg_row2_block_why	{"v":"An omitted model inherits the orchestrator's and cannot be verified here; on a flagship orchestrator that silently makes an all-flagship swarm."}
model_routing.msg_row2_jev_instead	{"v":"if it is genuinely mechanical work, prefer model:'haiku'."}
model_routing.msg_row2_jev_what	{"v":"default-model spawn allowed after a non-mechanical verdict."}
model_routing.msg_row3_instead	{"v":"choose a cheaper model unless the role requires a flagship."}
model_routing.msg_row3_what	{"v":"a custom agent uses a flagship model for execution."}
model_routing.msg_row4_instead	{"v":"consider opus or fable for deeper reasoning."}
model_routing.msg_row4_what	{"v":"planning work was assigned to haiku."}
model_routing.msg_row6_instead	{"v":"use an Explore agent for read-only research."}
model_routing.msg_row6_what	{"v":"research/read-only-shaped spawn uses subagent_type:'general-purpose'."}
model_routing.msg_row6_why	{"v":"general-purpose carries the Agent tool and can recurse; chains waste ~7x tokens by depth 5."}
model_routing.msg_update_instead	{"v":"run `ah-engine update ...` directly in the main session."}
model_routing.msg_update_what	{"v":"a subagent spawn that runs the anti-hall update is blocked."}
model_routing.msg_update_why	{"v":"update.js runs migrations and the main session must judge the result."}
model_routing.negated_commit_re	{"v":"\\b(?:do\\s+not|don'?t|never|without|no)\\s+(?:\\w+\\s+){0,3}?(?:git\\s+)?(?:commit|push|worktree)\\w*(?:\\s*(?:,|or|and|nor)\\s+(?:git\\s+)?(?:commit|push|worktree)\\w*)*"}
model_routing.negated_write_re	{"v":"\\b(?:do\\s+not|don'?t|never|without|no|not)\\s+(?:\\w+\\s+){0,3}?(?:git\\s+|gh\\s+)?(?:commit|push|edit|writ|creat|modif|label|updat)\\w*(?:\\s*(?:,|or|and|nor)\\s+(?:git\\s+|gh\\s+)?(?:commit|push|edit|writ|creat|modif|label|updat)\\w*)*"}
model_routing.off_mode	{"v":"off"}
model_routing.planning_intent_re	{"v":"\\b(architect(?:ure)?|brainstorm|design\\s+(?:a|the|an)\\b|plan\\s+(?:a|the|an|out)\\b|deep\\s+review|code\\s+review|design\\s+review|security\\s+review|review\\s+the\\s+(?:code|design|architecture|plan)|review\\s+(?:this|the|a)\\s+(?:pr|pull\\s+request|diff|patch|change(?:s|set)?)|audit\\s+(?:the|this)\\b|critique|debate|merge\\s+order|workflow\\s+analysis|root[- ]cause\\s+analysis|(?:find|identify|determine|diagnose|trace)\\s+(?:the\\s+)?root[- ]cause|root[- ]cause\\s+(?:why|how|the|this)|regression\\s+analysis|security\\s+audit)\\b"}
model_routing.quoted_text_re	{"v":"(^|[^\\w'])'[^']{1,1000}'|\"[^\"]{1,1000}\""}
model_routing.readonly_override_re	{"v":"\\b(?:report\\s+only|read[- ]?only|(?:do\\s+not|don'?t|never)\\s+(?:edit|modify|write|change|commit)|no\\s+(?:edits|changes|writes))\\b"}
model_routing.readonly_re	{"v":"\\b(verbatim|read[- ]?only|mechanical|append\\s*only|run\\s+exactly|do\\s+nothing\\s+else|nothing\\s+else|no\\s+other\\s+file\\s+edits|no\\s+repo\\s+edits|no\\s+source\\s+edits)\\b"}
model_routing.reasoning_re	{"v":"\\b(analy[sz]\\w*|synthesi[sz]\\w*|summari[sz]\\w*|reconcil\\w*|evaluat\\w*|interpret\\w*|distill\\w*|compare|comparison)\\b|\\bread\\w*\\b[^.\\n]{0,60}\\b(?:pdf|pdfs|pages?|papers?|documents?|specs?|transcripts?|articles?|books?|manuals?|whitepapers?)\\b|\\b\\d+[- ]page\\b|\\bpage[- ]by[- ]page\\b"}
model_routing.research_re	{"v":"\\b(research|investigate|find|search|audit|survey|read[ -]?only|locate|map|gather|explore|scout|look\\s+up|trace|reconnaissance)\\b"}
model_routing.review_design_verb_re	{"v":"\\b(review|audit|design|architect(?:ure)?|plan|brainstorm|critique|analy[sz]e|analysis|investigate|root[- ]cause)\\b"}
model_routing.role_word_re	{"v":"\\b(reviewer|auditor|critic|debate|deadly[- ]?loop)\\b"}
