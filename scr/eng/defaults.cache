session.setting_claude_cli	{"v":{"default":true,"env":"ANTIHALL_CLAUDE_CLI_VERSION_ALERT","key":"claudeCli","option":"version_alerts_claude_cli","section":"versionAlerts"}}
session.setting_defect_nudge	{"v":{"default":true,"env":"","key":"defectNudge","option":"context_defect_nudge","section":"context"}}
session.setting_devswarm	{"v":{"default":true,"env":"ANTIHALL_DEVSWARM_VERSION_ALERT","key":"devswarm","option":"version_alerts_devswarm","section":"versionAlerts"}}
session.setting_gitignore_hint	{"v":{"default":true,"env":"ANTIHALL_GITIGNORE_HINT","key":"gitignoreHint","option":"guards_gitignore_hint","section":"guards"}}
session.setting_progress_prune	{"v":{"default":true,"env":"","key":"progressPrune","option":"maintenance_progress_prune","section":"maintenance"}}
session.setting_repo_self_drift	{"v":{"default":true,"env":"ANTIHALL_REPO_SELF_DRIFT","key":"repoSelfDrift","option":"guards_repo_self_drift","section":"guards"}}
