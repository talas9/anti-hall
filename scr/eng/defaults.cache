entry_audit.allow	{"v":[{"path":"(^|/)engine/logic/.+\\.js$","reason":"QuickJS logic files: the engine runs them in-process; they are not entry points (owner design rule)","section":"files"},{"path":"(^|/)hooks/install\\.sh$","reason":"the one allowed shell file: the installer","section":"files"},{"path":"(^|/)skills/[^/]+/references/[^/]+\\.workflow\\.js$","reason":"scripts for Claude Code's Workflow tool: the host runs them, they are not entry points","section":"files"},{"path":"(^|/)web/static/","reason":"browser assets served by the dashboard (ah-web): they run in the browser and are never invoked as a command","section":"files"},{"path":"(^|/)web/pkg/","reason":"the dashboard's compiled WASM bundle (web.pkg_dir in web.toml): browser assets served by ah-web, loaded by the page and never invoked as a command","section":"files"},{"reason":"the installer hooks/install.sh is the one allowed shell file; hooks.json falls back to it while the thin client is missing","section":"commands","text":"hooks/install\\.sh"},{"path":"(^|/)engine/defaults/entry_audit\\.toml$","reason":"the audit's own rule file names the patterns it forbids","section":"commands"},{"path":"^docs/(plans|archive|specs|superpowers)/","reason":"historical record","section":"commands"},{"path":"^docs/(KB-[^/]+|CODEX-KB-MIGRATION-MAP|CONTEXT-PRESERVATION-KB|gsd-distilled|BENCHMARK-METHOD)\\.md$","reason":"historical record (knowledge-base notes and research, written against the Node-era code)","section":"commands"},{"path":"(^|/)engine/defaults/[^/]+\\.toml$","reason":"a comment in a defaults file that cites the Node-era source a table was ported from (provenance): never shown to an agent, never run, not an entry point","section":"commands","text":"^\\s*#"},{"path":"(^|/)engine/defaults/command\\.toml$","reason":"guard recognition: the command guard must still recognise an invocation of the retired devswarm.js / wake-watch.js launchers in a command an agent types, so it can steer it to `ah-engine`","rule":"named-launcher","section":"commands"},{"path":"(^|/)engine/defaults/devswarm_cli\\.toml$","reason":"recognition only: identifies mailbox crons and monitors armed by older builds (the sibling docs say no text advertises them)","section":"commands","text":"^value = \"(devswarm|devswarm-wake-watch)\\.js\"$"},{"path":"(^|/)engine/defaults/small_guards\\.toml$","reason":"guard recognition: the bookkeeping-call pattern still matches the retired launcher spellings so a call in either form is classified the same","section":"commands","text":"old `devswarm\\.js` and `ah-hook mesh` names"},{"path":"(^|/)engine/defaults/(engine|messages)\\.toml$","reason":"describes the thin client's own installer verbs (update, install, integrity, doctor): the session-start installer and the built-in doctor run them when the engine is not there to answer, so they cannot be `ah-engine` verbs; they are not agent-facing commands","rule":"hook-verb","section":"commands","text":"ah-hook (update|install|integrity|doctor)"},{"path":"(^|/)skills/activate/SKILL\\.md$","reason":"describes the installer handing over to the thin client's `install` verb (the installer path, not an agent-facing command)","rule":"hook-verb","section":"commands","text":"ah-hook install"},{"path":"(^|/)engine/defaults/routine\\.toml$","reason":"legacy recognition: the launcher shims an older install wrote, listed so the legacy sweep can move them aside; nothing runs them","section":"commands","text":"bin/(devswarm|wake-watch)"},{"path":"(^|/)engine/defaults/(engine|slcfg)\\.toml$","reason":"legacy recognition: the launcher name an earlier installer wrote into a statusLine command, matched so the migration can rewrite it to the thin client's command","section":"commands","text":"ah-run\\.sh"},{"path":"(^|/)engine/defaults/(nodeback|setup|dispatch|operator|doctor)\\.toml$","reason":"configuration of the Node fallback switch, kept until its deletion stage (owner rule: delete only on data and owner OK); the engine reads these paths only to find the fallback, no text advertises them","section":"commands","text":"anti-hall-node"},{"path":"(^|/)engine/defaults/doctor\\.toml$","reason":"a synthetic hook payload for a doctor drill: a file name inside test JSON, not a command","section":"commands","text":"file_path\\\\\":\\\\\"src/x\\.js"},{"path":"(^|/)engine/defaults/web_tel\\.toml$","reason":"a vendored browser asset served by the dashboard and loaded by the page; never run as a command","section":"commands","text":"vendor/apexcharts\\.min\\.js"},{"path":"(^|/)engine/defaults/settings_cli\\.toml$","reason":"the setting's description names the interpreters whose open-for-write paths the edit guard parses; it is guard documentation, not an instruction to run them","section":"commands","text":"literal python -c / node -e"},{"path":"(^|/)engine/defaults/messages\\.toml$","reason":"names the go-live script of the owner's deploy kit (written by scripts/engine-deploy.sh into the kit directory, never a plugin file): the recovery text for a failed live apply","section":"commands","text":"go-live\\.sh"},{"path":"(^|/)skills/(deadly-loop|ship-it)/SKILL\\.md$","reason":"scripts for Claude Code's Workflow tool: the host runs them, they are not entry points (see the matching files-section entry)","section":"commands","text":"references/[\\w-]+\\.workflow\\.js|\\.claude/workflows/ship-it\\.js"},{"path":"(^|/)codex/skills/anti-hall-omx/SKILL\\.md$","reason":"an example of the reader's own launcher wrapper (the skill shows how to write one); the file is the reader's, not shipped in the plugin","section":"commands","text":"\\./cx\\.sh resume"},{"reason":"the installer hooks/install.sh is the one allowed shell file","section":"live","text":"hooks/install\\.sh"},{"reason":"the tool shell of a Claude Code session: its scratch path names the project directory, it is not an anti-hall script","rule":"live-process","section":"live","text":"/private/tmp/claude-\\d+/"}]}
entry_audit.cmd_files	{"v":["(^|/)hooks/hooks(\\.registry)?\\.json$","(^|/)engine/defaults/[^/]+\\.toml$","(^|/)engine/rules\\.json$","(^|/)skills/.+\\.(md|txt|json)$","(^|/)monitors/[^/]+\\.json$","(^|/)PROTOCOL\\.md$","(^|/)README\\.md$","(^|/)SECURITY\\.md$","(^|/)statusline/.+\\.md$","^llms\\.txt$","^scripts/engine-deploy\\.sh$","^docs/.+\\.(md|txt)$"]}
