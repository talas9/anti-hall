roles.groups	{"v":{"agents":{"brief":"Subagent, delegation and routing guards.","prefixes":["afk-","idle-agent","silent-agent","stale-agent","orch-","model-routing","coordinator-","swarm-","phase-","ask-","verify-first-orch","edit-guard","agent-reminders","sibling-"],"settings_prefixes":["agents.","afk.","guards.coordinatorWork","guards.idle","guards.silentAgent","guards.staleAgent","guards.question","guards.noBlocking","guards.maxParallel","guards.stopNag","guards.progressFresh","guards.sharedTree","guards.siblingSweep","safety.swarmGuard","context.verifyFirstOrch","context.verifyFirstSub","context.orchFull","context.codexOrchFull"],"skill":"engine-agents","title":"Agents","use_when":"spawning, messaging or stopping agents, or delegating work and a delegation or model-routing guard applies"},"devswarm":{"brief":"The DevSwarm role, gate and wake guards.","prefixes":["devswarm-"],"settings_prefixes":["devswarm."],"skill":"engine-devswarm","title":"DevSwarm","use_when":"working in or with DevSwarm workspaces and a DevSwarm gate, role directive or wake guard applies"},"devswarm_sup":{"brief":"The DevSwarm supervisor sweep: auto-archive, pokes, app sync, retention, reconcile and housekeeping.","prefixes":[],"settings_prefixes":["devswarm.autoArchive","devswarm.nudge","devswarm.appSync","devswarm.childGateRetention","devswarm.housekeeping","devswarm.reconcile","devswarm.sweepTail","devswarm.retention","devswarm.supervisor","devswarm.activeFloor","devswarm.idleSec","devswarm.maxRecoveries","devswarm.reapedRetention","devswarm.postSpawnGraceSec","devswarm.nag","devswarm.dormantMs","devswarm.archivedChildStop","devswarm.burn","devswarm.monitor","devswarm.spawn","devswarm.stepStall","devswarm.pausedProbeMax","devswarm.startupSampling"],"skill":"engine-devswarm-supervisor","title":"DevSwarm supervisor","use_when":"tuning or checking the DevSwarm supervisor sweep (auto-archive, pokes and escalation, app sync, retention, reconcile, housekeeping)"},"doctor":{"brief":"Health check, repair, migrations and capability scans.","prefixes":["version-","claude-cli-","repo-self-","defect-","repair-","fable-","codex-","engine-role","failure-"],"settings_prefixes":["versionAlerts.","guards.repoSelfDrift","maintenance.repairOnReload","maintenance.unitsHeal","context.defectNudge","guards.updateInSession","guards.stopHookVersion","codexNudge.","guards.codexQuota"],"skill":"engine-doctor","title":"Doctor and repair","use_when":"checking whether anti-hall works, repairing it, migrating its state, or scanning what it can do on this machine"},"github":{"brief":"Git, merge and release guards.","prefixes":["git","merge-","gh-"],"settings_prefixes":["safety.gitGuard","guards.git","guards.merge","guards.shipit"],"skill":"engine-github","title":"Git and GitHub","use_when":"committing, pushing, merging or releasing and a git or merge guard applies"},"guards":{"brief":"What the automatic guards check and how to read a block.","prefixes":[],"settings_prefixes":["guards.api","guards.shellWrite","safety.commandGuard","safety.editGuard","devswarm.inlineWork","guards.allowAnthropic"],"skill":"engine-guards","title":"Guards","use_when":"an anti-hall guard blocked, warned or injected something, or you need to know which guard covers a rule"},"handovers":{"brief":"Handover, resume and compaction guards.","prefixes":["auto-handover","handover-","precompact-","compact-","progress-"],"settings_prefixes":["autoHandover.","handover.","maintenance.precompact","context.handover","guards.handoverCommit","guards.compactAdvice","guards.compactDeclaration","maintenance.progress"],"skill":"engine-handovers","title":"Handovers and compaction","use_when":"writing or resuming a handover, or compacting context, and a handover or compaction guard applies"},"mesh":{"brief":"Read the DevSwarm message store and per-project mailboxes.","prefixes":[],"settings_prefixes":[],"skill":"engine-mesh","title":"Mesh","use_when":"you need to read workspace messages, unread counts or the per-project mailbox through the engine"},"processes":{"brief":"Leftover processes, runaway CPU or memory and low disk space.","prefixes":["procwatch"],"settings_prefixes":["procwatch.","resourceWatch.","diskWatch."],"skill":"engine-processes","title":"Process, resource and disk watch","use_when":"a warning names an orphaned process, a stuck agent, heavy CPU or memory use or low disk space, or you need to tune or switch off the process, resource or disk watch"},"resources":{"brief":"Daemon status, metrics, backups, schedules and limits.","prefixes":["limit-","scan-","ctxbudget","session-end-mcp","emit-"],"settings_prefixes":["limitConserve.","context.injectGate","maintenance.sessionEnd","maintenance.mcpReaper","guards.reaper","guards.scanThrottle","guards.emitDedupe","context.dedupeWindow","guards.injectionRepeat"],"skill":"engine-resources","title":"Resources and state","use_when":"you need the engine daemon status, metrics, impact, telemetry, a backup or restore, a scheduled job, or context and usage limits"},"settings":{"brief":"Settings switches, the generated reference and the Jev classifier.","prefixes":["speculation-","claim-","output-","jev-"],"settings_prefixes":["jev","context.protocolLevel","context.verifyFirstTurn","context.verifyFirstSession","context.role","guards.speculation","guards.inference","guards.claim","guards.outputVerify","guards.failure","guards.stopAck"],"skill":"engine-settings","title":"Settings and Jev","use_when":"changing or reading an anti-hall setting or switch, looking up an engine reference, or configuring the Jev classifier"},"tasks":{"brief":"Task-list, task-lifecycle and dispatch guards.","prefixes":["task-","tasklist-","dispatch-"],"settings_prefixes":["guards.task","guards.tasklist","guards.dispatch","context.taskTracker","maintenance.taskLifecycle"],"skill":"engine-tasks","title":"Tasks and dispatch","use_when":"keeping the task list, closing out tasks, or dispatching tasks to agents and a task, task-list or dispatch guard applies"}}}
