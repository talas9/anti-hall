command.msg_dsread_instead	{"v":"read the inbox through the mesh CLI."}
command.msg_dsread_monitor_what	{"v":"`hivecontrol workspace monitor` is blocked."}
command.msg_dsread_monitor_why	{"v":"It is a long-poll with no default timeout: it hangs the shell until a message arrives and consumes the native queue."}
command.msg_dsread_override	{"v":"set DISABLE_ANTIHALL_DEVSWARM=1 to disable the read-guard entirely"}
command.msg_dsread_rm_allowed	{"v":"`message-count` reflects the NATIVE queue only; a 0 does not mean nothing is pending."}
command.msg_dsread_rm_what	{"v":"`hivecontrol workspace read-messages` is blocked."}
command.msg_dsread_rm_why	{"v":"It mark-reads and drains the native queue, losing messages the durable inbox still needs."}
command.msg_edit_instead	{"v":"spawn {sub} to make the edit and report a short summary."}
command.msg_edit_instead_tier	{"v":"for a feature, fix or deploy start a workspace: `~/.anti-hall/ah-engine/bin/ah-engine mesh spawn <branch> -p \"<brief>\"`; for a small edit spawn {sub}. Never give workspace-sized work to {sub}."}
command.msg_edit_notes	{"v":"notes in .anti-hall/history/** or the scratchpad; repo docs need a subagent or a trusted .anti-hall/edit-allow.json"}
command.msg_edit_notes_codex	{"v":"notes in .anti-hall/history/**; repo docs need {sub} or a trusted .anti-hall/edit-allow.json"}
command.msg_edit_override	{"v":"tell the agent \"skip edit-guard\" (lasts 15 minutes)."}
command.msg_edit_skip_cmd	{"v":"~/.anti-hall/ah-engine/bin/ah-engine mesh skip edit-guard"}
command.msg_edit_what	{"v":"this shell file edit must run in a helper agent."}
command.msg_edit_who_coord	{"v":"coordinator"}
command.msg_edit_who_orch	{"v":"orchestrator"}
command.msg_edit_why	{"v":"Hands-on edits belong to a worker, which reports back a short summary."}
command.msg_edit_why_orch	{"v":"Hands-on edits belong to a worker, which reports back a short summary."}
command.msg_heavy_allowed	{"v":"small checks piped to tail/head/wc, e.g. `node --test <1-2 files>`, `python3 -m pytest -q <file>`, `vitest|jest <1-2 files>`, `<cc> -fsyntax-only`, --check, --dry-run"}
command.msg_heavy_allowed_claude	{"v":"; or a read-only script in the scratchpad run in the background."}
command.msg_heavy_allowed_codex	{"v":"."}
command.msg_heavy_cd_hint	{"v":" To run the check inline, use `cd <dir> &&`, not `;`."}
command.msg_heavy_delegate	{"v":"hand it to {to}; it returns a short summary"}
command.msg_heavy_detail_category	{"v":" ({label})"}
command.msg_heavy_detail_verb	{"v":" ({label})"}
command.msg_heavy_instead_tier	{"v":"for a feature, fix or deploy start a workspace: `~/.anti-hall/ah-engine/bin/ah-engine mesh spawn <branch> -p \"<brief>\"`; for one command, {delegate}. Never give workspace-sized work to {sub}."}
command.msg_heavy_plain	{"v":"a heavy command"}
command.msg_heavy_remote	{"v":"a command that changes a shared remote"}
command.msg_heavy_remote_why	{"v":"Pushes, pulls and gh calls touch a shared remote and can stall on network or credentials, so the main thread hands them to a worker."}
command.msg_heavy_segment	{"v":" Heavy: {seg}. The other {n} are fine alone."}
command.msg_heavy_what	{"v":"{kind}{detail} can't run in the main thread."}
command.msg_heavy_why	{"v":"Its raw output would flood the main conversation."}
command.msg_mailbox_allowed	{"v":"`inbox count`, `inbox peek-primary`, `mesh read --peek`, plain `roster`."}
command.msg_mailbox_guard	{"v":"devswarm-mailbox"}
command.msg_mailbox_instead	{"v":"report back so the main agent can drain it."}
command.msg_mailbox_override	{"v":"set ANTIHALL_ALLOW_SUBAGENT_MAILBOX=1 to disable this guard entirely"}
command.msg_mailbox_what	{"v":"a helper tried to drain the DevSwarm mailbox."}
command.msg_mailbox_why	{"v":"A subagent that acks or reads advances the shared cursor, so the main thread silently misses mail (defect f0958b13fe2b)."}
command.msg_rawread_inbox_guard	{"v":"devswarm-inbox-read"}
command.msg_rawread_inbox_instead	{"v":"read the inbox through the mesh CLI."}
command.msg_rawread_inbox_what	{"v":"a shell read of the raw DevSwarm inbox file is blocked."}
command.msg_rawread_inbox_why	{"v":"It does not drain the queue, but bypasses the durable cursor, so messages get re-processed or skipped."}
command.msg_rawread_override	{"v":"set DISABLE_ANTIHALL_DEVSWARM=1 to disable this guard entirely"}
command.msg_remote_block_why	{"v":"It is hard to undo or sensitive (a merge, release, repository setting, secret or raw gh api write); hand it to a worker or ask the owner."}
command.msg_send_guard	{"v":"devswarm-mesh-only"}
command.msg_send_instead	{"v":"send the message through the DevSwarm mesh."}
command.msg_send_override	{"v":"set DISABLE_ANTIHALL_DEVSWARM=1 to disable this guard entirely"}
command.msg_send_what	{"v":"`hivecontrol workspace {kind}` is blocked."}
command.msg_send_why	{"v":"anti-hall's shared mesh store is the only agent-initiated messaging transport; a delegated send writes the native queue identically."}
command.msg_stash_allowed	{"v":"`git stash list` (read-only)."}
command.msg_stash_instead	{"v":"save the work in a WIP commit."}
