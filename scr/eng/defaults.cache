?-u:\\b)gh[pousr]_[A-Za-z0-9]{10,}(?-u:\\b)","to":"[REDACTED_KEY]"},{"no_alnum_before":false,"pattern":"(?-u:\\b)xox[baprs]-[A-Za-z0-9-]{10,}(?-u:\\b)","to":"[REDACTED_KEY]"},{"no_alnum_before":false,"pattern":"(?-u:\\b)(?:AKIA|ASIA)[0-9A-Z]{16}(?-u:\\b)","to":"[REDACTED_AWS_KEY]"},{"no_alnum_before":false,"pattern":"(?-u:\\b)([A-Za-z0-9_.-]*(?:[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[pP][aA][sS][sS][wW][dD]|[tT][oO][kK][eE][nN]|[aA][pP][iI][kK][eE][yY]|[aA][pP][iI]_[kK][eE][yY]|[kK][eE][yY])[A-Za-z0-9_.-]*)([\\x22']?[\\t\\n\\x0B\\x0C\\r \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*[:=][\\t\\n\\x0B\\x0C\\r \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*)(?:\\x22[^\\x22\\n]*\\x22|'[^'\\n]*')","to":"${1}${2}[REDACTED]"},{"no_alnum_before":false,"pattern":"(?-u:\\b)([A-Za-z0-9_.-]*(?:[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[pP][aA][sS][sS][wW][dD]|[tT][oO][kK][eE][nN]|[aA][pP][iI][kK][eE][yY]|[aA][pP][iI]_[kK][eE][yY]|[kK][eE][yY])[A-Za-z0-9_.-]*)([\\x22']?[\\t\\n\\x0B\\x0C\\r \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*[:=][\\t\\n\\x0B\\x0C\\r \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*)(?:\\x22[^\\t\\n\\x0B\\x0C\\r \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\x22',}]+\\x22|'[^\\t\\n\\x0B\\x0C\\r \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\x22',}]+'|[^\\t\\n\\x0B\\x0C\\r \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\x22',}]+)","to":"${1}${2}[REDACTED]"},{"no_alnum_before":false,"pattern":"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}","to":"[REDACTED_EMAIL]"},{"no_alnum_before":false,"pattern":"(?-u:\\b)[A-Za-z0-9+/=_-]{32,}(?-u:\\b)","to":"[REDACTED_TOKEN]"}]}
