d","check":"command","env":["CLAUDE_CODE_ENTRYPOINT=cli"],"ok":"command-guard blocks heavy cmd after `cd` (`cd app && npm test`)","payload":"{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"cd app && npm test\"}}","want":"block"},{"bad":"command-guard MISSED heavy cmd in command substitution — recursive-parse fix regressed","check":"command","env":["CLAUDE_CODE_ENTRYPOINT=cli"],"ok":"command-guard blocks heavy cmd in $(...) substitution (`echo \"$(npm run build)\"`)","payload":"{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"echo \\\"$(npm run build)\\\"\"}}","want":"block"},{"bad":"command-guard MISSED heavy bash -c payload — recursive-parse fix regressed","check":"command","env":["CLAUDE_CODE_ENTRYPOINT=cli"],"ok":"command-guard blocks heavy `bash -c \"npm run build\"` payload","payload":"{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"bash -c \\\"npm run build\\\"\"}}","want":"block"},{"bad":"command-guard wrongly blocked benign `echo \"$(date)\"` — over-blocking substitutions","check":"command","env":["CLAUDE_CODE_ENTRYPOINT=cli"],"ok":"command-guard allows benign substitution (`echo \"$(date)\"` — date is not heavy)","payload":"{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"echo \\\"$(date)\\\"\"}}","want":"allow"},{"bad":"command-guard did NOT block hivecontrol monitor under DevSwarm — destructive-read redirect regressed","check":"command","env":["CLAUDE_CODE_ENTRYPOINT=cli","ANTIHALL_DEVSWARM_SUPERVISOR=on","DEVSWARM_REPO_ID=repo-x"],"ok":"command-guard blocks `hivecontrol workspace monitor` under DevSwarm (blocking long-poll)","payload":"{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"hivecontrol workspace monitor\"}}","want":"block"},{"bad":"command-guard wrongly blocked a grep of quoted hivecontrol data — destructive-read redirect over-blocks","check":"command","env":["CLAUDE_CODE_ENTRYPOINT=cli","ANTIHALL_DEVSWARM_SUPERVISOR=on","DEVSWARM_REPO_ID=repo-x"],"ok":"command-guard allows grep of quoted hivecontrol DATA under DevSwarm (no false-positive)","payload":"{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"grep -n 'hivecontrol workspace monitor' docs/KB.md\"}}","want":"allow"},{"bad":"edit-guard did NOT block coordinator edit","check":"edit-guard","env":["CLAUDE_CODE_ENTRYPOINT=cli"],"ok":"edit-guard blocks coordinator edit","payload":"{\"tool_name\":\"Edit\",\"tool_input\":{\"file_path\":\"src/x.js\",\"old_string\":\"a\",\"new_string\":\"b\"}}","want":"block"},{"bad":"edit-guard wrongly blocked a subagent edit — delegation would deadlock","check":"edit-guard","env":["CLAUDE_CODE_ENTRYPOINT=cli"],"ok":"edit-guard ALLOWS subagent edit","payload":"{\"tool_name\":\"Edit\",\"tool_input\":{\"file_path\":\"src/x.js\",\"old_string\":\"a\",\"new_string\":\"b\"},\"agent_id\":\"test-agent\",\"agent_type\":\"general-purpose\"}","want":"allow"},{"bad":"speculation-guard did NOT flag \"should be fine\"","check":"speculation-guard","event":"Stop","ok":"speculation-guard flags \"should be fine\" (hedge w/o evidence)","payload":"{\"transcript_path\":\"{TRANSCRIPT}\",\"session_id\":\"doctor-spec-{NOW}\"}","transcript":["{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"That change should be fine.\"}]}}"],"want":"stop-block"},{"bad":"tasklist-guard did NOT block untracked work","check":"tasklist-guard","event":"Stop","ok":"tasklist-guard blocks untracked work (4 edits, no tasks, no progress file)","payload":"{\"transcript_path\":\"{TRANSCRIPT}\",\"cwd\":\"{CWD}\",\"session_id\":\"doctor-tl-{NOW}\"}","transcript":["{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"name\":\"Edit\",\"id\":\"toolu_e0\",\"input\":{\"file_path\":\"/x/f0\"}}]}}","{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"name\":\"Edit\",\"id\":\"toolu_e1\",\"input\":{\"file_path\":\"/x/f1\"}}]}}","{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"too