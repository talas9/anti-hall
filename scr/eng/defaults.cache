doctor_msg.bin_corrupt	{"v":"{path} is not a runnable program ({why}) - Fix: reinstall: sh {bootstrap} --download -v"}
doctor_msg.bin_hash_differs	{"v":"{path} differs from the build the bootstrap installed (sha256 {have}... vs {want}...): a local build, or damaged - Fix: to restore the pinned build: mv {path} {path}.local && sh {bootstrap} --download -v"}
doctor_msg.bin_missing	{"v":"engine binary not installed at {path} (hooks use ah-engine on PATH, else the Node hooks) - Fix: sh {bootstrap} --download -v"}
doctor_msg.bin_no_rosetta	{"v":"{path} is an {bin_arch} build and Rosetta is not installed on this {host_arch} Mac; it will not start - Fix: softwareupdate --install-rosetta --agree-to-license, or sh {bootstrap} --download -v for the native build"}
doctor_msg.bin_no_run	{"v":"{path} does not run: {why} - Fix: reinstall: sh {bootstrap} --download -v"}
doctor_msg.bin_not_bootstrapped	{"v":"{path} was not installed by the bootstrap (a local build); the bootstrap leaves it alone"}
doctor_msg.bin_not_exec	{"v":"{path} is not executable (mode {mode}) - Fix: chmod u+x {path} (ah-engine doctor --repair does this)"}
doctor_msg.bin_not_file	{"v":"{path} is not a regular file ({kind}) - Fix: move it aside, then run: sh {bootstrap} --download -v"}
doctor_msg.bin_ok	{"v":"engine binary {path} ({triple}) runs and reports {ver}"}
doctor_msg.bin_other_engine	{"v":"this doctor is engine {running}; the installed engine reports {installed}"}
doctor_msg.bin_quarantined	{"v":"{path} is quarantined by macOS Gatekeeper (com.apple.quarantine); it will not run - Fix: xattr -d com.apple.quarantine {path} (ah-engine doctor --repair does this for the build the bootstrap verified)"}
doctor_msg.bin_rosetta	{"v":"{path} is an {bin_arch} build running under Rosetta on this {host_arch} Mac (slower) - Fix: sh {bootstrap} --download -v installs the native build"}
doctor_msg.bin_unreadable	{"v":"{path} cannot be read ({err}) - Fix: check its permissions, or reinstall: sh {bootstrap} --download -v"}
doctor_msg.bin_version_differs	{"v":"engine {have} is installed but the plugin pins {want} - Fix: it updates at the next session start, or run: sh {bootstrap} --download -v"}
doctor_msg.bin_wrong_arch	{"v":"{path} was built for {bin_arch} but this {host_os} machine is {host_arch}; it cannot run - Fix: reinstall: sh {bootstrap} --download -v"}
doctor_msg.bin_wrong_os	{"v":"{path} was built for {bin_os} but this machine runs {host_os} - Fix: reinstall: sh {bootstrap} --download -v"}
doctor_msg.breaker	{"v":"client circuit breaker open for {secs}s more ({reason}); hooks use the Node fallback meanwhile - Fix: after fixing the cause: ah-engine reset"}
doctor_msg.claude_missing	{"v":"the claude CLI is not on PATH; Claude Code's own `claude doctor` was skipped"}
doctor_msg.claude_ok	{"v":"claude doctor (Claude Code {v}): no installation issues found"}
doctor_msg.claude_problem	{"v":"claude doctor: {line} (see `claude doctor` for details)"}
doctor_msg.claude_timeout	{"v":"`claude doctor` (Claude Code {v}) did not finish in time; skipped"}
doctor_msg.claude_unsupported	{"v":"Claude Code {v} has no usable `claude doctor`; skipped"}
doctor_msg.codex_hooks_off	{"v":"Codex config.toml ({label}) found but [features] hooks is not enabled"}
doctor_msg.codex_hooks_on	{"v":"Codex config.toml ({label}) has the hooks feature enabled"}
doctor_msg.codex_label_global	{"v":"global"}
doctor_msg.codex_label_project	{"v":"project"}
