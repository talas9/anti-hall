settings_cli.items	{"v":["{\"section\":\"autoHandover\",\"key\":\"enabled\",\"type\":\"boolean\",\"default\":true,\"description\":\"Write an automatic handover before context runs out.\"}","{\"section\":\"autoHandover\",\"key\":\"pct\",\"type\":\"number\",\"default\":93,\"description\":\"Context-usage percent that triggers an automatic handover.\"}","{\"section\":\"autoHandover\",\"key\":\"maxTokens\",\"type\":\"number\",\"default\":500000,\"description\":\"Absolute context-token ceiling that also triggers the handover, whichever of pct/maxTokens fires first; 500000 (the default) only bites on 1M-window sessions, so 200k models are governed by pct alone; 0 = no ceiling.\"}","{\"section\":\"autoHandover\",\"key\":\"nag\",\"type\":\"boolean\",\"default\":true,\"description\":\"Nag (remind) the user when a handover is due but not yet written.\"}","{\"section\":\"autoHandover\",\"key\":\"nagStepPct\",\"type\":\"number\",\"default\":5,\"description\":\"Percent increments between successive handover nags.\"}","{\"section\":\"autoHandover\",\"key\":\"nagQuietMin\",\"type\":\"number\",\"default\":15,\"description\":\"Minutes to wait before repeating a handover nag.\"}","{\"section\":\"autoHandover\",\"key\":\"gateNewWork\",\"type\":\"boolean\",\"default\":true,\"description\":\"Post-handover new-work gate: once context is past the threshold and this session's handover is written, the agent judges each new request's size before starting it and, if it needs more than gateBudgetPct of the context window, offers to park it in the task list + handover (start after /compact or /clear) or proceed if you insist. Quick questions, finishing the in-flight task, and spawning a DevSwarm workspace pass straight through.\"}","{\"section\":\"autoHandover\",\"key\":\"gateBudgetPct\",\"type\":\"number\",\"default\":5,\"description\":\"Context-window points a new request may use after the handover before the gate applies; also the measured backstop — one capped reminder to refresh the handover and offer to park the rest once usage grows this many points past where the handover was saved.\"}","{\"section\":\"autoHandover\",\"key\":\"decisivePrompt\",\"type\":\"boolean\",\"default\":true,\"description\":\"At a Stop (turn-ending) point once this session's handover exists and is fresh, tell the agent to end its reply with one prominent line naming the exact /compact (or /clear, or Codex /new) command — or, if the handover has gone stale since it was written, to refresh it first. Off reverts to the plain fire/pause-nag wording.\"}","{\"section\":\"autoHandover\",\"key\":\"gateHousekeepingMarkers\",\"type\":\"csv\",\"default\":\"\",\"advanced\":true,\"description\":\"Extra comma-separated markers (case-insensitive substrings) that identify a scheduled/cron housekeeping prompt (e.g. a mailbox-wake or DevSwarm peer-check tick), on top of the built-in defaults (\\\"inbox tick\\\", \\\"peer check\\\", \\\"BROADCAST bug sweep\\\") — a matching prompt never gets the POST-HANDOVER NEW-WORK GATE nudge.\"}","{\"section\":\"guards\",\"key\":\"mergeGate\",\"type\":\"boolean\",\"default\":false,\"description\":\"Enable merge-readiness gate checks before merging.\"}","{\"section\":\"guards\",\"key\":\"shipitGate\",\"type\":\"boolean\",\"default\":false,\"description\":\"Enable the ship-it workflow gate.\"}","{\"section\":\"guards\",\"key\":\"outputVerifyGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"Output-verification guard (blocks unverified completion claims).\"}","{\"section\":\"guards\",\"key\":\"outputVerifyOncePerTurn\",\"type\":\"boolean\",\"default\":true,\"description\":\"Show the output-verify advisory once per turn per distinct pass/fail signal set instead of after every identical test re-run. false = every mixed result.\"}","{\"section\":\"guards\",\"key\":\"failureRootCauseNudge\",\"type\":\"boolean\",\"default\":true,\"description\":\"Nudge toward root-cause analysis after a failure.\"}","{\"section\":\"guards\",\"key\":\"failureNudgeFilter\",\"type\":\"boolean\",\"default\":true,\"description\":\"Cut root-cause-nudge noise: stay silent on expected exit-1 predicates (grep no-match, test, diff, git diff --quiet), on harness refusals, and after the first nudge in a turn. false = nudge on every failure again.\"}","{\"section\":\"guards\",\"key\":\"failureNudgeHarmless\",\"type\":\"boolean\",\"default\":true,\"description\":\"Stay silent on a failure whose only error text is a shell glob/echo artefact (zsh no matches found) beside output that printed fine. false = nudge anyway.\"}","{\"section\":\"guards\",\"key\":\"repoSelfDrift\",\"type\":\"boolean\",\"default\":true,\"description\":\"anti-hall's own repo-drift self-check hook.\"}","{\"section\":\"guards\",\"key\":\"stashGuard\",\"type\":\"boolean\",\"default\":false,\"locked\":true,\"safetyNote\":\"git stash commands that can silently drop uncommitted work will no longer be blocked\",\"description\":\"SAFETY (confirm to change — see settings.js set/reset). Arm the git-stash guard in command-guard: block mutating `git stash` (also armed per-repo via .anti-hall/protected-stashes).\"}","{\"section\":\"guards\",\"key\":\"broadKill\",\"type\":\"boolean\",\"default\":true,\"locked\":true,\"safetyNote\":\"a broad pkill, killall, kill -9 -1 or a pattern kill from any agent (including subagents) will no longer be blocked, and can take down the user's dev servers and other agents' processes\",\"description\":\"SAFETY (confirm to change — see settings.js set/reset). broad-kill-guard (PreToolUse Bash, every agent incl. subagents, Claude and Codex; engine-only): block pkill, killall, `kill -9 -1` and a kill fed by a name or port lookup (xargs kill, kill $(pgrep ...)); `kill <pid>` of an explicit PID stays allowed.\"}","{\"section\":\"guards\",\"key\":\"queuedWaitGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"queued-wait-guard (PreToolUse Bash, subagents only, Claude and Codex; engine-only): block a build or test command a subagent starts with run_in_background (run it in the foreground under the lock, where waiting costs nothing) and a sleep, or a sleep inside a while/until/for poll loop, above the configured seconds. false = a subagent may background heavy commands and poll.\"}","{\"section\":\"guards\",\"key\":\"advisorReview\",\"type\":\"boolean\",\"default\":true,\"description\":\"advisor-mode review rule (PreToolUse Agent/Task, in model-routing; Claude only; engine-only): when the session has an advisor tool, block once a review-shaped agent spawn (reviewer, auditor, critic, review or audit in its description) on a non-flagship model (sonnet, haiku, or an inherited non-flagship one); use an Opus, Fable or Codex agent, or the advisor. Silent without an advisor tool. false = off.\"}","{\"section\":\"guards\",\"key\":\"advisorPlan\",\"type\":\"boolean\",\"default\":true,\"description\":\"advisor-mode plan rule (PreToolUse ExitPlanMode and Write/Edit/MultiEdit of a plan file, Claude only; engine-only): when the session has an advisor tool, block once a plan written with no advisor call since the last user message. Silent without an advisor tool. false = off.\"}","{\"section\":\"guards\",\"key\":\"advisorRetry\",\"type\":\"boolean\",\"default\":true,\"description\":\"advisor-mode retry rule (PostToolUseFailure Bash + PreToolUse Write/Edit/MultiEdit, Claude only; engine-only): when the session has an advisor tool, a failed test or build followed by a second edit of the same file with no advisor call in between is blocked once. Silent without an advisor tool. false = off.\"}","{\"section\":\"guards\",\"key\":\"allowWideSearch\",\"type\":\"boolean\",\"default\":false,\"description\":\"Let every agent (subagents and the main thread) run whole-disk searches: wide-search-guard (PreToolUse Bash, Claude and Codex; engine-only) stands aside while this is true. Default false: find, bfs, fd, rg, ag, ack, grep -r and mdfind rooted at /, ~, $HOME, /Users or /Volumes (named, or implied by a cd or the working directory) are blocked, because they wake Spotlight and the network volumes; a search under a project directory is allowed. A single path can be allowed through the wide_search.allow_paths list in lane_waste.toml.\"}","{\"section\":\"guards\",\"key\":\"delegateStandDown\",\"type\":\"boolean\",\"default\":true,\"description\":\"While agent spawning is stopped (the spawn-usage hard stop) the delegate-only guards (edit-guard, command-guard heavy commands, coordinator-work-guard; list: session_switches.toml standdown.guards) let the main thread do the work inline, with one note saying why; a heavy command still needs bounded output (piped to head/tail or written to a file). Safety guards (git, kill, search, network, delete) never stand down. false = the guards keep telling the main thread to delegate even when nothing can be spawned.\"}","{\"section\":\"guards\",\"key\":\"agentSpawnAvailable\",\"type\":\"enum\",\"values\":[\"auto\",\"on\",\"off\"],\"default\":\"auto\",\"env\":\"ANTIHALL_AGENT_SPAWN_AVAILABLE\",\"description\":\"Agent spawn capability override for Claude and Codex: auto uses advertised tools and host defaults; on/off explicitly establishes availability.\"}","{\"section\":\"guards\",\"key\":\"upfrontNotice\",\"type\":\"boolean\",\"default\":true,\"description\":\"Tell the agent one short line when a session-wide switch changes (the spawn-usage stop, limit conserve, a guard skip set or expired in skip.json), at the next prompt or tool call, once per state. false = the agent only learns a rule by hitting it.\"}","{\"section\":\"guards\",\"key\":\"repeatHint\",\"type\":\"boolean\",\"default\":true,\"description\":\"When the same guard blocks the same session again inside the repeat window (session_switches.toml repeat.min_blocks within repeat.window_min), the block message adds what is allowed (once) and a line asking for a different approach; the repeat is recorded in the guard_blocks table and counted per guard in status --json (repeat_blocks). false = a repeated block repeats the plain message.\"}","{\"section\":\"guards\",\"key\":\"allowTestSuites\",\"type\":\"boolean\",\"default\":false,\"description\":\"Let subagents run suite-scale test commands: lane-test-guard stands aside while this is true. Default false (a lane runs cargo check, commits, and verification happens at deploy).\"}","{\"section\":\"guards\",\"key\":\"laneTestGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"lane-test-guard (PreToolUse Bash, subagents only, Claude and Codex; engine-only): block suite-scale test commands from a subagent (cargo test or nextest without a narrowing filter, --workspace, node --test without a file, test.sh, replay and soak runners); cargo check and a filtered single-module test stay allowed. false = a subagent may run any test command.\"}","{\"section\":\"guards\",\"key\":\"testPolicy\",\"type\":\"enum\",\"default\":\"targeted\",\"values\":[\"none\",\"targeted\",\"suites\"],\"description\":\"Test policy for agents (lane-test-guard, PreToolUse Bash, Claude and Codex): none blocks EVERY test-runner command from a subagent (cargo test/nextest, node --test, npm/pnpm/yarn test, pytest, vitest, jest, go test, ctest, mvn/gradle test, flutter/dart/swift test, test.sh, xcodebuild test); targeted (default) blocks only suite-scale runs; suites lets every test run.\"}","{\"section\":\"guards\",\"key\":\"testPolicyMainThread\",\"type\":\"boolean\",\"default\":false,\"description\":\"Apply guards.testPolicy = none to the main session too, not only to subagents. Default false.\"}","{\"section\":\"guards\",\"key\":\"allowNestedSpawns\",\"type\":\"boolean\",\"default\":false,\"description\":\"Let a subagent or teammate start agents of its own. Default false: swarm-guard blocks an Agent/Task call whose caller is not the main session.\"}","{\"section\":\"guards\",\"key\":\"handoverCommitGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"git-guard: block a `git commit` whose paths include a session handover (.anti-hall/handovers/** at any depth, or HANDOVER*.md, CONTINUE-HERE.md, *.continue-here.md at the repo root). Handovers are local session state and are never committed; `git add` is never blocked.\"}","{\"section\":\"guards\",\"key\":\"gitAliasResolve\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"locked\":true,\"safetyNote\":\"a git alias (or a shell alias) that runs a force push or an AI-credited commit will no longer be seen through\",\"description\":\"SAFETY (confirm to change). git-guard: resolve `git <alias>` through the repo/global git config (chains and `!shell` aliases included) and scan what it really runs; block defining a git alias (`git config alias.x`, `-c alias.x=`, `GIT_CONFIG_VALUE_<n>`) or shell alias whose body is a blocked git command, and scan a call to a shell alias/function defined in the same command as the git command it forwards to. Builtin subcommands never spawn git.\"}","{\"section\":\"guards\",\"key\":\"gitReusedMessageCheck\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"locked\":true,\"safetyNote\":\"a commit that reuses an AI-credited message (-C/-c <rev>, --amend, a commit template) will no longer be blocked before it runs\",\"description\":\"SAFETY (confirm to change). git-guard: for a `git commit` with no -m/-F, read the message it would reuse (`-C`/`-c`/`--reuse-message`/`--reedit-message <rev>`, HEAD for `--amend`, `-t`/`commit.template`) and block it when it carries an AI self-credit trailer. A reused-verbatim message (-C, --no-edit, a no-op editor) always blocks; an editor-path commit blocks only when the command sets no real editor of its own. What an editor or commit hook writes is caught afterwards by the PostToolUse audit.\"}","{\"section\":\"guards\",\"key\":\"gitGuardHeredocData\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"git-guard: a heredoc whose consumer is not a shell is data, so its body is not scanned as commands. Applies only when every heredoc in the command ends in a prose/data file (.md, .txt, .rst, .log, ...) via cat/tee, a git commit/tag/notes/merge message (-F - or $(cat <<EOF)), or a gh pr/issue/release body; every other command in the line is on a short allowlist (cat, tee, git, gh, echo, printf, cd, mkdir, wc, ...); and no target is a script, dotfile, git hook or .git/.husky/.ssh/.config path. Bodies fed to bash/sh/eval/source/xargs/python/..., piped into a shell, or written to a file the same line runs stay scanned. A git beside it may use only commit/tag/notes/merge, status/log/diff/show/add or rev-parse with listed flags (no fetch/push/pull/clone/remote/submodule/config), and a gh only pr/issue/release create/edit/comment with listed flags and no --; any other flag keeps the bodies scanned. Commit/PR credit trailers are checked either way. false = scan every heredoc body as shell (the old behaviour).\"}","{\"section\":\"guards\",\"key\":\"gitignoreHint\",\"type\":\"boolean\",\"default\":true,\"description\":\"One-time (per project, every 7 days) SessionStart reminder to git-ignore `.anti-hall/` when it exists in a git repo and is not ignored; doctor always reports it.\"}","{\"section\":\"guards\",\"key\":\"allowAnthropicEnvKey\",\"type\":\"boolean\",\"default\":false,\"advanced\":true,\"locked\":true,\"safetyNote\":\"anti-hall would read ANTHROPIC_API_KEY from the environment for the speculation judge and Jev triage fallback instead of only the anthropic_api_key plugin option\",\"description\":\"SAFETY, home-settings only (no env / project override). Opt-in: let the speculation judge and Jev triage read ANTHROPIC_API_KEY from the environment (Codex has no plugin options). Default off.\"}","{\"section\":\"guards\",\"key\":\"emitDedupe\",\"type\":\"boolean\",\"default\":true,\"description\":\"Deduplicate repeated hook-emit output.\"}","{\"section\":\"guards\",\"key\":\"injectionRepeatEvery\",\"type\":\"number\",\"default\":10,\"advanced\":true,\"description\":\"Turns between full re-injections of a static UserPromptSubmit reminder block (VERIFY-FIRST, the task-tracker SHORT line, the DEVSWARM PRIMARY dispatch-tier/top-fan-out-tier suffixes, the DEVSWARM WORKSPACES table when unchanged) once its first-turn/post-compact copy has been consumed; set 0 to restore every-turn injection.\"}","{\"section\":\"guards\",\"key\":\"codexQuotaDetect\",\"type\":\"boolean\",\"default\":true,\"description\":\"Detect a Codex-CLI quota/rate-limit exhaustion message in a codex:codex-rescue Agent result and record it to ~/.anti-hall/codex-availability.json so other lanes/sessions stop rediscovering the outage independently.\"}","{\"section\":\"guards\",\"key\":\"editGuardAllow\",\"type\":\"csv\",\"default\":\"\",\"advanced\":true,\"locked\":true,\"safetyNote\":\"those files can be edited without edit-guard's protection\",\"description\":\"SAFETY (confirm to change — see settings.js set/reset). Extra allowed file globs for edit-guard (comma/colon separated).\"}","{\"section\":\"guards\",\"key\":\"allowSubagentMailbox\",\"type\":\"boolean\",\"default\":false,\"advanced\":true,\"locked\":true,\"safetyNote\":\"subagents can read/ack the Primary's mailbox, which is normally blocked\",\"description\":\"SAFETY (confirm to change — see settings.js set/reset). One-off allow for the subagent-mailbox command pattern.\"}","{\"section\":\"guards\",\"key\":\"allowReadOnlyVerify\",\"type\":\"boolean\",\"default\":true,\"description\":\"command-guard \\\"narrow allow\\\": lets the coordinator run ONLY these shapes inline: a non-heavy command with --check/--dry-run/--list, <cc> -fsyntax-only, python3 -m pytest -q <one file>, node --test <1-2 files>, ctest -R <name>, or git clone --depth 1 <https-url> <scratchpad/tmp dir>, only when piped to tail/head/grep -c/grep -m N/wc with no other segment left unaccounted for and no write redirect outside the scratchpad/tmp.\"}","{\"section\":\"guards\",\"key\":\"allowReadOnlyVerifyScripts\",\"type\":\"boolean\",\"default\":true,\"description\":\"command-guard read-only verify, script form: lets the coordinator run `<python*|node|ruby|perl|php> <existing script file> --check|--dry-run|--list` piped to a bounded sink inline. No inline-code flag (-c/-e/-m/--eval), no stdin/heredoc script, no wrapper verb, and the remaining arguments must be non-heavy. Requires guards.allowReadOnlyVerify.\"}","{\"section\":\"guards\",\"key\":\"projectCommandAllow\",\"type\":\"boolean\",\"default\":true,\"description\":\"command-guard per-project allowlist: a repo may declare its own sanctioned exact commands (e.g. a deploy script that must never be delegated) in <repo-toplevel>/.anti-hall/command-allow.json, run inline in the MAIN THREAD ONLY. Default empty config means no behavior change. Kill-switch: false disables the carve-out entirely.\"}","{\"section\":\"guards\",\"key\":\"projectEditAllow\",\"type\":\"boolean\",\"default\":true,\"description\":\"edit-guard per-project doc-edit allowlist: a repo may list repo-relative globs in <repo-toplevel>/.anti-hall/edit-allow.json ({\\\"paths\\\":[\\\"docs/**\\\"]}) that the MAIN THREAD may Edit/Write directly. Applies only after the user trusts that exact file content (settings.js trust-edit-allow <repo> --confirmed); an edit revokes trust. Never matches outside the repo, .git, .anti-hall, .claude, .codex, hooks config or ~/.claude. Kill-switch: false disables it.\"}","{\"section\":\"guards\",\"key\":\"allowPlainPush\",\"type\":\"boolean\",\"default\":true,\"description\":\"command-guard \\\"allow plain push\\\": in the MAIN THREAD ONLY, lets `git add`/`git commit`/a plain `git push [-q|--quiet|-u|--set-upstream] [remote] [ref]` (ref omitted, HEAD, or the current branch only; `-u`/`--set-upstream` needs an explicit remote AND ref and is never combined with another flag), and &&/; chains made up only of those three, run inline instead of being delegated. Also allows ONE optional leading `cd <path>` (only when it realpaths to the payload cwd's own repo toplevel or a directory inside it) and optional trailing read-only segments (`git log --oneline [-N]`, `git status [--short|-s]`, `git show --stat [-N|HEAD]`) ONLY after a push segment. --force/-f/--force-with-lease/--force-if-includes/--mirror/--delete/-d/--all/--tags/+refspec/src:dst-to-another-branch/any other flag combined with -q stay exactly as blocked as before; git-guard.js keeps its own independent force-push/AI-credit checks.\"}","{\"section\":\"guards\",\"key\":\"allowGcloudReads\",\"type\":\"boolean\",\"default\":true,\"description\":\"command-guard narrow read-only Google Cloud access: in the MAIN THREAD ONLY, lets the cloud CLI token-printing command, read-style verbs (describe, list, get-iam-policy, read) with JSON, YAML or value output into a bounded sink or jq, and a token-authorized silent HTTP GET with an optional Bearer header to an https URL on googleapis.com or a subdomain run inline. Mutating verbs, other HTTP methods, request bodies, uploads, output-to-file flags, redirects, proxies, IP literals, @file arguments and chained commands stay blocked.\"}","{\"section\":\"guards\",\"key\":\"allowBackgroundScratchScripts\",\"type\":\"boolean\",\"default\":true,\"description\":\"command-guard background scratch scripts: in the MAIN THREAD ONLY, a Bash call with run_in_background: true may run ONE segment `<interpreter> <script file> [args…]` (python3, node, sh or bash) when the file is an existing regular file inside the session scratchpad or a tmp root (os.tmpdir(), /tmp, /private/tmp; realpath-checked). No interpreter option before the file (-c/-e/…), no env prefix or wrapper, no chaining/pipes, no substitution or expansion, no stdin redirect, no write redirect outside the scratchpad/tmp. Foreground runs keep the normal rules. Each such run counts toward the main-thread work window (guards.coordinatorWorkWindowMinutes).\"}","{\"section\":\"guards\",\"key\":\"coordinatorWorkWindowMinutes\",\"type\":\"number\",\"default\":10,\"advanced\":true,\"description\":\"Main thread only: successful state-changing Bash calls (WORK: state-changing git, gh mutations, Bash writes into non-notes repo files, scratch/tmp/.anti-hall script runs, other text-script runs except tracked-and-clean project scripts, package-manager/system tools and old ~/.local/bin, ~/Library or ~/.claude/plugins tools, inline -c/-e code that writes files or runs state-changing git/gh) are counted over this many minutes. In a non-git project only coordinator-writable or fresh scripts count; an old script there is not WORK. Set nudgeAt and blockAt to 0 to record only. 0 = feature off.\"}","{\"section\":\"guards\",\"key\":\"coordinatorWorkNudgeAt\",\"type\":\"number\",\"default\":4,\"advanced\":true,\"description\":\"One advisory note each time the window's WORK count reaches this. 0 = no nudge.\"}","{\"section\":\"guards\",\"key\":\"coordinatorWorkBlockAt\",\"type\":\"number\",\"default\":7,\"advanced\":true,\"description\":\"The Nth WORK Bash call within the window is blocked. Recovery commands (git am/rebase/cherry-pick/revert --abort|--quit, merge --abort, stash pop/apply) and loosely matched inline code are counted but never blocked. Skip key coordinator-work-guard. 0 = no block.\"}","{\"section\":\"guards\",\"key\":\"coordinatorWorkMaxEntries\",\"type\":\"number\",\"default\":50,\"advanced\":true,\"description\":\"Safety cap on stored window timestamps per session.\"}","{\"section\":\"guards\",\"key\":\"bashEditParity\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"command-guard applies edit-guard's verdict to Bash writes (sed -i, perl -i, tee, cp, mv, >/>> redirects, literal python -c / node -e open-for-write paths) into repo files in the main thread. git verbs and trusted (redirect-free) project command-allow matches are never blocked by it. Also off when safety.editGuard is off or edit-guard is skipped. Both hosts (tested with Claude and Codex payload shapes).\"}","{\"section\":\"guards\",\"key\":\"shellWriteChecks\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"api-guard and ship-it-guard also run on Bash (both hosts): the files a shell write targets (`>`/`>>` redirects, heredoc into cat/tee, echo/printf, tee, sed -i, perl -i, cp/mv, python -c open(..., 'w')) go through ship-it-guard's existence gate, and the visible text of a heredoc/echo/printf write into a Python, JavaScript or TypeScript file through api-guard. Writes into the session scratchpad or a tmp root outside a repo are not gated by ship-it-guard. Unparseable forms are allowed. Each guard's own switch (guards.apiGuard, guards.shipitGate) still applies; edit-guard's Bash parity is guards.bashEditParity.\"}","{\"section\":\"guards\",\"key\":\"reaperMatch\",\"type\":\"string\",\"default\":\"\",\"advanced\":true,\"description\":\"Extra process-name pattern for the MCP session-end reaper.\"}","{\"section\":\"guards\",\"key\":\"reaperExclude\",\"type\":\"string\",\"default\":\"\",\"advanced\":true,\"description\":\"Excludes matching processes from the MCP reaper.\"}","{\"section\":\"guards\",\"key\":\"reaperCodexBroker\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"mcp-reaper: REPORT (list in the reaper log, both dry-run and real runs) abandoned openai-codex plugin app-server-broker.mjs helper processes. REPORT-ONLY — this class is NEVER killed (a 2026-09-25 safety review found its detection could not be made reliable enough to act on automatically: unquoted --cwd paths with spaces, symlinked /tmp-vs-/private/tmp cwd mismatches, and the broker's own app-server child always looking like an \\\"owner\\\"). It is spawned detached+unref ON PURPOSE (PPID 1 is normal for a LIVE broker, not evidence of death), so a candidate is listed only when its --cwd directory no longer exists, or no live claude/codex process (excluding the broker's own descendants) has a realpath'd cwd equal to/an ancestor of/a descendant of the realpath'd --cwd, AND it is older than guards.reaperCodexBrokerMinAgeS. Matched by an exact script-name + codex-plugin-path signature, kept fully separate so this never loosens the MCP matcher (which alone can still trigger a real kill). Only takes effect when the opt-in companion reaper is installed and running.\"}","{\"section\":\"guards\",\"key\":\"reaperCodexBrokerMinAgeS\",\"type\":\"number\",\"default\":1800,\"advanced\":true,\"description\":\"Minimum age in seconds an app-server-broker.mjs whose owner cannot be found must have before the report-only class above will list it (30 minutes by default — deliberately conservative since PPID gives no death signal for this class); an unresolvable age is always skipped, never listed.\"}","{\"section\":\"guards\",\"key\":\"tasklistWorkThreshold\",\"type\":\"number\",\"default\":3,\"advanced\":true,\"description\":\"Minimum work items before tasklist-guard fires.\"}","{\"section\":\"guards\",\"key\":\"pruneCompletedTasksAfter\",\"type\":\"number\",\"default\":3,\"advanced\":true,\"description\":\"TOKEN SAVINGS (0.117.0): once completed/cancelled tasks in the list exceed this count, task-guard emits a one-line advisory (never a block) to prune them via TaskUpdate status=deleted after recording them in the history ledger — Claude Code's own TaskCreate reminder re-prints the whole list, completed tasks included, every few turns.\"}","{\"section\":\"guards\",\"key\":\"progressFreshMs\",\"type\":\"number\",\"default\":1800000,\"advanced\":true,\"description\":\"Freshness window (ms) for the progress file in tasklist-guard.\"}","{\"section\":\"guards\",\"key\":\"apiGuardThirdparty\",\"type\":\"boolean\",\"default\":false,\"advanced\":true,\"description\":\"Also verify installed 3rd-party package APIs, not just stdlib/builtins.\"}","{\"section\":\"guards\",\"key\":\"modelRouting\",\"type\":\"enum\",\"default\":\"strict\",\"description\":\"model-routing-guard (PreToolUse Agent/Task): strict blocks a mis-tiered spawn, advisory only warns, off disables the hook.\"}","{\"section\":\"guards\",\"key\":\"noBlockingQuestions\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"ask-guard (PreToolUse AskUserQuestion, optional): advise adds a standing-rule reminder to the question call, block refuses it unless the first question starts with DESTRUCTIVE: or CREDENTIAL:. off (default) does nothing.\"}","{\"section\":\"guards\",\"key\":\"questionAgentsNote\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"ask-guard (PreToolUse AskUserQuestion): when a question is asked while background agents are in flight, add one advisory line naming them and saying they may act on an option before the answer arrives (pause them or tell them to wait). Silent when no agent is running or the count cannot be proven. Never blocks; independent of guards.noBlockingQuestions.\"}","{\"section\":\"guards\",\"key\":\"sharedTreeAgentNote\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"swarm-guard (PreToolUse Agent/Task): when a write-capable subagent is spawned without isolation:\\\"worktree\\\" while another write-capable agent is still running in the same working tree, add one advisory sentence (two such agents can commit each other's uncommitted changes: isolate, serialize, or use separate scratch clones; in a repo whose CLAUDE.md/AGENTS.md says no worktrees: serialize or use scratch clones). Read-only agent types, isolated spawns, and unknown agent state are silent. Never blocks.\"}","{\"section\":\"guards\",\"key\":\"spawnCeiling\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"swarm-guard (PreToolUse Agent/Task): block an agent spawn when the session already has too many agents running (default ceiling 12, a generous safety net that shrinks in steps as the 5-hour or weekly usage limit nears), naming the running agents. The owner can lift it for a session with a skip entry for spawn-ceiling. Limits and texts: engine/defaults/spawn_guards.toml (spawn_ceiling.*).\"}","{\"section\":\"guards\",\"key\":\"usageAwareDispatch\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"swarm-guard (PreToolUse Agent/Task): read the 5-hour and weekly usage; at the soft threshold allow the spawn with advice to use cheaper models and fewer agents, at the hard threshold block new spawns and say which limit is near and when it resets. Skip entry: spawn-usage. Thresholds and texts: engine/defaults/spawn_guards.toml (spawn_usage.*).\"}","{\"section\":\"guards\",\"key\":\"mergeSidePickAdvisory\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"merge-side-pick (PostToolUse + PreToolUse Bash, Claude and Codex): records a conflict resolved by taking one side wholesale (git checkout/restore --ours|--theirs, git merge/pull/rebase -X ours|theirs, git merge -s ours) and test runs (npm/pnpm/yarn test, node --test, pytest, go/cargo/flutter/dart test, mvn/gradle test, make test, ...) per session; a push while a side-pick has no test run after it adds one advisory (run the tests, review the discarded side). Never blocks; silent when tests ran after the side-pick or state is unknown. On Codex it shows only on builds that support PreToolUse additionalContext (rust-v0.129.0+).\"}","{\"section\":\"guards\",\"key\":\"updateInSession\",\"type\":\"boolean\",\"default\":true,\"description\":\"model-routing-guard blocks a subagent spawn that runs anti-hall's own update (`ah-engine update`, or run /anti-hall:update): the update runs migrations, so it runs in the main session, which judges the result. off allows delegating it.\"}","{\"section\":\"guards\",\"key\":\"exploreHintExec\",\"type\":\"boolean\",\"default\":true,\"description\":\"The model-routing Explore hint is withheld when the spawn brief writes a file or report or runs a script or shell commands (Explore cannot write files). Off restores the hint.\"}","{\"section\":\"guards\",\"key\":\"dispatchSkipHeld\",\"type\":\"boolean\",\"default\":true,\"description\":\"The DISPATCH NOW line never names a task with any metadata.blockedOn value (document key `blockedOn`) or a waiting/blocked/on-hold status.\"}","{\"section\":\"guards\",\"key\":\"dispatchSkipFileConflict\",\"type\":\"boolean\",\"default\":true,\"description\":\"The DISPATCH NOW line never names a task whose files a running agent already works on.\"}","{\"section\":\"guards\",\"key\":\"dispatchQuietSpawnStop\",\"type\":\"boolean\",\"default\":true,\"description\":\"The DISPATCH NOW line is silent while the weekly-usage spawn stop is active.\"}","{\"section\":\"guards\",\"key\":\"sharedTreeQuietNoWorktrees\",\"type\":\"boolean\",\"default\":true,\"description\":\"The shared-tree advisory is silent when a CLAUDE.md, AGENTS.md or memory rule forbids worktrees.\"}","{\"section\":\"guards\",\"key\":\"sharedTreeScratchOnly\",\"type\":\"boolean\",\"default\":true,\"description\":\"The shared-tree advisory is silent for a spawn whose brief only writes a report or results under the scratch location.\"}","{\"section\":\"agents\",\"key\":\"rearmNeedsChildren\",\"type\":\"boolean\",\"default\":true,\"description\":\"The wake-watch re-arm reminder is silent for a Primary checkout with no live child workspaces.\"}","{\"section\":\"context\",\"key\":\"taskTrackerChangeOnly\",\"type\":\"boolean\",\"default\":true,\"description\":\"The task tracker's short reminder speaks only when the open-task list changed or stayed untouched for taskTrackerUntrackedPrompts prompts.\"}","{\"section\":\"context\",\"key\":\"taskTrackerUntrackedPrompts\",\"type\":\"number\",\"default\":8,\"min\":1,\"description\":\"Prompts with an unchanged open-task list after which the short reminder speaks again.\"}","{\"section\":\"context\",\"key\":\"promptDigest\",\"type\":\"boolean\",\"default\":true,\"description\":\"When several advisories speak on one prompt they become one digest (promptDigestLines lines at most); the full text goes to a private file named on the last line.\"}","{\"section\":\"context\",\"key\":\"promptDigestLines\",\"type\":\"number\",\"default\":3,\"min\":2,\"description\":\"The most lines of the prompt digest.\"}","{\"section\":\"context\",\"key\":\"promptDigestMin\",\"type\":\"number\",\"default\":3,\"min\":2,\"description\":\"The fewest advisories on one prompt at which the digest replaces them.\"}","{\"section\":\"guards\",\"key\":\"modelRoutingDeployFloor\",\"type\":\"enum\",\"default\":\"sonnet\",\"description\":\"model-routing-guard floor for deploy/migration/rollback/production/secret/credential-shaped spawns: such a spawn at or above the floor is never blocked, one below it (or with no explicit model) gets an advisory to use at least the floor. off restores the plain routing table.\"}","{\"section\":\"guards\",\"key\":\"apiGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"api-guard (PreToolUse Write/Edit): block fabricated stdlib/builtin APIs in written code.\"}","{\"section\":\"guards\",\"key\":\"speculationGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"speculation-guard (Stop): block a turn that ends on unverified hedged claims.\"}","{\"section\":\"guards\",\"key\":\"inferenceCheck\",\"type\":\"boolean\",\"default\":false,\"advanced\":true,\"description\":\"speculation-guard (Stop): also block, once per reply, a confident causal claim with no hedge word (\\\"caused by\\\", \\\"the root cause is\\\", \\\"because\\\", \\\"is due to\\\", \\\"stems from\\\", \\\"this means\\\", \\\"the culprit is\\\", \\\"that's why\\\") when no tool output, observation-tool input, pasted fenced block or task notification in the transcript window mentions the stated cause. Default off: 100% precision on the 84-case synthetic corpus but it flagged 3.8% of 3,276 real final replies, mostly design rationale (\\\"X because Y\\\"), so field precision is far below 0.9.\"}","{\"section\":\"guards\",\"key\":\"claimEvidence\",\"type\":\"boolean\",\"default\":true,\"description\":\"claim-evidence-guard rule 1 (Stop, Claude, engine-only): hold once a reply that claims a result (tests pass, verified, deployed, is fixed) with no matching tool call this turn. A reply that says it was not verified is not held. false = such claims pass.\"}","{\"section\":\"guards\",\"key\":\"claimEvidenceStrict\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"claim-evidence-guard: a conditional, source, quote or label never lets a bare factual claim through (filler openers like 'If true', noun or compound sources like 'doc-string', negated labels like 'not unverified'). false = the earlier looser reading.\"}","{\"section\":\"guards\",\"key\":\"claimEvidenceTelemetry\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"claim-evidence-guard telemetry: count held replies and passed claims (with the reason) in the metrics and in status. false = no counters; the guard decides the same.\"}","{\"section\":\"devswarm\",\"key\":\"parentGateSharedCount\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Parent gate counts the Primary's own unread with the same count `mesh inbox peek-primary` reports (own sends left out). false = the old cursor-minus-total count, which can block on mail peek shows as read.\"}","{\"section\":\"devswarm\",\"key\":\"orphanWarningOnce\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Show the orphaned-mesh warning once per session per set of partitions. false = repeat it on the keepalive.\"}","{\"section\":\"devswarm\",\"key\":\"noiseProvenance\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Tell a [Primary poke] row from mail by provenance (no mtype, Primary sender), not by its opening text. false = any row that starts with that text is dropped from the unread count.\"}","{\"section\":\"devswarm\",\"key\":\"unreadPositionGuard\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"A saved read position past the message count reads as unknown, not 0 unread. false = the old read, which can let a Stop through.\"}","{\"section\":\"guards\",\"key\":\"pushedNotDone\",\"type\":\"boolean\",\"default\":true,\"description\":\"claim-evidence-guard rule 2 (Stop, Claude, engine-only): hold once a reply that calls work done after a push or PR created this turn with no later look at CI or the merge state. A reply that states CI as pending or unchecked is not held. false = pushed work may be called done.\"}","{\"section\":\"guards\",\"key\":\"claimLedger\",\"type\":\"boolean\",\"default\":true,\"description\":\"claim-ledger (Stop, never blocks): record claims in the last reply that nothing in the session backs.\"}","{\"section\":\"guards\",\"key\":\"pruneStopBlock\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"task-guard (Stop): block, capped, when the prune-completed-tasks advisory was shown and the completed count did not drop.\"}","{\"section\":\"guards\",\"key\":\"pruneStopBlockMax\",\"type\":\"number\",\"default\":2,\"advanced\":true,\"description\":\"Most prune Stop blocks per session for one completed-task count; after that the Stop passes.\"}","{\"section\":\"guards\",\"key\":\"priorityTagCheck\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"task-guard (Stop): block, capped, when an open task subject carries a bracketed priority tag that is not P0-P3.\"}","{\"section\":\"guards\",\"key\":\"priorityTagBlockMax\",\"type\":\"number\",\"default\":2,\"advanced\":true,\"description\":\"Most priority-tag Stop blocks per session for one set of bad tags; after that the Stop passes.\"}","{\"section\":\"guards\",\"key\":\"taskGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"task-guard (Stop): block stopping while tracked tasks are still open.\"}","{\"section\":\"guards\",\"key\":\"taskGuardOwnerBlockedMarker\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"task-guard IDLE NEGLECT: honor an explicit owner-blocked marker (metadata.blockedOn / blockedOn === 'owner'|'user'|'human'|'external', or an \\\"OWNER:\\\" / \\\"OWNER DECISION\\\" subject prefix) as non-dispatchable, instead of requiring a fake blockedBy dependency to silence the nag. Off reverts to pre-marker behavior (only a real blockedBy id suppresses idle-neglect).\"}","{\"section\":\"guards\",\"key\":\"dispatchDemand\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Per-turn \\\"DISPATCH NOW in parallel: #id subject, …\\\" demand (task-tracker, UserPromptSubmit) and task-guard IDLE NEGLECT count in-flight agents PER TASK from this session's transcript (an agent whose description names #id covers it; unmapped agents cover one task each; running < min(16, cores-2)). Off removes the per-turn DISPATCH NOW line and restores task-guard's legacy blanket rule (any fresh ~/.anti-hall/agents heartbeat suppresses IDLE NEGLECT). Metrics: ah-engine dispatch-report.\"}","{\"section\":\"guards\",\"key\":\"idleNeglectMinPriority\",\"type\":\"enum\",\"default\":\"p1\",\"advanced\":true,\"description\":\"task-guard IDLE NEGLECT urgency floor: a pending/unowned/unblocked task nags only when its priority is at or above (numerically ≤) this rank; anything below it (e.g. P2/P3 when the floor is P1, or \\\"low\\\"/\\\"deferred\\\") is non-nagging backlog. Missing/unrecognized priority is always treated as P1 (fail-open). Consistent across every rank — was previously hard-coded to skip only the literal \\\"P2\\\".\"}","{\"section\":\"guards\",\"key\":\"maxParallelDispatch\",\"type\":\"number\",\"default\":0,\"advanced\":true,\"description\":\"Hard cap on concurrently-running background agents the DISPATCH NOW line / task-guard IDLE NEGLECT will demand up to. 0 (default) = the existing dynamic cap (min(16, cores-2)). Some owners run exactly ONE implementation agent per workspace at a time — setting this to 1 makes the demand ask for the next task only once nothing is running, instead of piling on parallel dispatch pressure.\"}","{\"section\":\"guards\",\"key\":\"idleNeglectProvenOnly\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"task-guard IDLE NEGLECT blocks only when a dispatchable task is uncovered under every placement of the running agents that name no task (dispatchable > unmapped agents). The per-turn DISPATCH NOW line is unchanged. false = also block on the in_progress-first estimate.\"}","{\"section\":\"guards\",\"key\":\"idleNeglectAgentMaxAgeMin\",\"type\":\"number\",\"default\":30,\"advanced\":true,\"description\":\"task-guard IDLE NEGLECT, proven count only: a running agent that names no task stops counting as cover once its newest sign of life (launch, SendMessage resume, pending teammate message, output-file write) is older than this many minutes, or when it was launched before the earliest uncovered task was created / last set pending or in_progress (it cannot be working on a task that did not exist). Unknown age or unknown task time = the agent still counts. 0 = never age out.\"}","{\"section\":\"guards\",\"key\":\"tasklistGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"tasklist-guard (Stop): require a task list / progress file for multi-step work.\"}","{\"section\":\"guards\",\"key\":\"tasklistNoTaskTools\",\"type\":\"enum\",\"default\":\"reduced\",\"advanced\":true,\"description\":\"tasklist-guard (Stop): the nag form for a session that is positively known to lack task tools (today: a Codex session with no task-tool evidence in its transcript). reduced (default) = no TaskCreate demand, list the tasks in the reply, blocks at most once per session; full = today's TaskCreate/TaskUpdate demand; skip = no nag. A Claude session with no evidence keeps the full demand (task tools exist before they leave a trace). When not set explicitly, context.protocolLevel=full makes the default full.\"}","{\"section\":\"guards\",\"key\":\"stopNagBudgetPerPrompt\",\"type\":\"number\",\"default\":0,\"advanced\":true,\"description\":\"Per-prompt cap on Stop blocks from task-guard and tasklist-guard (each counted separately), inside their existing session caps (5 and 3). 0 (default) = off = today's behaviour; N = at most N blocks per user prompt, keyed by the Stop payload prompt_id or the last user entry uuid (no key = not applied). speculation-guard, claim-ledger and the PreToolUse guards are not affected.\"}","{\"section\":\"guards\",\"key\":\"scanThrottle\",\"type\":\"boolean\",\"default\":true,\"description\":\"scan-throttle (PreToolUse Bash): advise running heavy repo-wide scans at background priority (nice/taskpolicy); never rewrites the command.\"}","{\"section\":\"guards\",\"key\":\"silentAgentNudge\",\"type\":\"boolean\",\"default\":true,\"description\":\"silent-agent-nudge (Stop): nudge once, advisory-only, when a background Agent launch in the transcript has no terminal notification and a stale/missing output_file (plus the ~/.anti-hall/agents/<id>.json heartbeat as an extra signal), past silentAgentNudgeMin. Never kills anything.\"}","{\"section\":\"guards\",\"key\":\"silentAgentNudgeMin\",\"type\":\"number\",\"default\":20,\"advanced\":true,\"description\":\"Minutes of silence (no terminal task-notification + stale/missing output_file, or a stale heartbeat) before silent-agent-nudge fires.\"}","{\"section\":\"guards\",\"key\":\"staleAgentStopNote\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"stale-agent-stop-note (PreToolUse TaskStop, never blocks): one advisory line when TaskStop names an agent that was sent a message, or resumed, after its last report and has not reported since (it may be working). Settings file + env only; no plugin option.\"}","{\"section\":\"guards\",\"key\":\"idleAgentSweep\",\"type\":\"boolean\",\"default\":true,\"description\":\"idle-agent-sweep (UserPromptSubmit, Claude + Codex, never blocks): once per user prompt, lists agents that finished but were never stopped (Claude: named teammates whose last report is an idle_notification with idleReason available/failed and no later SendMessage or TaskStop; Codex: multi_agent_v1 agents whose wait_agent result is completed/errored and that were never closed) and gives the exact TaskStop / close_agent call. Fires when guards.idleAgentSweepCount are idle or one has been idle guards.idleAgentSweepMin minutes\"}","{\"section\":\"guards\",\"key\":\"idleAgentSweepCount\",\"type\":\"number\",\"default\":3,\"advanced\":true,\"description\":\"idle-agent-sweep fires when at least this many finished agents are idle and not stopped\"}","{\"section\":\"guards\",\"key\":\"idleAgentSweepMin\",\"type\":\"number\",\"default\":15,\"advanced\":true,\"description\":\"idle-agent-sweep also fires when any one finished agent has been idle at least this many minutes\"}","{\"section\":\"guards\",\"key\":\"compactAdviceGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"compact-advice-guard (Stop): block once when the reply recommends /compact (\\\"SAFE TO COMPACT\\\", \\\"good point to /compact\\\") while context is below the auto-handover threshold minus compactAdviceMarginPct, or within compactAdviceRecentTurns turns of a compact. The threshold-fired auto-handover path stays allowed.\"}","{\"section\":\"guards\",\"key\":\"compactAdviceRecentTurns\",\"type\":\"number\",\"default\":10,\"description\":\"compact-advice-guard: a compact boundary within this many turns makes a new /compact recommendation a block; 0 turns the recent-compact rule off.\"}","{\"section\":\"guards\",\"key\":\"compactAdviceMarginPct\",\"type\":\"number\",\"default\":10,\"advanced\":true,\"description\":\"compact-advice-guard: context-% points below autoHandover.pct at which a /compact recommendation counts as low-context.\"}","{\"section\":\"guards\",\"key\":\"compactDeclarationGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"compact-declaration-guard (PreToolUse — opt-in in 0.116.0 pending false-positive fixes on quoted/question/negated \\\"safe to compact\\\" phrasing; RE-ENABLED by default in 0.117.0 now that findAdvice ignores quoted/question/negated/conditional mentions, see the compact-advice check): after declaring SAFE TO COMPACT in a turn, block new work (Agent/Task spawns, Write/Edit/NotebookEdit, state-changing Bash) until the next user message or an explicit \\\"RETRACT SAFE TO COMPACT\\\" line. Read-only tools stay allowed.\"}","{\"section\":\"guards\",\"key\":\"stopHookVersionDowngrade\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"When installed_plugins.json (harness-owned) has re-registered a newer anti-hall version than this running session, downgrade nudge-class Stop-hook blocks (silent-agent-nudge, tasklist-guard, devswarm-parent-gate NEGLECT) to advisory (skip the block) until restart — a stale already-fixed nudge should not keep blocking. Never applied to safety guards.\"}","{\"section\":\"guards\",\"key\":\"stopAck\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Nudge-class Stop hooks (silent-agent-nudge, tasklist-guard) honor a per-signature session ack the agent writes to ~/.anti-hall/stop-ack/<session>.json once the user has explicitly confirmed a condition is a false positive — the same signature then stays advisory (never blocks again) for the rest of the session. Off disables the mechanism entirely (hooks block exactly as before it existed). Never applies to safety guards.\"}","{\"section\":\"guards\",\"key\":\"failOpenNonSafety\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"A guard event's check that gave no answer (late or missing daemon reply, spent event budget) and is not a safety guard is let through with a one-line notice per session instead of blocking the call or holding the Stop. The safety guards (git, command, api, edit, ship-it, merge, swarm, compact-declaration, devswarm-comms, inbox-read, ask; script.failure_mode_by_check) still fail closed. Counted per check in status (advisory.fail_open). Off = every unanswered guard blocks.\"}","{\"section\":\"safety\",\"key\":\"gitGuard\",\"type\":\"boolean\",\"default\":true,\"locked\":true,\"safetyNote\":\"force-pushes and AI credit lines in commits will no longer be stopped\",\"description\":\"git-guard: block force-push and AI self-credit in commits and gh pr/issue/release bodies.\"}","{\"section\":\"safety\",\"key\":\"commandGuard\",\"type\":\"boolean\",\"default\":true,\"locked\":true,\"safetyNote\":\"heavy commands (builds, tests, deploys, pushes) will run directly in the main session instead of being handed to a helper\",\"description\":\"command-guard core: make the coordinator delegate heavy commands (build/test/deploy/push). Its data-safety sub-guards (DevSwarm read/send/mailbox, armed stash guard) stay on.\"}","{\"section\":\"safety\",\"key\":\"editGuard\",\"type\":\"boolean\",\"default\":true,\"locked\":true,\"safetyNote\":\"edits to protected files like plugin config and secrets will no longer be stopped\",\"description\":\"edit-guard core: make the coordinator delegate file edits outside its own plan/state/handover files.\"}","{\"section\":\"safety\",\"key\":\"swarmGuard\",\"type\":\"boolean\",\"default\":true,\"locked\":true,\"safetyNote\":\"nothing will stop runaway agent spawning that can overload the machine\",\"description\":\"swarm-guard: block agent spawns past the spawn-rate cap or under critical memory pressure.\"}","{\"section\":\"context\",\"key\":\"verifyFirstSession\",\"type\":\"boolean\",\"default\":true,\"description\":\"verify-first-full (SessionStart): inject the full verify-first protocol (also re-injected after compaction).\"}","{\"section\":\"context\",\"key\":\"verifyFirstOrchestration\",\"type\":\"boolean\",\"default\":true,\"description\":\"verify-first-orch (SessionStart): inject the orchestration discipline for the main thread.\"}","{\"section\":\"context\",\"key\":\"protocolLevel\",\"type\":\"enum\",\"default\":\"compact\",\"description\":\"Size of the verify-first and orchestration text anti-hall injects. compact (default) sends a short core with every load-bearing clause inline and points at PROTOCOL.md for the rest; full sends today's complete text on every channel, byte for byte (the one-key rollback).\"}","{\"section\":\"context\",\"key\":\"codexOrchFullOn\",\"type\":\"enum\",\"default\":\"session\",\"description\":\"EXPERIMENTAL, Codex only (>= 0.129, hooks trusted). session (default) = the full orchestration rules (A-N) arrive at SessionStart, as today. spawn = SessionStart sends the compact core + compact orchestration lines and the full rules arrive once per context epoch on the first spawn_agent call (a PreToolUse additionalContext, which Codex 0.160 surfaces to the model). Needs positive Codex evidence, otherwise session; ignored under protocolLevel=full, and a DevSwarm Primary always gets the full text at SessionStart.\"}","{\"section\":\"context\",\"key\":\"orchFullOn\",\"type\":\"enum\",\"default\":\"auto\",\"description\":\"When the full orchestration rules (A-N) are sent under protocolLevel=compact. auto (default) = session = inline at SessionStart next to the compact core; spawn = EXPERIMENTAL: compact lines at SessionStart and the full text once on the first Agent/Task/Workflow spawn of each context epoch (Claude Code only, needs positive platform evidence, otherwise coerced to session; unproven live, so opt-in); off = the compact lines only (also on Codex). Ignored under protocolLevel=full; a DevSwarm Primary always gets the full text at SessionStart.\"}","{\"section\":\"context\",\"key\":\"verifyFirstTurn\",\"type\":\"boolean\",\"default\":true,\"description\":\"verify-first (UserPromptSubmit): the short per-turn verify-first nudge.\"}","{\"section\":\"context\",\"key\":\"verifyFirstSubagent\",\"type\":\"boolean\",\"default\":true,\"description\":\"verify-first-subagent (SubagentStart): inject the protocol into every subagent.\"}","{\"section\":\"context\",\"key\":\"taskTracker\",\"type\":\"boolean\",\"default\":true,\"description\":\"task-tracker (UserPromptSubmit): the task-list discipline directive and per-turn reminder.\"}","{\"section\":\"context\",\"key\":\"handoverResume\",\"type\":\"boolean\",\"default\":true,\"description\":\"handover-resume (SessionStart): point a fresh or compacted session at the newest handover.\"}","{\"section\":\"context\",\"key\":\"defectNudge\",\"type\":\"boolean\",\"default\":true,\"description\":\"defect-nudge (SessionStart): the once-a-day note about the defect channel.\"}","{\"section\":\"context\",\"key\":\"dedupeWindowMin\",\"type\":\"number\",\"default\":20,\"advanced\":true,\"description\":\"Fallback per-session suppression window (minutes) for repeated UserPromptSubmit injection blocks (LIMIT CONSERVATION, TASK-LIST, DEVSWARM COMMS OVERRIDE, DEVSWARM WORKSPACES) when a burst of queued prompts is delivered together and the transcript cannot confirm the earlier copy was already read — used only as the last-resort guard; content that changed always re-emits. 0 disables emit-dedupe entirely (same as guards.emitDedupe=false).\"}","{\"section\":\"context\",\"key\":\"roleGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"engine-role-guard (PreToolUse Bash) and the ah-engine command line: refuse an engine verb the caller's role may not run (roles.matrix: owner-level verbs are main-session only, a workspace child acts on itself only).\"}","{\"section\":\"context\",\"key\":\"roleNote\",\"type\":\"boolean\",\"default\":true,\"description\":\"engine-role-note (SessionStart, SubagentStart): tell the session its role, the engine verbs it may use and where the guide is (the anti-hall:engine skill).\"}","{\"section\":\"context\",\"key\":\"injectGate\",\"type\":\"boolean\",\"default\":true,\"description\":\"Token cuts, master switch (engine dispatcher): the hooks that re-send the same context every turn (limit-conserve-inject, task-tracker, the DevSwarm comms-override line, swarm-guard's shared-tree advisory) are passed on only when the model does not already hold it; off hands every hook's output through unchanged. The state is per session and per agent, bounded in the daemon, cleared by SessionStart (compaction), and fails open.\"}","{\"section\":\"context\",\"key\":\"injectGateLimit\",\"type\":\"boolean\",\"default\":true,\"description\":\"Token cut 1: the limit-conservation directive is injected when the usage band or reset window changes, else as a short keepalive every context.injectGateLimitEvery turns (its reset time jitters by milliseconds, which defeated the Node dedupe).\"}","{\"section\":\"context\",\"key\":\"injectGateLimitEvery\",\"type\":\"number\",\"default\":10,\"advanced\":true,\"description\":\"Turns between keepalives of an unchanged limit-conservation directive.\"}","{\"section\":\"context\",\"key\":\"injectGateTask\",\"type\":\"boolean\",\"default\":true,\"description\":\"Token cut 2: task-tracker's long directive always passes; its short reminder passes every context.injectGateTaskEvery turns, its freshness note when it changed.\"}","{\"section\":\"context\",\"key\":\"injectGateTaskEvery\",\"type\":\"number\",\"default\":10,\"advanced\":true,\"description\":\"Turns between short task-tracker reminders and unchanged freshness notes.\"}","{\"section\":\"context\",\"key\":\"injectGateComms\",\"type\":\"boolean\",\"default\":true,\"description\":\"Token cut 3: the DevSwarm comms-override line and the workspace-title instruction are injected once per session, when changed, and as a keepalive every context.injectGateCommsEvery turns.\"}","{\"section\":\"context\",\"key\":\"injectGateCommsEvery\",\"type\":\"number\",\"default\":30,\"advanced\":true,\"description\":\"Turns between keepalives of the unchanged comms-override line.\"}","{\"section\":\"context\",\"key\":\"injectGateSwarm\",\"type\":\"boolean\",\"default\":true,\"description\":\"Token cut 4: swarm-guard's shared-tree advisory is injected when new or changed, and again only after context.injectGateSwarmEvery turns.\"}","{\"section\":\"context\",\"key\":\"injectGateSwarmEvery\",\"type\":\"number\",\"default\":20,\"advanced\":true,\"description\":\"Turns between repeats of an unchanged shared-tree advisory.\"}","{\"section\":\"context\",\"key\":\"shrinkInline\",\"type\":\"boolean\",\"default\":true,\"description\":\"Per-hook inline caps at SessionStart: a hook context over its cap becomes a one-line summary plus the path of a file with the full text (nothing is cut). false = every context is sent whole.\"}","{\"section\":\"context\",\"key\":\"inlineHookChars\",\"type\":\"number\",\"default\":1500,\"advanced\":true,\"description\":\"Characters one hook may inject inline at SessionStart before it becomes a summary plus a file; 0 = no per-hook cap.\"}","{\"section\":\"context\",\"key\":\"inlineEventChars\",\"type\":\"number\",\"default\":6000,\"advanced\":true,\"description\":\"Characters all hooks of one SessionStart may inject inline together; the largest shrinkable contexts become a summary plus a file until it fits; 0 = no total.\"}","{\"section\":\"context\",\"key\":\"protocolOnce\",\"type\":\"boolean\",\"default\":true,\"description\":\"Send the verify-first protocol text once per session: the whole compact text at a fresh start, a short digest after a compaction or resume. false = the whole text at every start.\"}","{\"section\":\"maintenance\",\"key\":\"repairOnReload\",\"type\":\"boolean\",\"default\":true,\"description\":\"repair-on-reload (SessionStart/UserPromptSubmit): re-apply safe doctor repairs after a plugin update.\"}","{\"section\":\"maintenance\",\"key\":\"progressPrune\",\"type\":\"boolean\",\"default\":true,\"description\":\"progress-prune (SessionStart): archive stale per-session progress files into the history ledger.\"}","{\"section\":\"maintenance\",\"key\":\"precompactSnapshot\",\"type\":\"boolean\",\"default\":true,\"description\":\"precompact-snapshot (PreCompact): write a mechanical continuation snapshot before compaction.\"}","{\"section\":\"maintenance\",\"key\":\"taskLifecycleLog\",\"type\":\"boolean\",\"default\":true,\"description\":\"task-lifecycle-log (TaskCreated/TaskCompleted): append task events to the per-session history ledger.\"}","{\"section\":\"maintenance\",\"key\":\"sessionEndReaper\",\"type\":\"boolean\",\"default\":true,\"description\":\"session-end-mcp-reaper (SessionEnd): kill orphaned MCP-server processes this session left behind.\"}","{\"section\":\"agents\",\"key\":\"tracker\",\"type\":\"boolean\",\"default\":true,\"description\":\"agent tracker (engine job agent_tick): track agents and raise signals; off, a tick does nothing.\"}","{\"section\":\"agents\",\"key\":\"reminders\",\"type\":\"boolean\",\"default\":true,\"description\":\"agent-reminders (UserPromptSubmit, PostToolUse): deliver the tracker's queued reminders to the agent that owns them; off, signals are recorded but nothing is queued.\"}","{\"section\":\"agents\",\"key\":\"wakeWatch\",\"type\":\"boolean\",\"default\":true,\"description\":\"session wake-watch (Monitor armed at SessionStart): wakes an idle session when an agent it launched goes idle with open work, loops, burns tokens or a watched process ends; off, nothing is armed.\"}","{\"section\":\"agents\",\"key\":\"wakeCoalesceSeconds\",\"type\":\"number\",\"default\":20,\"advanced\":true,\"description\":\"wake-watch (the session Monitor, never blocks): wake rows that arrive within this many seconds of the first unprinted one print as ONE line counting rows per agent, instead of one host notification each (about 40 completion wakes were seen in one session). 0 = every row prints at once. A lone row prints unchanged, up to this many seconds late; the full texts also arrive through the reminder queue. Texts and separators: engine/defaults/agent_tracker.toml (msg.agent_wake_merged).\"}","{\"section\":\"agents\",\"key\":\"ownerNotify\",\"type\":\"boolean\",\"default\":false,\"description\":\"agent tracker owner notices: also append hung / looping / token-waste advisories to the owner notices file.\"}","{\"section\":\"agents\",\"key\":\"burnBreaker\",\"type\":\"boolean\",\"default\":true,\"description\":\"burn breaker (GH #270): warn an agent and notify its coordinator when it spends burn.soft_tokens_no_outcome tokens with no commit, finished step, passing check or new file, and block a subagent's tool calls (except commit, push, status and its report) at burn.hard_tokens_no_outcome. Off: no burn signal, no block.\"}","{\"section\":\"guards\",\"key\":\"uncommittedWork\",\"type\":\"boolean\",\"default\":true,\"description\":\"uncommitted-guard (GH #270; PreToolUse on Edit, Write, MultiEdit, NotebookEdit, apply_patch; subagents only): warn at git.soft_uncommitted_lines and block a subagent's edits at git.max_uncommitted_lines uncommitted lines until it commits.\"}","{\"section\":\"agents\",\"key\":\"wasteSense\",\"type\":\"boolean\",\"default\":true,\"description\":\"agent waste sensor: scores every agent's tokens against its outcomes (commits, finished steps, passing checks, new files), asks the Jev judge when the score is high, and raises a waste advisory; off, no agent is scored.\"}","{\"section\":\"agents\",\"key\":\"lockWatch\",\"type\":\"boolean\",\"default\":true,\"description\":\"lock-holder watchdog: alerts the coordinator when the process holding a shared lock file (the cargo-heavy lock) sits idle while others wait on it; off, no lock is watched.\"}","{\"section\":\"agents\",\"key\":\"lockWatchTerm\",\"type\":\"boolean\",\"default\":false,\"description\":\"lock-holder watchdog auto-action: send SIGTERM to a lock holder idle past the terminate limit while others wait (by verified pid, never by name); off by default.\"}","{\"section\":\"agents\",\"key\":\"actOnStuck\",\"type\":\"boolean\",\"default\":true,\"description\":\"stuck-agent action: a subagent, workspace or one-shot Codex run that stays hung past the action limit is stopped (Codex: SIGTERM by verified pid; workspace: stop request; subagent: stop request to its coordinator); Primaries are exempt; off, stuck agents are only escalated to the owner.\"}","{\"section\":\"agents\",\"key\":\"nudge\",\"type\":\"boolean\",\"default\":true,\"description\":\"nudge loop: an unhealthy subagent, teammate, workspace or Codex run is reported to its direct parent with a plain question and answer options (stop, msg, snooze, other); reminders on a cadence, owner escalation only when the parent is not live or ignores it; off, the plain reminder routes are used.\"}","{\"section\":\"agents\",\"key\":\"nudgeSnoozeHold\",\"type\":\"boolean\",\"default\":true,\"description\":\"agent-health nudge snooze held: a snooze is kept per child and trigger, outlives the nudge it was given to and holds a re-raised condition (no new nudge until it runs out; the count of snoozes carries over); off, a snooze dies with its nudge.\"}","{\"section\":\"agents\",\"key\":\"nudgeDeliverOnce\",\"type\":\"boolean\",\"default\":true,\"description\":\"agent-health nudge delivered once: with a wake-watch armed the nudge goes to the wake feed only (the reminder queue as a fallback when no delivery is recorded in time), so the parent sees it once; off, it goes to both and shows twice.\"}","{\"section\":\"agents\",\"key\":\"nudgeScope\",\"type\":\"boolean\",\"default\":true,\"description\":\"agent-health nudge and wake scope: an answered nudge is never queued again, a health verdict of done holds the nudge, and heartbeat and lock-holder wake rows reach only the session that owns them; off restores the earlier routing.\"}","{\"section\":\"agents\",\"key\":\"nudgeOwnerActive\",\"type\":\"boolean\",\"default\":true,\"description\":\"owner-active rule: a main or workspace session whose owner sent a message in the last window is healthy (no token-waste signal, no nudge); the health judge is also told when the owner last spoke.\"}","{\"section\":\"versionAlerts\",\"key\":\"antiHall\",\"type\":\"boolean\",\"default\":true,\"description\":\"Alert when a newer anti-hall version is available.\"}","{\"section\":\"versionAlerts\",\"key\":\"claudeCli\",\"type\":\"boolean\",\"default\":true,\"description\":\"Alert when a newer Claude CLI version is available.\"}","{\"section\":\"versionAlerts\",\"key\":\"devswarm\",\"type\":\"boolean\",\"default\":true,\"description\":\"Alert when a newer DevSwarm/hivecontrol version is available.\"}","{\"section\":\"updates\",\"key\":\"quiet\",\"type\":\"boolean\",\"default\":false,\"description\":\"Suppress update output (for scripted capture).\"}","{\"section\":\"updates\",\"key\":\"reconcileBudgetMs\",\"type\":\"number\",\"default\":60000,\"advanced\":true,\"description\":\"Time budget (ms) for the reconcile step during update; 0 = unlimited.\"}","{\"section\":\"updates\",\"key\":\"postpullBudgetMs\",\"type\":\"number\",\"default\":90000,\"advanced\":true,\"description\":\"Time budget (ms) for the post-pull update sweep; 0 = unlimited.\"}","{\"section\":\"updates\",\"key\":\"sweepBudgetMs\",\"type\":\"number\",\"default\":20000,\"advanced\":true,\"description\":\"Overall time budget (ms) for the update sweep.\"}","{\"section\":\"updates\",\"key\":\"allowCachePrune\",\"type\":\"boolean\",\"default\":true,\"description\":\"Enables the opt-in `doctor --prune-cache` verb (never automatic: not run by update.js, the supervisor, a cron, SessionStart or any hook). Without --confirmed it only lists the old ~/.claude/plugins/cache/anti-hall/anti-hall/<semver>/ dirs it would remove and their total size; --confirmed removes them and logs each removal. Always keeps the newest 3, the installPath registered in installed_plugins.json, every version a live process runs from, the running version, and anything unparseable; symlinks and paths outside that root are refused. false disables the verb.\"}","{\"section\":\"limitConserve\",\"key\":\"mode\",\"type\":\"enum\",\"default\":\"auto\",\"description\":\"Force conservation mode on/off, or auto-detect from the OMC usage cache.\"}","{\"section\":\"limitConserve\",\"key\":\"threshold\",\"type\":\"number\",\"default\":85,\"description\":\"Usage percent that triggers conservation mode.\"}","{\"section\":\"limitConserve\",\"key\":\"accountCheck\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Guard against stale usage-cache readings after an account switch.\"}","{\"section\":\"jev\",\"key\":\"enabled\",\"type\":\"boolean\",\"default\":false,\"description\":\"Enable Jev (ANTIHALL_JEV=0 always force-disables regardless of this).\"}","{\"section\":\"jev\",\"key\":\"transport\",\"type\":\"enum\",\"default\":\"vercel\",\"description\":\"Vercel AI Gateway passthrough (default) or a direct TypeSafe API call.\"}","{\"section\":\"jev\",\"key\":\"fallbackTransport\",\"type\":\"enum\",\"default\":\"none\",\"description\":\"Automatic backup transport: when the primary vendor times out, errors (5xx) or is out of balance (402/429), retry ONCE on this one, inside the same time budget. none = off; equal to jev.transport = off. Needs its own vendor-bound key (jev_vercel_api_key / jev_typesafe_api_key, or the key file of that vendor with jev.allowLegacyKeyRead). Text then reaches the second vendor.\"}","{\"section\":\"jev\",\"key\":\"judgeModel\",\"type\":\"string\",\"default\":\"haiku\",\"description\":\"Model used for speculation-judge / jev-triage LLM calls.\"}","{\"section\":\"jev\",\"key\":\"judgeBackend\",\"type\":\"enum\",\"default\":\"api\",\"advanced\":true,\"description\":\"How speculation-judge (jev.semanticJudge) reaches the model. api (default) = Anthropic API with the anthropic_api_key plugin option; cli = the local `claude -p` CLI on your own Claude login, no API key (isolated: no tools, no MCP, no settings files, all hooks disabled; about 5-6 s per turn end, measured); auto = api when a key is visible, else cli. Fail-open in every mode.\"}","{\"section\":\"jev\",\"key\":\"speculationBackend\",\"type\":\"enum\",\"default\":\"haiku\",\"advanced\":true,\"description\":\"Which backend answers the semantic speculation question when jev.semanticJudge is on. haiku (default) = the judge asks the model (jev.judgeModel through jev.judgeBackend), except while Jev's own speculation integration is on; jev = the judge never asks the model and speculation-guard's Jev path is the only semantic check; cascade = as jev, and the Jev-first cascade (jevCascade.speculation) is switched on. Answered by the engine (engine/defaults/judge.toml); the Node fallback keeps the haiku behaviour.\"}","{\"section\":\"jev\",\"key\":\"triageBackend\",\"type\":\"enum\",\"default\":\"jev\",\"advanced\":true,\"description\":\"Which backend labels mesh messages in `ah-engine jev triage`. jev (default) = Jev first; a label Jev leaves open stays open, because the engine never calls the Anthropic API (with a key visible it counts an api-not-called row in the judge telemetry); haiku = the model alone, through jev.judgeBackend (the local claude -p CLI about 3-4 s per message, so raise the triage budget to use it).\"}","{\"section\":\"jev\",\"key\":\"cascade\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Global kill switch of the Jev-first cascade. false = no Jev answer is ever re-judged by the model, whatever the per-integration jevCascade switches say.\"}","{\"section\":\"jev\",\"key\":\"cascadeShowJevAnswer\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Whether the model that re-judges an unsure Jev answer is shown Jev's answer and confidence (true) or only the evidence (false), so anchoring can be A/B tested.\"}","{\"section\":\"jev\",\"key\":\"semanticJudge\",\"type\":\"boolean\",\"default\":false,\"description\":\"Enable the semantic speculation-judge hook (off = hook no-ops).\"}","{\"section\":\"jev\",\"key\":\"allowLegacyKeyRead\",\"type\":\"boolean\",\"default\":false,\"advanced\":true,\"locked\":true,\"safetyNote\":\"anti-hall would read the Jev gateway key (the key file) from this machine instead of only the jev_api_key plugin option\",\"description\":\"SAFETY, home-settings only (no env / project override). Opt-in: let anti-hall read the Jev key from the key file (jev.keyFile or the default path) — the only way background tools (CLI, finding-dedup, jev-report) and Codex (no plugin options) see a key. Default off: only the jev_api_key plugin option is used.\"}","{\"section\":\"jev\",\"key\":\"genericKeyVendor\",\"type\":\"enum\",\"default\":\"vercel\",\"advanced\":true,\"locked\":true,\"safetyNote\":\"the generic jev_api_key plugin option and jev.keyFile would be sent to the other vendor (they carry no vendor name, so anti-hall sends them only to this one)\",\"description\":\"SAFETY, home-settings only (no env / plugin option / legacy file). The ONE vendor the legacy generic jev_api_key and jev.keyFile are bound to; they are never sent to any other vendor, whatever jev.transport or jev.fallbackTransport say. Vendor-named keys (jev_vercel_api_key / jev_typesafe_api_key) need no binding. Change it only with `jev-setup.js bind-generic-key --vendor <v>`.\"}","{\"section\":\"jev\",\"key\":\"keyFile\",\"type\":\"string\",\"default\":\"\",\"advanced\":true,\"description\":\"Credential key-file path (default depends on transport).\"}","{\"section\":\"jev\",\"key\":\"timeoutMs\",\"type\":\"number\",\"default\":1500,\"advanced\":true,\"description\":\"Per-call timeout (ms), capped at 3000.\"}","{\"section\":\"jev\",\"key\":\"confidenceThreshold\",\"type\":\"number\",\"default\":0.85,\"advanced\":true,\"description\":\"Minimum confidence for a Jev answer to be trusted by callers.\"}","{\"section\":\"jev\",\"key\":\"triage\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Message-triage labeling once Jev is enabled.\"}","{\"section\":\"jev\",\"key\":\"triageUrgentThreshold\",\"type\":\"number\",\"default\":0.9,\"advanced\":true,\"description\":\"Confidence threshold for the urgent triage label.\"}","{\"section\":\"jev\",\"key\":\"budget.mode\",\"type\":\"enum\",\"default\":\"unlimited\",\"description\":\"Jev spend: no limit, or warn when over budget (never auto-disables).\"}","{\"section\":\"jev\",\"key\":\"budget.usdPerDay\",\"type\":\"number\",\"default\":null,\"description\":\"optional: daily USD spend threshold, used only when budget.mode=watch.\"}","{\"section\":\"jev\",\"key\":\"budget.usdPerWeek\",\"type\":\"number\",\"default\":null,\"description\":\"optional: weekly USD spend threshold, used only when budget.mode=watch.\"}","{\"section\":\"jev\",\"key\":\"weeklyNotice\",\"type\":\"boolean\",\"default\":true,\"description\":\"Once-a-week SessionStart scorecard notice naming one integration worth promoting or turning off (Jev enabled only).\"}","{\"section\":\"jev\",\"key\":\"audit.snippets\",\"type\":\"boolean\",\"default\":false,\"advanced\":true,\"description\":\"Store a redacted ~200-char snippet for decisions Jev changed or would change in shadow mode (off by default: privacy).\"}","{\"section\":\"jev\",\"key\":\"logRotatedFiles\",\"type\":\"number\",\"default\":10,\"advanced\":true,\"description\":\"Rotated generations kept for jev-assist.ndjson (2MB each) and jev-triage.ndjson (1MB each): .1 .. .N. 10 keeps roughly 20 days of decision rows at ~1MB/day.\"}","{\"section\":\"jev\",\"key\":\"rollupRetentionDays\",\"type\":\"number\",\"default\":0,\"advanced\":true,\"description\":\"Days of daily rollups (~/.anti-hall/logs/jev-daily/<day>.json) to keep. 0 (default) keeps every rollup; only an explicit N > 0 removes rollups older than N days.\"}","{\"section\":\"jev\",\"key\":\"budget.minCreditUsd\",\"type\":\"number\",\"default\":null,\"description\":\"optional: warn (once a day, budget.mode=watch only) when the gateway credit balance drops below this USD amount.\"}","{\"section\":\"jev\",\"key\":\"prices\",\"type\":\"object\",\"default\":null,\"advanced\":true,\"description\":\"computed: per-model USD price table {model: {inPerMTok, outPerMTok}} (or a \\\"default\\\" entry), used only when the gateway reports tokens but no cost. File-only (no env, no CLI set) — edit ~/.anti-hall/settings.json directly.\"}","{\"section\":\"jev\",\"key\":\"priceUsdPerMInput\",\"type\":\"number\",\"default\":0.042,\"advanced\":true,\"description\":\"USD per 1M input tokens for the Jev judge call, used to compute costUsd when the gateway reports tokens but no cost and `prices` has no matching entry. Default is Jev's own published rate (verified: typesafe.ai, vercel.com/ai-gateway/models/jev, openrouter.ai/typesafe).\"}","{\"section\":\"jev\",\"key\":\"priceUsdPerMOutput\",\"type\":\"number\",\"default\":0,\"advanced\":true,\"description\":\"USD per 1M output tokens for the Jev judge call (default 0 — output is free on the verified rate).\"}","{\"section\":\"jev\",\"key\":\"dispatchTierNoWorkspaceRepos\",\"type\":\"csv\",\"default\":\"\",\"advanced\":true,\"description\":\"Repos (directory basenames or absolute paths; \\\"*\\\" = all) where the Jev dispatchTier recommendation never says `workspace` (shown as `subagent`, logged as repo-override).\"}","{\"section\":\"jev\",\"key\":\"dispatchTierDetectNoWorkspaces\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Also treat a repo as no-workspace when its CLAUDE.md / AGENTS.md says \\\"no workspaces for real work\\\".\"}","{\"section\":\"jev\",\"key\":\"reviewAfterDays\",\"type\":\"number\",\"default\":7,\"description\":\"Minimum days an integration must have sat in shadow mode before its shadow numbers are DUE for owner review (also the re-review cadence once reviewed).\"}","{\"section\":\"jev\",\"key\":\"reviewMinDecisions\",\"type\":\"number\",\"default\":30,\"description\":\"Minimum decisions logged for a shadow integration before its review is due — avoids nagging about a barely-used integration with too little data to judge.\"}","{\"section\":\"jev\",\"key\":\"reviewReminder\",\"type\":\"boolean\",\"default\":true,\"description\":\"Durable \\\"time to review the Jev shadow numbers\\\" SessionStart/doctor nudge (on by default — owner opt-out only).\"}","{\"section\":\"jev\",\"key\":\"recommendNotice\",\"type\":\"boolean\",\"default\":true,\"description\":\"Bold \\\"Recommended: enable Jev\\\" notice at SessionStart (once on first install, then at most every 30 days) and in doctor, shown only while Jev is NOT enabled. Set false to silence it.\"}","{\"section\":\"jev\",\"key\":\"recommendNoticeHeadless\",\"type\":\"boolean\",\"default\":false,\"advanced\":true,\"description\":\"Allow the \\\"Recommended: enable Jev\\\" notice in non-interactive runs (claude -p / SDK, detected by CLAUDE_CODE_ENTRYPOINT=sdk-*). Default false: nobody reads it there, and a headless run no longer uses up the notice's once-per-30-days slot. JEV REVIEW DUE is not affected; Codex is unchanged. When not set explicitly, context.protocolLevel=full makes the default true.\"}","{\"section\":\"jevCascade\",\"key\":\"speculation\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a speculation Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"triage\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a triage Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"newRequest\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a newRequest Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"claimLedger\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a claimLedger Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"outputVerifyGuard\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a outputVerifyGuard Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"gitGuardSelfCredit\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a gitGuardSelfCredit Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"modelRouting\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a modelRouting Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"tasklistTrivial\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a tasklistTrivial Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"codexNudgeSubstantial\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a codexNudgeSubstantial Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"mergeGateHedge\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a mergeGateHedge Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"parentGateQuestion\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a parentGateQuestion Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"supervisorBlockerLabel\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a supervisorBlockerLabel Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"findingDedup\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a findingDedup Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"postHandoverGate\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a postHandoverGate Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"speculationFramed\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a speculationFramed Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"dispatchTier\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a dispatchTier Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"devswarmOnBrief\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a devswarmOnBrief Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"devswarmExtraSanctioned\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a devswarmExtraSanctioned Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"devswarmWaitKind\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a devswarmWaitKind Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"devswarmLoop\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a devswarmLoop Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevCascade\",\"key\":\"devswarmStepMap\",\"type\":\"enum\",\"default\":\"off\",\"advanced\":true,\"description\":\"Re-judge a devswarmStepMap Jev answer the model when Jev is unsure (see the section note). on | off.\"}","{\"section\":\"jevIntegrations\",\"key\":\"speculation\",\"type\":\"enum\",\"default\":\"on\",\"description\":\"Is this claim unsupported speculation (add-block trust: Jev may only turn a non-block baseline into a block).\"}","{\"section\":\"jevIntegrations\",\"key\":\"triage\",\"type\":\"enum\",\"default\":\"on\",\"description\":\"Mesh message urgency/kind labeling (advisory: its own triage client, not the add-block/relax-block trust model).\"}","{\"section\":\"jevIntegrations\",\"key\":\"newRequest\",\"type\":\"enum\",\"default\":\"shadow\",\"description\":\"Classify a prompt as new-request/follow-up/correction/question (advisory trust).\"}","{\"section\":\"jevIntegrations\",\"key\":\"claimLedger\",\"type\":\"enum\",\"default\":\"shadow\",\"description\":\"Is a flagged claim genuinely unsupported by evidence (relax-block trust: Jev may only turn a blocking baseline into a non-block).\"}","{\"section\":\"jevIntegrations\",\"key\":\"outputVerifyGuard\",\"type\":\"enum\",\"default\":\"shadow\",\"description\":\"Does this test-runner output actually indicate a pass (advisory trust).\"}","{\"section\":\"jevIntegrations\",\"key\":\"gitGuardSelfCredit\",\"type\":\"enum\",\"default\":\"shadow\",\"description\":\"Does this commit/PR message contain paraphrased AI self-credit (add-block trust; never relaxes git-guard).\"}","{\"section\":\"jevIntegrations\",\"key\":\"modelRouting\",\"type\":\"enum\",\"default\":\"shadow\",\"description\":\"Is this agent-spawn task actually mechanical (relax-block trust).\"}","{\"section\":\"jevIntegrations\",\"key\":\"tasklistTrivial\",\"type\":\"enum\",\"default\":\"shadow\",\"description\":\"tasklist-guard: is this session a genuinely non-trivial, multi-part effort (relax-block trust; asked synchronously, 1.5 s cap, fail-open).\"}","{\"section\":\"jevIntegrations\",\"key\":\"codexNudgeSubstantial\",\"type\":\"enum\",\"default\":\"shadow\",\"description\":\"codex-nudge: are these file edits genuinely substantial, not just formatting (relax-block trust; asked synchronously, 1.5 s cap, fail-open).\"}","{\"section\":\"jevIntegrations\",\"key\":\"mergeGateHedge\",\"type\":\"enum\",\"default\":\"shadow\",\"description\":\"Does this text hedge on merge-readiness (relax-block trust; askDetached fire-and-forget in shadow).\"}","{\"section\":\"jevIntegrations\",\"key\":\"parentGateQuestion\",\"type\":\"enum\",\"default\":\"shadow\",\"description\":\"Is this unread child message really a question awaiting a reply (add-block trust; cache-only, zero network).\"}","{\"section\":\"jevIntegrations\",\"key\":\"supervisorBlockerLabel\",\"type\":\"enum\",\"default\":\"shadow\",\"description\":\"Is a stale child waiting-on-parent or genuinely wedged (advisory trust; cache-only, zero network).\"}","{\"section\":\"jevIntegrations\",\"key\":\"findingDedup\",\"type\":\"enum\",\"default\":\"on\",\"description\":\"Do two deadly-loop TRIO findings describe the same underlying issue, for advisory duplicate-grouping (advisory trust); default on — 65/65 correct at confidence >=0.85 on a 30-day, 3-project offline benchmark (see CHANGELOG 0.108.4).\"}","{\"section\":\"jevIntegrations\",\"key\":\"postHandoverGate\",\"type\":\"enum\",\"default\":\"off\",\"description\":\"Does this new request fit in the remaining post-handover context budget (advisory trust; askDetached fire-and-forget, zero latency). Default off: an offline benchmark (n=299) found park-recall 17.6% vs 28.8% for the agent's own size judgment plus the measured budget backstop, no gain over the baseline.\"}","{\"section\":\"jevIntegrations\",\"key\":\"speculationFramed\",\"type\":\"enum\",\"default\":\"shadow\",\"description\":\"When a deterministic speculation-guard hedge hit sits under a FRAMED heading/line prefix (Expected/Plan/\\\"Should be <verb>:\\\"/\\\"Should still\\\"/Unverified/\\\"(unverified)\\\"/\\\"not yet measured\\\"), is it a stated expectation/plan or an unverified claim presented as fact (relax-block trust: Jev may only turn the framed hit's block into a non-block; an unframed hedge never consults Jev and always blocks).\"}","{\"section\":\"jevIntegrations\",\"key\":\"dispatchTier\",\"type\":\"enum\",\"default\":\"on\",\"description\":\"Recommend how each dispatchable task should be dispatched — workspace / workflow / subagent — on the DISPATCH NOW line (advisory trust; never blocks or forces; the Primary makes the final call). on = annotate \\\"#7 … → subagent (0.91)\\\"; shadow = log only; asked via askDetached only when a task's text changes (PostToolUse TaskCreate/TaskUpdate). Outcomes logged: actual dispatch followed/overridden, subagent one-lane vs escalated, workflow fan-out.\"}","{\"section\":\"jevIntegrations\",\"key\":\"devswarmOnBrief\",\"type\":\"enum\",\"default\":\"on\",\"description\":\"DevSwarm supervision: is a child's off-scope work actually off its brief (relax-block over the off-scope straying warning; asked detached from the supervisor sweep only when off-scope fires, answer read from the cache next sweep; input: current step, scope, last 3 summaries, last 5 commit subjects, off-scope files, <=1.5k chars scrubbed).\"}","{\"section\":\"jevIntegrations\",\"key\":\"devswarmExtraSanctioned\",\"type\":\"enum\",\"default\":\"on\",\"description\":\"DevSwarm supervision, recommendation (as devswarmOnBrief): did the user ask for this off-scope work (annotates the off-scope warning, threshold >=0.9; an explicit `scope add` always wins; input: the child's last user prompts, secrets scrubbed, plus the off-scope files, <=1k chars).\"}","{\"section\":\"jevIntegrations\",\"key\":\"devswarmWaitKind\",\"type\":\"enum\",\"default\":\"on\",\"description\":\"DevSwarm supervision, recommendation (as devswarmOnBrief): is an idle/stalled child stuck or legitimately waiting on CI, the owner or a peer (annotates the idle/stall warning; input: step, last summary, signal reasons, <=800 chars).\"}","{\"section\":\"jevIntegrations\",\"key\":\"devswarmLoop\",\"type\":\"enum\",\"default\":\"on\",\"description\":\"DevSwarm supervision, recommendation (as devswarmOnBrief): is a busy child looping on its step (annotates a burn/stall warning, or adds its own advisory `loop` warning when none fired; threshold >=0.9; asked when the step is older than 2x devswarm.stepStallMin or a burn warning fired; input: step, time on step, tokens since the step moved, summaries, commit churn, <=1.2k chars).\"}","{\"section\":\"jevIntegrations\",\"key\":\"devswarmStepMap\",\"type\":\"enum\",\"default\":\"on\",\"description\":\"DevSwarm supervision, recommendation: which plan step a heartbeat summary without --step describes (threshold 0.8; when on it fills an inferred `~N` step that shows only while the child never reported a step itself).\"}","{\"section\":\"devswarm\",\"key\":\"hivecontrol\",\"type\":\"string\",\"default\":\"\",\"description\":\"Explicit path to the hivecontrol CLI binary (default: PATH lookup — no single default value; empty means \\\"look it up\\\").\"}","{\"section\":\"devswarm\",\"key\":\"supervisorMode\",\"type\":\"enum\",\"default\":\"auto\",\"description\":\"Force the DevSwarm supervisor context on/off, or auto-detect.\"}","{\"section\":\"devswarm\",\"key\":\"requiredGates\",\"type\":\"csv\",\"default\":\"done,merged,tests_passed\",\"description\":\"Merge gates required for DevSwarm tasks.\"}","{\"section\":\"devswarm\",\"key\":\"inboxCmd\",\"type\":\"string\",\"default\":\"\",\"description\":\"Consumer-configured command to read pending mesh messages (no built-in default).\"}","{\"section\":\"devswarm\",\"key\":\"heldPartitions\",\"type\":\"csv\",\"default\":\"\",\"advanced\":true,\"description\":\"Owner-held mesh partition ids (comma-separated). A held partition is exempt from the per-turn \\\"ORPHANED MESH\\\" warning and from `reap-orphans`; it still appears in `diagnose`/`doctor` as held by owner.\"}","{\"section\":\"devswarm\",\"key\":\"childGateStrict\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Strict child-gate enforcement.\"}","{\"section\":\"devswarm\",\"key\":\"parentGateCap\",\"type\":\"number\",\"default\":3,\"advanced\":true,\"description\":\"Caps the parent-gate wait/child count, clamped to [2,5].\"}","{\"section\":\"devswarm\",\"key\":\"parentGateNeglectMinUnread\",\"type\":\"number\",\"default\":0,\"advanced\":true,\"description\":\"Minimum real-unread count a genuinely NOT-busy child needs before the parent Stop gate hard-blocks on it; 0 = any real unread blocks (pre-existing sensitivity, unchanged default). A BUSY child (fresh real-work transcript, see parentGateBusyFreshMin) gets an advisory line instead, until its oldest unread passes parentGateBusyMaxAgeMin. A child waiting on its own question/plan approval always blocks.\"}","{\"section\":\"devswarm\",\"key\":\"parentGateBusyFreshMin\",\"type\":\"number\",\"default\":5,\"advanced\":true,\"description\":\"Minutes a child's transcript may be quiet and still count as busy for the parent Stop gate. Busy needs positive evidence: a transcript written within this window whose latest turn is real work (not a mailbox ping, not waiting). A live pid or a fresh heartbeat alone never counts. An unresolved tool call on a transcript quiet longer than this is treated as waiting (permission prompt or hung tool).\"}","{\"section\":\"devswarm\",\"key\":\"parentGateBusyMaxAgeMin\",\"type\":\"number\",\"default\":60,\"advanced\":true,\"description\":\"Age cap (minutes) on the busy advisory: once a busy child's oldest unread message is older than this, the parent Stop gate blocks anyway (\\\"busy but hasn't read mail in Xm\\\"). An unknown message age never qualifies for the advisory.\"}","{\"section\":\"devswarm\",\"key\":\"parentGateNeglectGraceMin\",\"type\":\"number\",\"default\":1,\"advanced\":true,\"description\":\"Grace window (minutes) for a plain unread backlog on the parent Stop gate: an unread message younger than this never counts as neglect by itself, independent of whether the child is separately provably busy — a Primary that just sent a child a message should not be hard-blocked seconds later, before the child has had a turn to read it. Never applies to a store-only (mesh-direct send, or dead/foreign-descriptor) row, and never suppresses an unanswered child question, an escalation, or unread older than this window. Default kept at 1 (not higher) so it never overlaps the 2-minute-old backlog this file's own busy/idle regressions use as their baseline \\\"still neglect\\\" fixture.\"}","{\"section\":\"devswarm\",\"key\":\"activeFloorPct\",\"type\":\"number\",\"default\":50,\"advanced\":true,\"description\":\"Min percent of active workspaces kept in the archived cache (0 disables the floor).\"}","{\"section\":\"devswarm\",\"key\":\"archivedCacheMaxAgeMs\",\"type\":\"number\",\"default\":null,\"advanced\":true,\"description\":\"computed: no fixed default — 2x the reconcile sweep’s own resolved cooldown (itself env/default-derived), not a literal constant.\"}","{\"section\":\"devswarm\",\"key\":\"archivedGraceMs\",\"type\":\"number\",\"default\":600000,\"advanced\":true,\"description\":\"Grace period (ms) before a workspace is considered archived.\"}","{\"section\":\"devswarm\",\"key\":\"cooldownSec\",\"type\":\"number\",\"default\":600,\"advanced\":true,\"description\":\"Supervisor cooldown (sec) between recovery actions.\"}","{\"section\":\"devswarm\",\"key\":\"idleSec\",\"type\":\"number\",\"default\":900,\"advanced\":true,\"description\":\"Supervisor idle threshold (sec).\"}","{\"section\":\"devswarm\",\"key\":\"dormantMs\",\"type\":\"number\",\"default\":1800000,\"advanced\":true,\"description\":\"Dormant-workspace threshold (ms).\"}","{\"section\":\"devswarm\",\"key\":\"drainTtlMs\",\"type\":\"number\",\"default\":600000,\"advanced\":true,\"description\":\"TTL (ms) for the drain marker.\"}","{\"section\":\"devswarm\",\"key\":\"graceSec\",\"type\":\"number\",\"default\":5,\"advanced\":true,\"description\":\"Grace window (sec) before recovery in devswarm-recover.\"}","{\"section\":\"devswarm\",\"key\":\"maxRecoveries\",\"type\":\"number\",\"default\":3,\"advanced\":true,\"description\":\"Max auto-recovery attempts.\"}","{\"section\":\"devswarm\",\"key\":\"intervalSec\",\"type\":\"number\",\"default\":90,\"advanced\":true,\"description\":\"Sweep interval (sec) used at supervisor install time, clamped [60,120].\"}","{\"section\":\"devswarm\",\"key\":\"migrateMarkRead\",\"type\":\"boolean\",\"default\":false,\"advanced\":true,\"description\":\"Mark migrated messages as read during state migration.\"}","{\"section\":\"devswarm\",\"key\":\"monitorTimeoutSec\",\"type\":\"number\",\"default\":30,\"advanced\":true,\"description\":\"Bounded cadence (sec) for monitor timeout in devswarm-ingest.\"}","{\"section\":\"devswarm\",\"key\":\"monitorNoOkFailMin\",\"type\":\"number\",\"default\":10,\"advanced\":true,\"description\":\"Minutes without a successful monitor poll (since daemon start, or since the last success) before ingest health reads FAILING; inside the window a fresh daemon reads \\\"starting up\\\".\"}","{\"section\":\"devswarm\",\"key\":\"nudgeCooldownSec\",\"type\":\"number\",\"default\":120,\"advanced\":true,\"description\":\"Cooldown (sec) between supervisor nudges.\"}","{\"section\":\"devswarm\",\"key\":\"nudgeMaxAttempts\",\"type\":\"number\",\"default\":2,\"advanced\":true,\"description\":\"Max nudge attempts before escalation.\"}","{\"section\":\"devswarm\",\"key\":\"nudgeWindowSec\",\"type\":\"number\",\"default\":180,\"advanced\":true,\"description\":\"Window (sec) for counting nudge attempts.\"}","{\"section\":\"devswarm\",\"key\":\"postSpawnGraceSec\",\"type\":\"number\",\"default\":120,\"advanced\":true,\"description\":\"Grace period (sec) right after spawning a child workspace, clamped [0,1800].\"}","{\"section\":\"devswarm\",\"key\":\"reapedRetentionDays\",\"type\":\"number\",\"default\":30,\"advanced\":true,\"description\":\"Retention window (days) for reaped-workspace logs.\"}","{\"section\":\"devswarm\",\"key\":\"receiptWindowMs\",\"type\":\"number\",\"default\":300000,\"advanced\":true,\"description\":\"Window (ms) for parent-reply receipt tracking.\"}","{\"section\":\"devswarm\",\"key\":\"archiveRequestRenagHours\",\"type\":\"number\",\"default\":24,\"advanced\":true,\"description\":\"Hours a pending archive-request suppresses the ARCHIVE-READY re-nudge and the CHILD NOT DRAINING nag for that child before re-nagging anyway.\"}","{\"section\":\"devswarm\",\"key\":\"reconcileSweep\",\"type\":\"enum\",\"default\":\"auto\",\"advanced\":true,\"description\":\"Enable/disable the periodic reconcile sweep in the supervisor.\"}","{\"section\":\"devswarm\",\"key\":\"reconcileSweepSec\",\"type\":\"number\",\"default\":900,\"advanced\":true,\"description\":\"Interval (sec) for the reconcile sweep, floor 300s.\"}","{\"section\":\"devswarm\",\"key\":\"sweepTailMode\",\"type\":\"enum\",\"default\":\"engine\",\"values\":[\"engine\",\"off\"],\"advanced\":true,\"description\":\"Who decides the DevSwarm sweep tail (archived registry rows, twin descriptors, the deferred and reconcile-family update stages): engine = the engine decides and applies each step (default); off = those steps are disabled (counted, nothing written).\"}","{\"section\":\"devswarm\",\"key\":\"rowStaleMs\",\"type\":\"number\",\"default\":86400000,\"advanced\":true,\"description\":\"Staleness threshold (ms) for workspace row selection.\"}","{\"section\":\"devswarm\",\"key\":\"sendReceiptRetentionDays\",\"type\":\"number\",\"default\":7,\"advanced\":true,\"description\":\"Retention window (days) for send-receipt records.\"}","{\"section\":\"devswarm\",\"key\":\"summaryRetentionDays\",\"type\":\"number\",\"default\":30,\"advanced\":true,\"description\":\"Retention window (days) for summary records.\"}","{\"section\":\"devswarm\",\"key\":\"wakeCron\",\"type\":\"string\",\"default\":\"7,37 * * * *\",\"advanced\":true,\"description\":\"Wake-poll cron schedule override (treated as untrusted input).\"}","{\"section\":\"devswarm\",\"key\":\"rearmOnTickOnly\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"TOKEN SAVINGS (0.117.0): re-arm a lapsed Monitor wake-watch ONLY from the cron tick's own `watcherArmed:false` check, never inline on the Monitor tool's own final/expired event (reply in <=1 line there instead) — collapses two overlapping ~30-minute re-arm triggers into one. false restores the pre-0.117.0 wording (re-arm inline on expiry too). Metric: ~/.anti-hall/devswarm/rearm-cues.jsonl records each cue by trigger (tick vs expiry).\"}","{\"section\":\"devswarm\",\"key\":\"cronMissingWarnMin\",\"type\":\"number\",\"default\":60,\"advanced\":true,\"description\":\"Minutes without a fresh inbox-tick marker (cron not running — e.g. after a DevSwarm crash/session restore/Claude restart) before the Stop gate warns once, capped, to CronList/CronCreate the wake cron again.\"}","{\"section\":\"devswarm\",\"key\":\"wakeWatchPollMs\",\"type\":\"number\",\"default\":2000,\"advanced\":true,\"description\":\"Poll interval (ms) for the wake-watch loop, clamped [250,60000].\"}","{\"section\":\"devswarm\",\"key\":\"wakeWatchIdleSkip\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"TOKEN SAVINGS (#39): a Primary with 0 LIVE (non-archived) child workspaces gains nothing from an armed wake-watch Monitor — nothing will ever message it. When on and the caller is a Primary with 0 live children, `inbox tick` reports `watcherArmed idle-skip` (not `false`) so the cron prompt's \\\"re-arm if watcherArmed false\\\" rule does not fire, and the wake watcher, if started anyway, prints one line and exits 0 without arming. A live child (even one Monitor lapse away from `false`) is unchanged; archived-only, held (devswarm.heldPartitions) and archive-ignored children also count as 0 live. The cron fallback is never affected. Metric: ~/.anti-hall/devswarm/rearm-cues.jsonl records each idle-skip (trigger 'idle-skip'), surfaced by doctor.\"}","{\"section\":\"devswarm\",\"key\":\"dispatchTierText\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"The DevSwarm PRIMARY dispatch-tier text (\\\"the workspace is your top fan-out tier ...\\\") that task-tracker, verify-first and verify-first-orch inject. Off removes it everywhere; it is also never injected in a repo whose CLAUDE.md/AGENTS.md forbids workspaces for real work (jev.dispatchTierNoWorkspaceRepos / dispatchTierDetectNoWorkspaces). Governs only this injected text; the separate devswarm.inlineWorkNudge has its own switch and is not affected.\"}","{\"section\":\"devswarm\",\"key\":\"inlineWorkNudge\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Advisory, DevSwarm PRIMARY only: once per session, when pending actionable tasks exist, the Primary has PROVEN zero live child workspaces, and its main thread has made more than devswarm.inlineWorkNudgeThreshold Edit/Write/NotebookEdit calls, one note says workspace-scale work belongs in a child workspace. Silent when liveness cannot be determined, in a child workspace, and in a repo that forbids workspaces. Rides the edit-guard PreToolUse hook (so it is inactive while safety.editGuard is off or edit-guard is skipped). Never blocks. Independent of devswarm.dispatchTierText (turning that text off does not silence this nudge).\"}","{\"section\":\"devswarm\",\"key\":\"inlineWorkNudgeThreshold\",\"type\":\"number\",\"default\":5,\"advanced\":true,\"description\":\"Main-thread Edit/Write/NotebookEdit calls a Primary may make before devswarm.inlineWorkNudge fires (the nudge fires on the call after this many).\"}","{\"section\":\"devswarm\",\"key\":\"tickRosterEvery\",\"type\":\"number\",\"default\":0,\"advanced\":true,\"description\":\"Every Nth `inbox tick --quiet` on a Primary appends the compact roster table after the unchanged first line, but only when roster data proves at least one live child and unread is 0 and known. 0 (default) = never. The JSON form of tick (no --quiet, or --json) is never changed.\"}","{\"section\":\"devswarm\",\"key\":\"childGateRetentionDays\",\"type\":\"number\",\"default\":14,\"advanced\":true,\"description\":\"Days a per-session child-gate state file is kept before the housekeeping/doctor sweep removes it.\"}","{\"section\":\"devswarm\",\"key\":\"housekeepingSweep\",\"type\":\"enum\",\"default\":\"auto\",\"advanced\":true,\"description\":\"Supervisor disk-hygiene sweep (reaped logs, child-gate state); only \\\"off\\\" disables it.\"}","{\"section\":\"devswarm\",\"key\":\"housekeepingSweepSec\",\"type\":\"number\",\"default\":3600,\"advanced\":true,\"description\":\"Seconds between housekeeping sweeps, floor 300.\"}","{\"section\":\"devswarm\",\"key\":\"supervisorLogRotateBytes\",\"type\":\"number\",\"default\":10485760,\"advanced\":true,\"description\":\"Size at which the supervisor rotates its own log.\"}","{\"section\":\"devswarm\",\"key\":\"inboxGraceSec\",\"type\":\"number\",\"default\":120,\"advanced\":true,\"description\":\"Grace window (sec) before a child's fresh unread is flagged, unless it heartbeats first; 0 = no grace.\"}","{\"section\":\"devswarm\",\"key\":\"supervisorSweepBudgetMs\",\"type\":\"number\",\"default\":20000,\"advanced\":true,\"description\":\"Time budget (ms) for one supervisor sweep pass.\"}","{\"section\":\"devswarm\",\"key\":\"supervisorBlockerLabelReaskSec\",\"type\":\"number\",\"default\":21600,\"advanced\":true,\"description\":\"Seconds a supervisorBlockerLabel ask/log is suppressed while its input (childId+kind+ts) is unchanged, before a periodic re-ask fires anyway. Also the per-input re-ask window of the five devswarm* supervision Jev integrations (0.117.0).\"}","{\"section\":\"devswarm\",\"key\":\"autoArchive.mode\",\"type\":\"enum\",\"default\":\"on\",\"description\":\"Auto-archive finished workspaces (needs DevSwarm ≥ 2.5.3).\"}","{\"section\":\"devswarm\",\"key\":\"autoArchive.idleMin\",\"type\":\"number\",\"default\":30,\"advanced\":true,\"description\":\"Minutes idle before a finished workspace is eligible for auto-archive.\"}","{\"section\":\"devswarm\",\"key\":\"autoArchive.maxPerSweep\",\"type\":\"number\",\"default\":3,\"advanced\":true,\"description\":\"Max workspaces auto-archived in one sweep.\"}","{\"section\":\"devswarm\",\"key\":\"autoArchive.ignorePings\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Idle timer ignores a finished workspace's own mailbox-wake/heartbeat/status turns; real work (an AI turn, a tool call, a new message, a commit) still resets it. Off = any activity resets it.\"}","{\"section\":\"devswarm\",\"key\":\"retention.days\",\"type\":\"number\",\"default\":30,\"advanced\":true,\"description\":\"Days of message bodies kept before archive+prune; 0 = retention off.\"}","{\"section\":\"devswarm\",\"key\":\"retention.maxStoreMB\",\"type\":\"number\",\"default\":100,\"advanced\":true,\"description\":\"Store size limit (MB): above it, oldest bodies are pruned regardless of age; 0 = no limit.\"}","{\"section\":\"devswarm\",\"key\":\"retention.keepPerPartition\",\"type\":\"number\",\"default\":200,\"advanced\":true,\"description\":\"Newest messages per partition that are never pruned (age or size).\"}","{\"section\":\"devswarm\",\"key\":\"retention.archive\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"Write pruned bodies to the gzip archive first (restorable via `ah-engine mesh retention restore`).\"}","{\"section\":\"devswarm\",\"key\":\"retention.archiveMaxMB\",\"type\":\"number\",\"default\":0,\"advanced\":true,\"description\":\"Archive size cap (MB); 0 (default) = never evict; above a set cap the oldest archive months are dropped. doctor warns past 500 MB.\"}","{\"section\":\"devswarm\",\"key\":\"parentGate\",\"type\":\"boolean\",\"default\":true,\"description\":\"devswarm-parent-gate (Stop): make a Primary attend to a child with unread mail or a stale verdict before stopping.\"}","{\"section\":\"devswarm\",\"key\":\"childGate\",\"type\":\"boolean\",\"default\":true,\"description\":\"devswarm-child-gate (Stop): make a child workspace heartbeat/report to its parent before going idle.\"}","{\"section\":\"devswarm\",\"key\":\"parentInbox\",\"type\":\"boolean\",\"default\":true,\"description\":\"devswarm-parent-inbox (UserPromptSubmit): inject the workspace roster and unread child mail into a Primary.\"}","{\"section\":\"devswarm\",\"key\":\"childTurn\",\"type\":\"boolean\",\"default\":true,\"description\":\"devswarm-child-turn (UserPromptSubmit): inject a child workspace's pending mail each turn.\"}","{\"section\":\"devswarm\",\"key\":\"childRole\",\"type\":\"boolean\",\"default\":true,\"description\":\"devswarm-child-role (SessionStart): inject the mesh-only messaging directive into Primary and child sessions.\"}","{\"section\":\"devswarm\",\"key\":\"childDrain\",\"type\":\"boolean\",\"default\":true,\"description\":\"devswarm-child-drain (PostToolUse Bash): re-surface a child's unread mail mid-task (throttled).\"}","{\"section\":\"devswarm\",\"key\":\"parentReplyTracker\",\"type\":\"boolean\",\"default\":true,\"description\":\"devswarm-parent-reply-tracker (PostToolUse Bash): record the Primary's direct replies so the parent gate can tell read from answered.\"}","{\"section\":\"devswarm\",\"key\":\"commsGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"devswarm-comms-guard (PreToolUse SendMessage): block SendMessage to a DevSwarm workspace (mesh messaging only).\"}","{\"section\":\"devswarm\",\"key\":\"inboxReadGuard\",\"type\":\"boolean\",\"default\":true,\"description\":\"inbox-read-guard (PreToolUse Read): block raw Read-tool reads of the DevSwarm inbox/store (use the wrapper).\"}","{\"section\":\"devswarm\",\"key\":\"wakeWatch\",\"type\":\"boolean\",\"default\":true,\"description\":\"devswarm-wake-watch monitor: wake an idle session the moment new mesh mail lands (the cron fallback stays).\"}","{\"section\":\"devswarm\",\"key\":\"appSync\",\"type\":\"boolean\",\"default\":true,\"description\":\"Supervisor app-DB sync: apply the DevSwarm app database (archive state, names, drift) every tick.\"}","{\"section\":\"devswarm\",\"key\":\"screenshotSync\",\"type\":\"boolean\",\"default\":true,\"description\":\"`ah-engine mesh sync-ui`: reconcile a transcribed sidebar screenshot against the app DB.\"}","{\"section\":\"devswarm\",\"key\":\"spawnFromOrigin\",\"type\":\"boolean\",\"default\":true,\"description\":\"`ah-engine mesh spawn`: fetch origin first and fast-forward the local default branch so a child never starts from stale tooling; refuses when it is behind and cannot be updated (unless --from-local).\"}","{\"section\":\"devswarm\",\"key\":\"spawnStrictFlagValues\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"`ah-engine mesh spawn`: refuse when a value-taking create option (-s/--source, -a/--agent, -t/--title, -p/--prompt) has no value or is handed what looks like the next option (e.g. `-t -p \\\"brief\\\"` would make \\\"-p\\\" the title), naming the flag.\"}","{\"section\":\"devswarm\",\"key\":\"sendMultiRecipient\",\"type\":\"boolean\",\"default\":true,\"advanced\":true,\"description\":\"`ah-engine mesh send`: `--to <id1>,<id2>` or a repeated `--to` sends the same body to each (deduped) recipient, attempts every one even after a failure, and exits non-zero if any failed. false restores the old parsing (last --to wins).\"}","{\"section\":\"devswarm\",\"key\":\"spawnFetchTtlSec\",\"type\":\"number\",\"default\":300,\"advanced\":true,\"description\":\"`ah-engine mesh spawn`: skip the origin fetch when the remote-tracking ref was already updated within this many seconds (0 = always fetch).\"}","{\"section\":\"devswarm\",\"key\":\"spawnCreateTimeoutMs\",\"type\":\"number\",\"default\":180000,\"advanced\":true,\"description\":\"Timeout (ms) for the `hivecontrol workspace create` call spawn makes; on timeout only our own child process is killed.\"}","{\"section\":\"devswarm\",\"key\":\"planTracking\",\"type\":\"boolean\",\"default\":true,\"description\":\"Step-plan tracking: `spawn` turns a numbered list in -p into the child's plan file, the roster and workspace table show \\\"3/7 done · doing #4 · 42m · progress 18m ago\\\", and the child is reminded to report `heartbeat --step N`. Off: no plan is written or shown (the explicit `plan` / `heartbeat --step` verbs still work).\"}","{\"section\":\"devswarm\",\"key\":\"planRequired\",\"type\":\"boolean\",\"default\":false,\"description\":\"Ask every child without a step plan to write one (`ah-engine mesh plan set`) on each turn. Never refuses a spawn — numbered step lists stay encouraged, not enforced.\"}","{\"section\":\"devswarm\",\"key\":\"stepStallMin\",\"type\":\"number\",\"default\":30,\"advanced\":true,\"description\":\"Minutes a busy child with a step plan may go without step progress (or since its last correction) before the supervisor raises a `stall` straying warning; also the window in which step progress after a correction counts as \\\"correction worked\\\".\"}","{\"section\":\"devswarm\",\"key\":\"strayWarnMax\",\"type\":\"number\",\"default\":2,\"advanced\":true,\"description\":\"Most straying warnings per signal (stall / off-scope / idle / jev-*) per plan step; each is shown once as an advisory DEVSWARM STRAYING line. 0 turns straying warnings off.\"}","{\"section\":\"devswarm\",\"key\":\"burnTokensWarn\",\"type\":\"number\",\"default\":2000000,\"advanced\":true,\"description\":\"Token-burn straying warning: a child with a step plan that spends more than this many weighted tokens (input + output + cache writes + burnCacheReadPct% x cache reads, read incrementally from its own session transcript) since its last step progress gets one `burn` warning (\\\"used 2.1M tokens since step 3 last moved\\\"). Default 2M: with the 10% cache-read weight, one model call at a 150k-token cached context costs ~17k weighted tokens, so 2M is roughly 100+ calls with no step moving. 0 turns the burn signal off.\"}","{\"section\":\"devswarm\",\"key\":\"burnCacheReadPct\",\"type\":\"number\",\"default\":10,\"advanced\":true,\"description\":\"Weight of cache-read tokens in the token-burn figure, in percent (0-100). Default 10 mirrors prompt-cache pricing, where a cache read bills at a tenth of the base input rate; 100 counts every cached token in full.\"}","{\"section\":\"devswarm\",\"key\":\"respawnGraceMin\",\"type\":\"number\",\"default\":20,\"advanced\":true,\"description\":\"Minutes after a `correct` warning (the plan's warned_at) before the Primary may run `ah-engine mesh respawn <id>`. Respawn is never automatic and refuses without a warning.\"}","{\"section\":\"devswarm\",\"key\":\"respawnWipWaitSec\",\"type\":\"number\",\"default\":120,\"advanced\":true,\"description\":\"Seconds `respawn` waits for the child to commit and push its WIP after being asked; whatever is still dirty or unpushed is then parked on a new pushed park/<branch>-<ts> branch.\"}","{\"section\":\"devswarm\",\"key\":\"archivedChildStop\",\"type\":\"boolean\",\"default\":true,\"description\":\"An archived child workspace can never re-register its descriptor and is told once to save a handover and stop, instead of being nagged to heartbeat forever. false reverts to pre-fix behaviour (descriptor rewritten every turn, normal heartbeat-report forcing).\"}","{\"section\":\"devswarm\",\"key\":\"maintainerNotice.post\",\"type\":\"boolean\",\"default\":false,\"locked\":true,\"safetyNote\":\"this checkout would be allowed to post a maintainer notice that every project's Primary sees — the checkout-name check is a mistake guard, not authentication, so only turn this on in the anti-hall dev checkout\",\"description\":\"SAFETY (confirm to change — see settings.js set/reset). Allow `ah-engine mesh notice --post` from THIS checkout; also requires the checkout's own plugins/anti-hall/.claude-plugin/plugin.json to have name \\\"anti-hall\\\" (a mistake guard, not authentication). Off refuses every post regardless of the checkout.\"}","{\"section\":\"devswarm\",\"key\":\"maintainerNotice.show\",\"type\":\"boolean\",\"default\":true,\"description\":\"Show unseen maintainer notices to a Primary. Off suppresses the surface only — posting/listing via the CLI is unaffected.\"}","{\"section\":\"devswarm\",\"key\":\"startupSampling\",\"type\":\"boolean\",\"default\":true,\"description\":\"Supervisor reconcile sweep: opportunistically probe `hivecontrol workspace info <id>` (read-only, bounded, 3s timeout) for stale/not-draining rows and log a non-null startup field or a terminalId change to ~/.anti-hall/logs/devswarm-startup-samples.ndjson — pure data capture toward designing paused-workspace detection.\"}","{\"section\":\"devswarm\",\"key\":\"pausedProbeMax\",\"type\":\"number\",\"default\":8,\"advanced\":true,\"description\":\"Max `hivecontrol workspace info` probes per supervisor sweep tick for the startup-state sampler above.\"}","{\"section\":\"statusline\",\"key\":\"base\",\"type\":\"string\",\"default\":\"\",\"description\":\"Shell command run as the line-1 base in consolidated statusline mode.\"}","{\"section\":\"statusline\",\"key\":\"noEmail\",\"type\":\"boolean\",\"default\":false,\"description\":\"Suppress the email segment in the statusline.\"}","{\"section\":\"statusline\",\"key\":\"usage\",\"type\":\"boolean\",\"default\":true,\"description\":\"Show the weekly and 5-hour usage percentages (wk:65% | 5h:50%) before the context percentage in the statusline.\"}","{\"section\":\"statusline\",\"key\":\"version\",\"type\":\"boolean\",\"default\":true,\"description\":\"Show the AH version chip (AH: V<plugin>/V<engine>) at the end of the statusline.\"}","{\"section\":\"codexNudge\",\"key\":\"enabled\",\"type\":\"boolean\",\"default\":true,\"description\":\"Enable the Codex hand-off nudge hook.\"}","{\"section\":\"codexNudge\",\"key\":\"min\",\"type\":\"number\",\"default\":3,\"advanced\":true,\"description\":\"Minimum substantial code-file edits before the nudge fires.\"}","{\"section\":\"procwatch\",\"key\":\"enabled\",\"type\":\"boolean\",\"default\":true,\"description\":\"procwatch (scheduled sweep + SessionStart/UserPromptSubmit/PreToolUse advisory): look for processes a Claude session left behind (marked by the environment Claude Code sets, owner session gone, class pattern, minimum age) and for agents with no output. Never touches a live session, an unmarked process or a system process.\"}","{\"section\":\"procwatch\",\"key\":\"devServerMode\",\"type\":\"enum\",\"default\":\"report\",\"description\":\"dev_server class of the process watch: dev servers and watchers an agent started. off | report (list only, the default) | kill (stop them one pid at a time after a grace period).\"}","{\"section\":\"procwatch\",\"key\":\"testRunnerMode\",\"type\":\"enum\",\"default\":\"report\",\"description\":\"test_runner class of the process watch: test runners and their children. off | report (list only, the default) | kill (stop them one pid at a time after a grace period).\"}","{\"section\":\"procwatch\",\"key\":\"buildDaemonMode\",\"type\":\"enum\",\"default\":\"report\",\"advanced\":true,\"description\":\"build_daemon class of the process watch: build tool daemons. off | report (list only, the default) | kill (stop them one pid at a time after a grace period).\"}","{\"section\":\"procwatch\",\"key\":\"mcpServerMode\",\"type\":\"enum\",\"default\":\"report\",\"advanced\":true,\"description\":\"mcp_server class of the process watch: MCP servers of ended sessions (the SessionEnd reaper, maintenance.sessionEndReaper, is separate). off | report (list only, the default) | kill (stop them one pid at a time after a grace period).\"}","{\"section\":\"procwatch\",\"key\":\"shellTaskMode\",\"type\":\"enum\",\"default\":\"report\",\"advanced\":true,\"description\":\"shell_task class of the process watch: background shell commands of ended sessions. off | report (list only, the default) | kill (stop them one pid at a time after a grace period).\"}","{\"section\":\"procwatch\",\"key\":\"otherMode\",\"type\":\"enum\",\"default\":\"report\",\"advanced\":true,\"description\":\"other (catch-all) class of the process watch: any other process a Claude session started and left behind, oldest first. off | report (list only, the default) | kill (stop them one pid at a time after a grace period).\"}","{\"section\":\"procwatch\",\"key\":\"stuckMinutes\",\"type\":\"number\",\"default\":20,\"description\":\"Minutes without output after which a background agent of this session is named in a stuck-agent advisory (UserPromptSubmit; warn only, once per cooldown). Reuses the silent-agent-nudge detection.\"}","{\"section\":\"resourceWatch\",\"key\":\"enabled\",\"type\":\"boolean\",\"default\":true,\"description\":\"resource-watch: sample the processes under live Claude sessions each sweep and warn the session (advisory only).\"}","{\"section\":\"resourceWatch\",\"key\":\"cpuPercent\",\"type\":\"number\",\"default\":90,\"description\":\"Per-core CPU percent (100 = one core busy; a multi-threaded process can exceed it) every sample of the window must reach.\"}","{\"section\":\"resourceWatch\",\"key\":\"cpuWindowSeconds\",\"type\":\"number\",\"default\":120,\"advanced\":true,\"description\":\"Seconds the CPU reading must hold.\"}","{\"section\":\"resourceWatch\",\"key\":\"memoryMb\",\"type\":\"number\",\"default\":4096,\"description\":\"Memory in MB (resident set on Linux, physical footprint on macOS) at which a process of a live session is named.\"}","{\"section\":\"resourceWatch\",\"key\":\"swapMb\",\"type\":\"number\",\"default\":8192,\"advanced\":true,\"description\":\"System swap in use, MB, that triggers a warning; 0 = off.\"}","{\"section\":\"resourceWatch\",\"key\":\"freeRamOkPercent\",\"type\":\"number\",\"default\":20,\"advanced\":true,\"description\":\"Free RAM percent at or above which swap in use is not an alarm; 0 = swap alone decides.\"}","{\"section\":\"resourceWatch\",\"key\":\"pressurePercent\",\"type\":\"number\",\"default\":25,\"advanced\":true,\"description\":\"Linux memory pressure (PSI some avg10, percent) that triggers a warning; 0 = off.\"}","{\"section\":\"resourceWatch\",\"key\":\"macPressureLevel\",\"type\":\"number\",\"default\":2,\"advanced\":true,\"description\":\"macOS memory pressure level (2 warn, 4 critical) that triggers a warning; 0 = off.\"}","{\"section\":\"resourceWatch\",\"key\":\"cooldownSeconds\",\"type\":\"number\",\"default\":900,\"advanced\":true,\"description\":\"Least seconds before the same process (or system warning) is named again.\"}","{\"section\":\"resourceWatch\",\"key\":\"renice\",\"type\":\"boolean\",\"default\":false,\"description\":\"Opt-in: lower the priority (nice 10) of a process the watch warned about, once. Off by default; the watch never kills.\"}","{\"section\":\"diskWatch\",\"key\":\"enabled\",\"type\":\"boolean\",\"default\":true,\"description\":\"disk-watch: warn (SessionStart/UserPromptSubmit) when the project, HOME or temp volume is below the warn floor, and before heavy commands (PreToolUse) at the critical floor; names the biggest build/cache directories as a suggestion.\"}","{\"section\":\"diskWatch\",\"key\":\"warnGb\",\"type\":\"number\",\"default\":20,\"description\":\"Warn below this many GB free (0 = not used).\"}","{\"section\":\"diskWatch\",\"key\":\"warnPercent\",\"type\":\"number\",\"default\":10,\"advanced\":true,\"description\":\"Warn below this percent free (0 = not used).\"}","{\"section\":\"diskWatch\",\"key\":\"criticalGb\",\"type\":\"number\",\"default\":5,\"description\":\"Critical below this many GB free (0 = not used).\"}","{\"section\":\"diskWatch\",\"key\":\"criticalPercent\",\"type\":\"number\",\"default\":3,\"advanced\":true,\"description\":\"Critical below this percent free (0 = not used).\"}","{\"section\":\"diskWatch\",\"key\":\"cooldownSeconds\",\"type\":\"number\",\"default\":1800,\"advanced\":true,\"description\":\"Least seconds before the same level is warned about again (a worse level always is).\"}","{\"section\":\"diskWatch\",\"key\":\"blockAtCritical\",\"type\":\"boolean\",\"default\":false,\"description\":\"Opt-in: at the critical level, block heavy commands (builds, clones, worktree add) instead of only warning. Off by default.\"}","{\"section\":\"engine\",\"key\":\"bootstrap\",\"type\":\"boolean\",\"default\":false,\"description\":\"Download and install the sha256-pinned ah-engine and ah-hook binaries from the GitHub Release automatically at session start (once per pinned release). Opt-in, off by default: nothing is downloaded on its own, the setup skill (/anti-hall:activate) installs them on request, and until then the hooks pass through. AH_ENGINE_BOOTSTRAP=0/1 overrides this key.\"}","{\"section\":\"engine\",\"key\":\"autoUpdate\",\"type\":\"enum\",\"default\":\"off\",\"description\":\"Update the engine binary on its own, at most once a day: off (default), stable (latest ah-engine-v* release) or dev (latest dev pre-release, which also syncs the plugin files of a live kit). Runs `ah-engine update --auto` from the engine scheduler; verifies SHA256SUMS and the GitHub attestation; the previous binary is kept (`ah-engine update --rollback`). One-shot: `ah-engine update --from FILE | --channel stable|dev | --rollback`. URLs and timeouts: the `updater.*` keys of engine/defaults/engine.toml.\"}","{\"section\":\"defects\",\"key\":\"defaultProj\",\"type\":\"string\",\"default\":\"\",\"description\":\"Default project tag used when filing an anti-hall defect (max 64 chars).\"}"]}
settings_cli.not_toggleable	{"v":["{\"name\":\"skip-guard\",\"reason\":\"the user-consent escape hatch (~/.anti-hall/skip.json) every guard reads; not a feature, it is how a human pauses one.\"}","{\"name\":\"coordinator-detect\",\"reason\":\"shared library that tells coordinator from subagent for command-guard / edit-guard; not a hook.\"}","{\"name\":\"omc-detect\",\"reason\":\"shared library that lets task-guard / tasklist-guard defer to an active OMC loop; turning it off would deadlock those guards against the loop.\"}","{\"name\":\"phase-tracker\",\"reason\":\"never blocks or injects; records spawns that the statusline phase bar reads. Off would only break the statusline.\"}","{\"name\":\"fable-availability\",\"reason\":\"records whether a Fable model exists for model routing and skills; injects a SessionStart context note and has no other output.\"}","{\"name\":\"codex-availability\",\"reason\":\"records whether the codex CLI is on PATH for routing and skills; injects a SessionStart context note and has no other output.\"}","{\"name\":\"emit-dedupe-reset\",\"reason\":\"resets the emit-dedupe state after a context loss; off would hide DevSwarm blocks the model no longer holds. Use guards.emitDedupe instead.\"}","{\"name\":\"agent-watchdog\",\"reason\":\"a manual helper script, not a registered hook; it only runs when you call it.\"}","{\"name\":\"command-guard data-safety sub-guards\",\"reason\":\"DevSwarm read/send/subagent-mailbox guards prevent inbox cursor loss; they keep their own per-guard skip.json names. The stash guard is armed by guards.stashGuard.\"}"]}
settings_cli.sections	{"v":["{\"key\":\"autoHandover\",\"label\":\"Auto Handover\",\"description\":\"Automatic session-handover writing as context fills up.\"}","{\"key\":\"guards\",\"label\":\"Guards\",\"description\":\"On/off switches and tuning for the always-on safety guard hooks.\"}","{\"key\":\"safety\",\"label\":\"Safety Guards\",\"description\":\"Switches for the safety-critical guards (force-push / AI self-credit / heavy-command and edit delegation / runaway spawns). Normal precedence applies (env > ~/.anti-hall/settings.json > /config > default): a value in settings.json counts like any other. `settings.js set` to the risky value, and a `reset` whose fallback value is risky, need `--confirmed` (a human direct command, or the user saying yes after a one-line factual warning); re-arming a guard never does. Off = the guard's core check no-ops; the per-guard skip.json escape hatch is unchanged.\"}","{\"key\":\"context\",\"label\":\"Context Injections\",\"description\":\"The verify-first protocol and the other text anti-hall injects at session start, per turn, and into subagents.\"}","{\"key\":\"maintenance\",\"label\":\"Maintenance\",\"description\":\"Background housekeeping hooks: self-repair, pruning, snapshots, logs, and the session-end MCP sweep.\"}","{\"key\":\"agents\",\"label\":\"Agent tracker\",\"description\":\"The engine-side agent tracker: follows every agent, raises hung / looping / token-waste / drift / stale-heartbeat / no-wake-path signals, and reminds. It never stops an agent.\"}","{\"key\":\"versionAlerts\",\"label\":\"Version Alerts\",\"description\":\"Update-available nudges for anti-hall, Claude CLI, and DevSwarm.\"}","{\"key\":\"updates\",\"label\":\"Updates / Maintenance\",\"description\":\"`/anti-hall:update` and its background sweep.\"}","{\"key\":\"limitConserve\",\"label\":\"Limit Conservation\",\"description\":\"Auto-downshift behavior as usage approaches plan limits.\"}","{\"key\":\"jev\",\"label\":\"Jev (semantic decision engine)\",\"description\":\"Opt-in Jev \\\"System One\\\" classifier for triage/decisions.\"}","{\"key\":\"jevCascade\",\"label\":\"Jev cascade\",\"description\":\"Per-integration switch of the Jev-first cascade: when Jev answers below the integration's escalation threshold (engine/defaults/judge.toml, default = its act threshold) the answer is re-judged by the model, shown Jev's answer unless jev.cascadeShowJevAnswer is off. A hook-blocking decision never waits: Jev's answer applies now and the re-judged one from the next turn. Off by default = today's behaviour.\"}","{\"key\":\"jevIntegrations\",\"label\":\"Jev integration\",\"description\":\"Per-integration trust mode for every Jev-assisted decision point (v0.108.4 — each of the 13 integrations gets its own row/setting; postHandoverGate added in 0.109.0; the five devswarm* supervision integrations in 0.117.0; legacy home: jev.json \\\"integrations.<id>\\\" and, pre-0.108.4, settings.json jev[\\\"integrations.<id>\\\"]). on = Jev may change the outcome (bounded by its own trust rule below), shadow = consulted + logged only, off = not consulted.\"}","{\"key\":\"devswarm\",\"label\":\"DevSwarm\",\"description\":\"Multi-workspace mesh orchestration, liveness, and supervisor tuning. Every consumer takes an explicit env parameter (for testability); settings.js routes these through getWithEnv() so a home derived from that SAME env is used, never os.homedir().\"}","{\"key\":\"statusline\",\"label\":\"Statusline\",\"description\":\"Legacy statusline cleanup/render settings kept for older installs.\"}","{\"key\":\"codexNudge\",\"label\":\"Codex Nudge\",\"description\":\"Hand-off nudge suggesting Codex for review/diagnosis.\"}","{\"key\":\"procwatch\",\"label\":\"Process watch\",\"description\":\"Leftover processes of ended Claude sessions (report by default; kill is a per-class opt-in), and agents silent past a threshold. Warns only, never stops an agent. Needs the ah-engine.\"}","{\"key\":\"resourceWatch\",\"label\":\"Resource watch\",\"description\":\"Soft warning when processes of a live Claude session use too much CPU or memory, or the system swaps. Never kills or throttles by default.\"}","{\"key\":\"diskWatch\",\"label\":\"Disk watch\",\"description\":\"Soft warning when the volumes Claude sessions write to run low on free space. Never deletes anything.\"}","{\"key\":\"engine\",\"label\":\"Engine\",\"description\":\"The optional ah-engine binary (native hook answers).\"}","{\"key\":\"defects\",\"label\":\"Defects\",\"description\":\"The two-way defect-reporting channel.\"}"]}
