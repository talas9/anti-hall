devswarm_cli.msg_primary_takeover_no_session	{"v":"primary takeover needs this session's id (CLAUDE_CODE_SESSION_ID or --session)"}
devswarm_cli.msg_primary_unknown_sub	{"v":"primary: unknown subcommand {sub} (status|takeover)"}
devswarm_cli.msg_promoted	{"v":"workspace {id} promoted from {marker} to a real session id"}
devswarm_cli.msg_ra_db_unreadable	{"v":"DevSwarm app database unreadable (set ANTIHALL_DEVSWARM_APP_DB to its devswarm.db) — nothing is archived without app proof"}
devswarm_cli.msg_ra_dry_note	{"v":"dry-run: pass --yes (or --confirm) to archive these workspaces (only app-archived ones are candidates)"}
devswarm_cli.msg_ra_empty	{"v":"reconcile-active requires a non-empty --active <id,...> set (pass --allow-empty to archive ALL current workspaces)"}
devswarm_cli.msg_read_arg_ambiguous	{"v":"inbox {verb} {id} is ambiguous between candidate rows {candidates} — address one by its exact registry id"}
devswarm_cli.msg_read_primary_refused	{"v":"{verb} refused ({cause}): it drains {id}; use `inbox peek-primary {rid}` for a non-mutating view, or --ack-as-owner to override"}
devswarm_cli.msg_ready_fetch_failed	{"v":"ready-check --fetch: git fetch did not finish cleanly, the checks read the refs that exist"}
devswarm_cli.msg_ready_usage	{"v":"usage: ah-engine mesh ready-check <sha> [--base <ref>] [--allow glob,glob] [--watch-deletions dir,dir] [--fetch]"}
devswarm_cli.msg_reap_applied	{"v":"unread rows were archived + verified under {dir} and each partition retired by advancing its cursor; NO message rows were deleted"}
devswarm_cli.msg_reap_automation	{"v":"refusing to --apply with ANTIHALL_DEVSWARM_AUTOMATION=1 set: retiring a partition is a human decision, never a scheduled sweep. Run it yourself from an interactive shell."}
devswarm_cli.msg_reap_bad_max	{"v":"--max must be a positive integer (got {got})"}
devswarm_cli.msg_reap_cursor_import	{"v":"the partition's reader cursors could not be settled this pass (its legacy read positions could not be classified); its unread mail was archived and nothing was retired — the next pass retries"}
devswarm_cli.msg_reap_dry_run	{"v":"DRY RUN — nothing was changed. To act, re-run with `--apply --max N` (N = the most partitions this pass may retire). Each retired partition's unread rows are archived to {dir}/<partitionId>.ndjson and verified BEFORE its cursor is advanced; no message row is deleted."}
devswarm_cli.msg_reap_max_required	{"v":"--apply requires --max N (the maximum number of partitions this pass may retire). There is deliberately no unbounded apply."}
devswarm_cli.msg_reap_no_project	{"v":"reap-orphans must run inside a git worktree (the mesh store is per-project)"}
devswarm_cli.msg_reap_non_interactive	{"v":"refusing to --apply from a non-interactive stdin (cron/pipeline/subagent shape). If a human really is driving this, pass --i-am-a-human as well."}
devswarm_cli.msg_reap_none	{"v":"no orphaned partitions with unread mail in this project"}
devswarm_cli.msg_reap_stale_note	{"v":"dry-run: pass --yes (or --confirm) to archive these workspaces"}
devswarm_cli.msg_reg_app_archived	{"v":"workspace {id} is archived in the DevSwarm app (isActive=0, isHidden=1); registration is refused regardless of any local marker or heartbeat — the app DB is ground truth over anti-hall's own markers (owner rule). A live session is still running in this archived workspace: close its DevSwarm tab, or run `hivecontrol workspace archive <full id>`, to stop it retrying."}
devswarm_cli.msg_reg_archived_ambiguous	{"v":"an archived record for id {id} exists but same-workspace-vs-new could not be determined (missing worktree info); allowing (fail-open) — verify manually"}
devswarm_cli.msg_reg_archived_other	{"v":"an archived record for id {id} exists from a different worktree ({path}); treating this as a new workspace, not a resurrection"}
