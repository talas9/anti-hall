codex_handover.avail_context_codex	{"v":"Codex binary detected on PATH (per a SessionStart PATH probe). This is NECESSARY BUT NOT SUFFICIENT -- it does NOT prove Codex is authenticated or functional, only that a spawn is worth ATTEMPTING. If a nested Codex run fails or returns nothing, fall back one gpt tier down for that seat -- that check is still the real backstop no matter what this probe says. Coordinators should read ~/.anti-hall/codex-availability.json instead of re-probing."}
codex_handover.avail_event	{"v":"SessionStart"}
codex_handover.avail_guard	{"v":"codex-availability"}
codex_handover.avail_instead	{"v":"use Codex for correctness review."}
codex_handover.avail_note_instead	{"v":"route correctness review to {tier} until then."}
codex_handover.avail_note_what	{"v":"Codex unavailable until {until} ({reason})."}
codex_handover.avail_source	{"v":"path-probe"}
codex_handover.avail_summary	{"v":"SessionStart: probes PATH for a real codex executable, records it, folds a Codex job-log usage-limit error into the quota record and tells the session."}
codex_handover.avail_tier_claude	{"v":"Sonnet"}
codex_handover.avail_tier_codex	{"v":"a lower gpt tier"}
