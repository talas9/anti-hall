lane_test.nextest_run_words	{"v":["run","r"]}
lane_test.policy_none	{"v":"none"}
lane_test.policy_runners	{"v":[{"label":"cargo test","re":"^(?:\\S*/)?cargo\\s(?:\\+\\S+\\s)?(?:test|t)(?:\\s|$)"},{"label":"cargo nextest","re":"^(?:\\S*/)?(?:cargo\\s(?:\\+\\S+\\s)?nextest|cargo-nextest|nextest)(?:\\s|$)"},{"label":"node --test","re":"^(?:node|nodejs)\\s(?:\\S+\\s)*--test(?:\\s|$)"},{"label":"npm test","re":"^(?:npm|pnpm|yarn|bun)\\s(?:run\\s)?(?:test|test:\\S+)(?:\\s|$)"},{"label":"pytest","re":"^(?:python3?\\s-m\\s)?pytest(?:\\s|$)"},{"label":"vitest","re":"^(?:(?:npx|bunx|pnpm\\sexec|pnpm\\sdlx|yarn)\\s)?vitest(?:\\s|$)"},{"label":"jest","re":"^(?:(?:npx|bunx|pnpm\\sexec|pnpm\\sdlx|yarn)\\s)?jest(?:\\s|$)"},{"label":"go test","re":"^go\\stest(?:\\s|$)"},{"label":"ctest","re":"^ctest(?:\\s|$)"},{"label":"mvn test","re":"^(?:\\S*/)?(?:mvn|mvnw)\\s(?:\\S+\\s)*?test(?:\\s|$)"},{"label":"gradle test","re":"^(?:\\S*/)?(?:gradle|gradlew)\\s(?:\\S+\\s)*?test(?:\\s|$)"},{"label":"flutter test","re":"^flutter\\stest(?:\\s|$)"},{"label":"dart test","re":"^dart\\stest(?:\\s|$)"},{"label":"swift test","re":"^swift\\stest(?:\\s|$)"},{"label":"test.sh","re":"^(?:\\S*/)?test\\.sh(?:\\s|$)"},{"label":"xcodebuild test","re":"^xcodebuild\\s(?:\\S+\\s)*?test(?:\\s|$)"}]}
lane_test.policy_suites	{"v":"suites"}
lane_test.rules	{"v":[{"id":"node-test","label":"node --test","re":"^(?:node|nodejs)\\s(?:\\S+\\s)*--test(?:\\s|$)","unless_re":"\\.(?:[cm]?js|ts|mts|cts)(?:\\s|$)"},{"id":"npm-test","label":"npm test","re":"^(?:npm|pnpm|yarn|bun)\\s(?:run\\s)?(?:test|test:\\S+)(?:\\s|$)"},{"id":"test-sh","label":"test.sh","re":"^(?:\\S*/)?test\\.sh(?:\\s|$)"},{"id":"make-test","label":"make test","re":"^make\\s(?:\\S+\\s)*?(?:test|tests|check|gate|replay|soak)(?:\\s|$)"},{"id":"pytest","label":"pytest","re":"^(?:python3?\\s-m\\s)?pytest(?:\\s|$)","unless_re":"(?:\\.py|::)\\S*(?:\\s|$)"},{"id":"flutter-test","label":"flutter test","re":"^flutter\\stest(?:\\s|$)","unless_re":"\\.dart(?:\\s|$)"},{"id":"replay-soak","label":"replay or soak runner","re":"^(?:\\S*/)?(?:[\\w.-]*[-_.])?(?:replay|soak)(?:[-_.][\\w.-]*)?(?:\\s|$)"}]}
lane_test.summary	{"v":"PreToolUse on Bash, subagents only: blocks suite-scale test commands (cargo test or nextest without a narrowing filter, --workspace, node --test without a file, test.sh, replay and soak runners) unless guards.allowTestSuites is on; cargo check and a filtered single-module test stay allowed. With guards.testPolicy = none it blocks EVERY test-runner command from a subagent (and the main session when guards.testPolicyMainThread is on)."}
