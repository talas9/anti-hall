session.unregistered_what	{"v":"v{mirrored} is downloaded but not registered in Claude."}
session.unregistered_why	{"v":"A reload alone will not pick it up until the harness registers it."}
session.update_instead	{"v":"run the anti-hall update skill for your host."}
session.update_what	{"v":"v{latest} is available (you are running v{running})."}
