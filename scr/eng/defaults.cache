session.prune_throttle_ms	{"n":1000,"v":86400000}
session.quote_prefix	{"v":"> "}
session.registry_file	{"v":"installed_plugins.json"}
session.registry_key	{"v":"anti-hall@anti-hall"}
session.registry_max_bytes	{"n":1024,"v":4194304}
session.reload_instead	{"v":"reload plugins in Claude or restart Codex."}
session.reload_instead_ahead	{"v":"reload plugins in Claude or restart Codex."}
session.reload_mark_file	{"v":".anti-hall/version-alert-reload.json"}
session.reload_what	{"v":"v{mirrored} is already downloaded (you are running v{running})."}
