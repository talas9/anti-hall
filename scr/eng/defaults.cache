api_guard_v1.msg_timeout	{"v":"anti-hall api-guard: API verification skipped (probe for \"{bin}\" timed out after {ms}ms budget) — edit allowed unchecked."}
api_guard_v1.msg_what	{"v":"this edit references APIs missing from the installed runtime."}
