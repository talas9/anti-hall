git_audit.reflog_skip	{"v":["^[a-z -]*\\((?:start|finish|abort)\\)",": fast-forward$"]}
git_audit.summary	{"v":"Block after a Bash call: a commit git wrote in the last 15 minutes (reflog) carries an AI self-credit; one HEAD reaches and no remote has is blocked until reworded, one a remote already has (committed and pushed in one call) is blocked once and reported as published."}
git_audit.timeout_ms	{"v":4000}
git_audit.window_s	{"n":1,"v":900,"x":86400}
