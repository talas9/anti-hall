devswarm_role.pg_q_sig_row_sep	{"v":31}
devswarm_role.pg_q_truncated	{"v":"PENDING QUESTIONS LIST TRUNCATED — {kept} sender(s) shown, {dropped} more sender(s) with an unanswered question are NOT shown (cap {cap}). The true unanswered count is HIGHER than what this message can list. This is not resolvable by replying to only the senders named below — check `~/.anti-hall/ah-engine/bin/ah-engine mesh inbox read-primary` (read-only; its `ackCommand` acks) / registry state directly. "}
devswarm_role.pg_q_truncated_unknown	{"v":"?"}
devswarm_role.pg_q_unanswered	{"v":"UNANSWERED QUESTION{s} — {items}{more}: reading it via `inbox read-primary` (and running its `ackCommand`) is NOT sufficient to clear this. You must DECIDE from context and REPLY: `send --to <id> --message-file <path>` (or --message-stdin). "}
