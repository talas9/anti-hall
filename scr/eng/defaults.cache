model_routing.strong_write_re	{"v":"\\bgh\\s+(?:issue|label|pr|release|secret|repo|milestone)\\s+(?:create|edit|comment|close|merge|delete|set|reopen)\\b|\\bgh\\s+api\\b[^\\n]{0,200}?(?:-X|--method)[\\s=]*(?:POST|PATCH|PUT|DELETE)\\b|\\bcommit(?:s|ting)?\\s+(?:(?:the|all|its|your|each|every|those|these|any)\\s+)?(?:files?|changes?|fix(?:es)?|work|results?|edits?|patch(?:es)?)\\b|\\bpush(?:es|ing)?\\s+(?:it|them|the\\s+\\w+|to\\s+\\S+|your\\s+\\w+|its\\s+\\w+|branch\\w*)\\b|\\b(?:and|then)\\s+push(?:es)?\\b|\\bcreat(?:e|es|ing)\\s+(?:(?:a|an|the|new|any|its|missing|all|\\d+)\\s+)?(?:gh\\s+|github\\s+)?(?:issues?|labels?|milestones?|pull\\s+requests?|prs?|branch(?:es)?|commits?|files?|tests?)\\b|\\blabel(?:s|ling)?\\s+(?:(?:the|each|all|every|its)\\s+)?(?:issues?|prs?|pull\\s+requests?)\\b|\\b(?:edit|write|modify|update)s?\\s+(?:(?:the|a|its|your|this|that|these|those)\\s+)?(?:files?|code|tests?|source|config)\\b|\\b(?:edit|write|modify)s?\\s+\\S+\\.(?:js|ts|rs|toml|md|json|py|sh|ya?ml)\\b"}
