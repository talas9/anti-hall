msg.updater_selftest_ok	{"v":"launcher self-test: ok ({launcher})"}
msg.updater_selftest_rejected	{"v":"the launcher self-test rejected the new engine (exit {code}; see the line above)\n{unchanged}; {bin} was not replaced\nrun '{launcher} --selftest --engine <the engine>' by hand to see which check fails, or try the other channel (ah-hook update --channel {stable})"}
