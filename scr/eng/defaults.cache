git.msg_commit_expansion	{"v":{"instead":"write the message literally in the -m argument (or a heredoc) and commit again.","what":"the commit message holds a shell expansion ({shown}).","why":"The guard reads the command text, so a credit line behind a variable or substitution cannot be checked."}}
git.msg_commit_file_credit	{"v":{"instead":"remove the Co-Authored-By line and commit again.","what":"commit message file has an AI co-author line.","why":"Commits in this setup carry no AI co-author line."}}
git.msg_commit_file_jev	{"v":{"instead":"remove the AI credit and commit again.","what":"commit message file credits an AI assistant.","why":"Commits in this setup carry no AI co-author line."}}
git.msg_commit_jev	{"v":{"instead":"remove the AI credit and commit again.","what":"commit message credits an AI assistant.","why":"Commits in this setup carry no AI co-author line."}}
git.msg_creating_credit	{"v":{"instead":"remove the Co-Authored-By line and commit again.","what":"git {sub} would create a commit with AI credit.","why":"Commits in this setup carry no AI co-author line, however it reaches git."}}
git.msg_creating_credit_elsewhere	{"v":{"instead":"remove the credit from the chained command.","what":"git {sub} is chained with text containing AI credit.","why":"The credit line is in the `{elsewhere}` part, not in the commit message."}}
git.msg_delete_ref	{"v":{"instead":"get the owner’s approval for this exact deletion.","override":"tell the agent \"skip git-guard\", only for this exact deletion.","what":"remote branch or tag deletion was stopped.","why":"Deleting published refs needs the owner's explicit OK."}}
git.msg_find_push	{"v":{"instead":"run git push directly with explicit arguments.","what":"find could supply hidden force-push arguments.","why":"find fills in the arguments, so a force push (`+ref`) can't be ruled out."}}
git.msg_force_push	{"v":{"instead":"push without rewriting published history.","what":"a force push was stopped.","why":"Rewriting published history should be a deliberate human decision."}}
git.msg_gh_credit	{"v":{"instead":"remove the credit line and retry.","what":"PR, issue or release text has an AI credit line.","why":"Pull requests and issues in this setup carry no AI credit."}}
git.msg_gh_credit_elsewhere	{"v":{"instead":"remove the credit from the chained command.","what":"chained command text has an AI credit line.","why":"The credit line is in the `{elsewhere}` part, not in the gh text; nothing here carries AI credit."}}
git.msg_gh_jev	{"v":{"instead":"remove the AI credit and retry.","what":"PR, issue or release text credits an AI assistant.","why":"Pull requests and issues in this setup carry no AI credit."}}
git.msg_handover	{"v":{"instead":"unstage the handover before committing.","override":"tell the agent \"skip git-guard\", only if you want this file committed.","what":"this commit includes a private session handover.","why":"Handovers are private session notes and are never committed."}}
git.msg_launcher	{"v":{"instead":"leave the launcher folder unchanged.","what":"a write to the managed launcher folder was stopped.","why":"anti-hall manages those files itself; overwriting one could run unwanted code under a trusted name."}}
git.msg_push_cmdsubst	{"v":{"instead":"use literal arguments for git push.","what":"command substitution could hide a force-push flag.","why":"It could hide a --force flag from the check."}}
git.msg_push_credit	{"v":{"instead":"reword them (git rebase -i {first}^, drop the credit lines) and push again.","what":"this push would publish commits with AI credit ({shown}).","why":"Commits in this setup carry no AI credit, and the guard never rewrites history for you."}}
git.msg_push_over_cap	{"v":{"instead":"check them yourself (git log --all --not --remotes), reword any with an AI credit, then push.","override":"turn off guards.gitPushCreditCheck for this push, only after you checked the range.","what":"more than {cap} local commits are on no remote, more than the credit check reads.","why":"A credit in a commit past the cap could not be ruled out, and the guard never allows what it did not read."}}
git.msg_push_same_call	{"v":{"instead":"split it: commit in one call, push in a separate call (the push is checked on what git stored).","what":"this call creates a commit whose message the guard cannot read (git {sub}) and pushes in the same call.","why":"A credit line in that message would be published before any check could see it, and a published commit cannot be reworded without a force push."}}
git.msg_reused_message	{"v":{"instead":"remove the credit and use an explicit commit message.","what":"reused commit message has an AI co-author line.","why":"Commits in this setup carry no AI co-author line, even when the message is reused."}}
git.msg_runner_no_subcommand	{"v":{"instead":"run git directly with explicit arguments.","what":"a runner hides the git subcommand beside an unsafe flag.","why":"{runner} supplies the subcommand later, so it could be a push with that flag."}}
git.msg_runner_placeholder	{"v":{"instead":"run git directly with explicit arguments.","what":"a runner hides the command beside a force or delete flag.","why":"The placeholder is filled in at run time, so the command could secretly be a git push."}}
git.msg_runner_push	{"v":{"instead":"run git push directly with explicit arguments.","what":"a runner could hide a force-push argument.","why":"{runner} adds words to the command, so a hidden --force can't be ruled out."}}
git.msg_trailer_remap	{"v":{"instead":"remove the trailer setting and commit again.","what":"a trailer setting adds AI credit.","why":"Commits in this setup carry no AI co-author line."}}
