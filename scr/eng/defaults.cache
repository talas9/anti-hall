dispatch.msg_fail_closed_stop	{"v":"anti-hall: the engine could not run the guards for {event} ({why}). The agent is held from finishing rather than let go unguarded; repair the install (`doctor --repair`) or retry (it is let finish after a few attempts)."}
dispatch.msg_fail_open_log	{"v":"{check} ({event}): no answer, not a safety guard: let through"}
dispatch.msg_hook_died	{"v":"the hook was killed by a signal or could not be waited for"}
dispatch.msg_hook_not_launched	{"v":"no hook command is launched; the built-in check did not answer"}
dispatch.msg_hook_spawn	{"v":"the hook's command could not be started: {errno} {err}"}
dispatch.msg_hook_timeout	{"v":"the hook ran past its timeout and was killed; the host discards a timed-out hook"}
dispatch.msg_no_fallback	{"v":"entry {id} deferred with no runnable Node command"}
dispatch.msg_no_node_event	{"v":"{path}: {why}"}
dispatch.msg_no_node_open	{"v":"anti-hall: the guards for {event} could not run ({why}); this call went through UNGUARDED. Run `ah-engine doctor`."}
dispatch.msg_no_node_skipped	{"v":"anti-hall: the {event} hooks were skipped ({why}); run `ah-engine doctor` if it keeps happening"}
dispatch.msg_no_row	{"v":"the dispatch table has no well-formed row for {host} {event}: the Node hooks decide"}
dispatch.msg_panic	{"v":"the dispatcher hit an internal error: the Node hooks decide"}
dispatch.msg_skipped_entry	{"v":"entry {id} skipped: no runnable Node command"}
dispatch.msg_skipped_entry_stderr	{"v":"anti-hall: skipped {event} Node hook {id}: no runnable Node command"}
dispatch.msg_spill_failed	{"v":"context spill file not written: {err}"}
