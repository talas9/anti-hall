dispatch.msg_spool_sweep	{"v":"removed {n} stale dispatch stdin spool file(s)"}
dispatch.msg_stdin_over_cap	{"v":"the hook payload is larger than {max} bytes; built-in checks are skipped and Node hooks receive the full payload from an anonymous spool file"}
dispatch.msg_stop_active	{"v":"anti-hall: the engine could not run the guards for {event} ({why}), and a Stop hook already held this turn, so the agent is let finish rather than looped. Repair the install (`doctor --repair`)."}
dispatch.msg_stop_capped	{"v":"anti-hall: the engine could not run the guards for {event} ({why}) {cap} times in a row, so the agent is let finish rather than looped. Repair the install (`doctor --repair`)."}
dispatch.msg_stop_uncounted	{"v":"anti-hall: the engine could not run the guards for {event} ({why}) and cannot count its blocks, so the agent is let finish rather than risk a loop. Repair the install (`doctor --repair`)."}
