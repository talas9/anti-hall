msg.updater_channel_latest	{"v":"channel {channel}: latest is {tag}; fetching {asset}"}
msg.updater_commit_note	{"v":"; commit {commit}"}
msg.updater_commit_paren	{"v":" (commit {commit})"}
msg.updater_differs_from_lock	{"v":"the checksum of {asset} differs from this plugin's ah-engine.lock ({lock})\n{unchanged}; the download was discarded\nupdate the plugin (claude plugin update anti-hall) so its lock matches the release, or use --channel dev; do not install a build that disagrees with the lock"}
msg.updater_dry_rb	{"v":"dry run: would restore {prev} (engine {version})"}
msg.updater_dry_rb_live	{"v":"dry run: would restore {prev} (engine {version}) and re-apply go-live"}
msg.updater_dry_run	{"v":"dry run: would install engine {version} from {label} (sha256 {sha}); nothing changed"}
msg.updater_empty	{"v":"the engine file is empty\n{unchanged}\nget the file again (it may have been cut off) and run again"}
msg.updater_extracted	{"v":"extracted: verified engine {version} from {label} (sha256 {sha}) written to {path}{commit_note}; nothing installed"}
msg.updater_fail_frame	{"v":"ah-update: {what}\n  state: {state}\n  next: {next}"}
msg.updater_git_archive	{"v":"cannot unpack {path} of commit {commit}\n{unchanged}\nrun again; if it repeats, install the engine alone: ah-hook update --channel {channel} --no-plugin"}
msg.updater_git_fetch	{"v":"cannot fetch the plugin files of commit {commit} from {url} (the git output is above)\n{unchanged}\ncheck the connection and run again, or install the engine alone: ah-hook update --channel {channel} --no-plugin"}
msg.updater_git_init	{"v":"git could not set up a scratch repository in {dir}\n{unchanged}\nfree some disk space or fix the permissions of {state}, then run again"}
msg.updater_help	{"v":"ah-hook update: move the local ah-engine binary (and the thin client, when the release ships it) to an offline file, the latest stable release or the latest dev pre-release.\n  --from FILE [--sha256 X] [--yes]   offline: FILE is a release .tar.gz or a bare binary. Expected sha256 = --sha256, else the SHA256SUMS next to FILE, else the plugin's ah-engine.lock; with none of them the sha is printed and --yes is required\n  --channel stable|dev               latest ah-engine-v* release / latest ah-engine-dev-<sha8> pre-release (dev also syncs the plugin files when the live kit is installed)\n  --rollback                         restore the previous binaries (bin/ah-engine.prev, bin/ah-hook.prev); run twice to toggle\n  --auto                             honour the engine.autoUpdate setting (off|stable|dev) and the daily limit\noptions: --check-release (print one JSON line about the latest release of the channel, change nothing)  --force (allow a downgrade)  --launcher FILE  --dry-run (verify and smoke-test, install nothing)  --extract-to PATH  --no-restart  --no-plugin  --live-select LIST  -v  --json (ignored)\nOnline sources are verified against the release SHA256SUMS and, when gh is installed and logged in, the GitHub build attestation. Steps: verify, smoke test (<new> version), launcher self-test, then the NEW engine's install routine (`ah-engine update --from-local`: rollback copy, install, settle, validate, automatic rollback on failure, cleanup, install record); the client installs by itself (atomic swap, previous kept as .prev) only when that routine cannot be started. Nothing is deleted; a failure at any step keeps the old binary.\nExit: 0 done / already current / nothing to do, 1 failed (old binary kept), 2 usage, 3 --yes needed."}
msg.updater_hook_auto_rolled_back	{"v":"ah-hook: the new thin client failed its self-test and was put back at once ({path})"}
msg.updater_hook_rb_skipped	{"v":"ah-hook: the previous thin client ({prev}) fails its self-test; left as it is"}
msg.updater_hook_rolled_back	{"v":"ah-hook: rolled back ({path})"}
msg.updater_hook_skipped	{"v":"ah-hook: not replaced ({path}); the engine was updated alone"}
msg.updater_hook_updated	{"v":"ah-hook: updated at {path} (the previous one is kept as .prev)"}
msg.updater_install_lock_held	{"v":"the engine install lock is held by another install or roll-back\n{unchanged}\nwait for it to finish, then run this again (its holder is in {log})"}
msg.updater_label_channel	{"v":"{channel} {tag}"}
msg.updater_label_file	{"v":"file {path}"}
msg.updater_launcher_not_exec	{"v":"the launcher {launcher} is not an executable file\n{unchanged}; {bin} was not replaced\npass the path of the ah-hook binary to --launcher, or leave the option out"}
msg.updater_live_cannot_aside	{"v":"cannot move the current bundle ({bundle}) aside\n{unchanged}\ncheck that you can write in {kit}, then run again"}
msg.updater_live_cannot_copy_cur_plugin	{"v":"cannot copy the current plugin files into {stage}\n{unchanged}; the half-built {stage} is left in place\nfree some disk space, then run again"}
msg.updater_live_cannot_copy_engine	{"v":"cannot copy the new engine into {stage}\n{unchanged}; the half-built {stage} is left in place\nfree some disk space, then run again"}
msg.updater_live_cannot_copy_plugin	{"v":"cannot copy the new plugin files into {stage}\n{unchanged}; the half-built {stage} is left in place\nfree some disk space, then run again"}
msg.updater_live_cannot_put	{"v":"cannot put the new bundle ({stage}) in place\nrolled back: the bundle that was current is back in place at {bundle}\ncheck that you can write in {kit}, then run again"}
msg.updater_live_cannot_stage	{"v":"cannot create {stage} in the live kit\n{unchanged}\ncheck that you can write in {kit}, then run again"}
msg.updater_live_current	{"v":"already current: the live kit bundle holds this exact engine{plugin} (sha256 {sha}); nothing to do"}
msg.updater_live_golive	{"v":"the live kit could not apply the new bundle (the go-live step exited with an error; its last lines are above)\nrolled back: the bundle that was current is back in place at {bundle}; the new one is kept as {failed}\nread the log (tail -n 30 {log}), fix what go-live reports, then run again; to re-apply the current bundle by hand, run the kit's go-live step again ({kit}, {select})"}
msg.updater_live_updated	{"v":"updated through the live kit: engine {version}{plugin_note}; previous bundle kept as {aside} (undo: ah-hook update --rollback)"}
msg.updater_no_asset	{"v":"cannot download {asset} ({tag} may not publish a build for {triple}, or the network dropped)\n{unchanged}\nretry later with ah-hook update --channel {channel}, or install a build you have: ah-hook update --from FILE"}
msg.updater_no_build	{"v":"no {channel} build is published yet (no release tagged '{prefix}...' among the latest {per_page} releases of {repo})\n{unchanged}\nretry after a build is published (a push to the engine branch publishes one), or use the other channel: ah-hook update --channel {other}"}
msg.updater_no_commit	{"v":"the pre-release {tag} does not record which plugin commit it was built from (no {commit_asset})\n{unchanged}\ninstall the engine alone: ah-hook update --channel {channel} --no-plugin"}
msg.updater_no_downloader	{"v":"neither curl nor wget is installed, so nothing can be downloaded\n{unchanged}\ninstall curl (or wget), or fetch the release yourself and use: ah-hook update --from FILE"}
msg.updater_no_expected	{"v":"no expected sha256 given (no --sha256, no SHA256SUMS next to the file, no lock entry for {name})"}
msg.updater_no_git	{"v":"git is not installed, and the live kit's plugin files are fetched with it\n{unchanged}\ninstall git, or install the engine alone: ah-hook update --channel {channel} --no-plugin"}
msg.updater_no_home	{"v":"ah-update: HOME is not set, so the engine directory cannot be found\n  state: nothing changed\n  next: run it with HOME set: HOME=/home/you ah-hook update <your arguments>"}
msg.updater_no_member	{"v":"the downloaded archive has no <dir>/ah-engine member\n{unchanged}\nthis file is not an engine release archive: pass the .tar.gz of an ah-engine release, or the bare binary, to --from"}
msg.updater_no_sums	{"v":"cannot download the checksum file {sums} of {tag} (the release may still be uploading, or the network dropped)\n{unchanged}\nwait a few minutes and run again: ah-hook update --channel {channel}"}
msg.updater_no_tar	{"v":"tar is not installed, and it is needed to unpack the plugin files\n{unchanged}\ninstall tar, then run again"}
msg.updater_plugin_fetched	{"v":"plugin: {commit} ({path}) fetched for the live kit"}
msg.updater_plugin_incomplete	{"v":"the plugin files of commit {commit} are incomplete (no engine/defaults/index.toml)\n{unchanged}\nwait for the next pre-release, or install the engine alone: ah-hook update --channel {channel} --no-plugin"}
msg.updater_plugin_not_synced	{"v":"plugin: not synced (the live kit is not installed). The dev engine reads its settings from the plugin: install the matching plugin files (install-shadow-remote.sh --live) or the engine may drift from them"}
msg.updater_plugin_note	{"v":", plugin {commit}"}
msg.updater_prev_note	{"v":"; previous kept as {bin}.prev (undo: ah-hook update --rollback)"}
msg.updater_provenance	{"v":"source: ah-update {label}{commit_note}\nengine: {version}\n{sha}  bundle/ah-engine\nupdated: {when}\n"}
msg.updater_rb_cannot_copy	{"v":"cannot copy {bin} aside to swap it with .prev\n{unchanged}\nfree some disk space or fix the permissions of {bindir}, then run ah-hook update --rollback again"}
msg.updater_rb_cannot_move	{"v":"cannot move {prev} into place as {bin}\nnothing was replaced: {bin} is as it was\nfix the permissions of {bindir}, then run ah-hook update --rollback again"}
msg.updater_rb_live_cannot_aside	{"v":"cannot move the current bundle ({bundle}) aside\n{unchanged}\ncheck that you can write in {kit}, then run ah-hook update --rollback again"}
msg.updater_rb_live_cannot_restore	{"v":"cannot restore {prev} as the live bundle\nrolled back: the bundle that was current is back in place at {bundle}\ncheck that you can write in {kit}, then run ah-hook update --rollback again"}
msg.updater_rb_live_golive	{"v":"the live kit could not re-apply the previous bundle (go-live.sh exited with an error; its last lines are above)\nrolled back: the bundle that was current is back in place at {bundle}; the previous one is kept as {failed}\nread the log (tail -n 30 {log}), fix what go-live reports, then run ah-hook update --rollback again; to re-apply the current bundle by hand, run the kit's go-live step again ({kit}, {select})"}
msg.updater_rb_live_none	{"v":"nothing to roll back to: there is no {kit}/bundle.pre-update-* from an earlier update\n{unchanged}\nupdate first (ah-hook update --channel stable, or dev); --rollback then has an earlier bundle to restore"}
msg.updater_rb_live_prev_broken	{"v":"the previous engine ({path}) does not run on this machine (see the smoke test line above)\n{unchanged}\ninstall a fresh build instead: ah-hook update --channel stable"}
msg.updater_rb_none	{"v":"nothing to roll back to: {prev} does not exist\n{unchanged}\nan update keeps the previous binary as .prev, so run one first (ah-hook update --channel stable), or install a known build: ah-hook update --from FILE"}
msg.updater_rb_prev_broken	{"v":"the previous binary ({prev}) does not run on this machine (see the smoke test line above)\n{unchanged}\ninstall a fresh build instead: ah-hook update --channel stable"}
msg.updater_restart_scheduled	{"v":"daemon: restart scheduled"}
msg.updater_restart_skipped	{"v":"daemon: restart skipped (--no-restart); the next hook call starts the new one"}
msg.updater_restart_unconfirmed	{"v":"daemon: started but not confirmed by 'status' yet; the next hook call starts it if needed"}
msg.updater_restarted	{"v":"daemon: restarted ({binary} serve)"}
msg.updater_rolled_back	{"v":"rolled back: {bin} is now engine {version} (the replaced binary is kept as .prev; --rollback again toggles)"}
msg.updater_rolled_back_live	{"v":"rolled back: live kit re-applied with the previous bundle (engine {version}); the replaced one is kept as {aside}"}
msg.updater_routine_scheduled	{"v":"install routine started in the background; its report is in {log}"}
