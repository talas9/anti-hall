{
  "_doc": "Tunables for community.yml, pr-check.yml, privacy-scan.yml and roadmap.yml. Rules decide; an optional model only adds research, text, or an escalation to human review. Edit here, not in the workflows.",
  "skip_logins": ["dependabot[bot]", "github-actions[bot]", "renovate[bot]"],
  "labels": {
    "review": "moderation:review",
    "needs_issue": "needs-issue",
    "stale_check": "status:stale-check",
    "triage": "status:triage",
    "private": "risk:private-data",
    "accepted": "status:accepted",
    "major_bump": "review:major-bump"
  },
  "participation": {
    "_doc": "Discussions and slash commands (community.yml). Maintainers = these author associations. A bot reply to one discussion is refreshed at most once per cooldown_hours.",
    "maintainer_associations": ["OWNER", "MEMBER", "COLLABORATOR"],
    "commands": ["triage", "explain", "convert"],
    "followup_categories": ["q-a"],
    "reply_categories": ["general", "show-and-tell"],
    "idea_category": "ideas",
    "announce_category": "announcements",
    "mention_regex": "(^|[^\\w])@(anti-hall|anti-hall-bot|github-actions)\\b",
    "question_regex": "\\?\\s*$|^(how|why|what|where|when|can|could|does|is|are|should|which)\\b",
    "cooldown_hours": 24,
    "explain_max_comments": 6,
    "explain_max_chars": 6000,
    "release_notes_max_chars": 3000,
    "docs_inspector": { "max_notes_chars": 6000, "max_files": 150, "max_items": 8, "issue_label": "area:docs" }
  },
  "moderation": {
    "spam_patterns": ["\\b(casino|betting|slot ?machines?|escort|viagra|cialis|porn)\\b", "\\b(crypto|bitcoin|forex) (signals?|investment|trading bot|recovery)\\b", "\\b(buy|cheap) (followers|likes|backlinks|reviews)\\b", "\\bseo (services|agency|backlinks)\\b", "\\b(loan|payday) (offer|approval|lender)\\b", "\\b(whats ?app|telegram)\\s*[:+]?\\s*\\+?\\d[\\d -]{7, }", "\\b(customer (care|support|service)) (number|helpline)\\b", "\\bairdrop\\b.*\\bclaim\\b"],
    "abusive_patterns": ["\\bkill (yo)?ur ?self\\b", "\\bkys\\b", "\\b(you|u) (are|r) (an? )?(idiot|moron|retard)s?\\b", "\\bf+u+c+k+ (you|off|this dev)\\b", "\\bi will (find|hurt|kill) you\\b"],
    "off_topic_patterns": ["\\b(write|do) my (essay|homework|assignment)\\b", "\\bhire me\\b", "\\b(dating|girlfriend|boyfriend) (site|app)\\b", "\\bjob (offer|opportunity) for you\\b"],
    "low_quality_comment_patterns": ["^\\s*(\\+1|same( here)?|bump|me too|any update\\??|following|subscribed?)\\s*[.!]*\\s*$"],
    "untrusted_associations": ["NONE", "FIRST_TIMER", "FIRST_TIME_CONTRIBUTOR"],
    "spam_max_foreign_links_untrusted": 3,
    "low_quality_min_body_chars": 30,
    "duplicate_title_similarity": 0.8,
    "hide_classifier": { "spam": "SPAM", "abusive": "ABUSE" }
  },
  "triage": {
    "types": ["type:bug", "type:feature", "type:docs", "type:chore"],
    "areas": ["area:engine", "area:devswarm", "area:hooks", "area:statusline", "area:codex", "area:ci", "area:docs", "area:release", "area:command-guard", "area:git-guard", "area:edit-guard", "area:agent-guards", "area:stop-guards"],
    "priorities": ["priority:P0", "priority:P1", "priority:P2", "priority:P3"],
    "sizes": ["size:S", "size:M", "size:L", "size:XL"],
    "type_keywords": {
      "type:bug": ["bug", "error", "crash", "fails", "failing", "broken", "regression", "exception", "stack trace", "blocked", "false positive", "wrong", "doesn't work", "does not work"],
      "type:docs": ["docs", "documentation", "readme", "typo", "guide", "wiki"],
      "type:feature": ["feature", "add support", "would be nice", "request", "proposal", "allow", "option to", "idea"],
      "type:chore": ["refactor", "cleanup", "ci", "dependency", "bump"]
    },
    "area_keywords": {
      "area:engine": ["ah-engine", "engine", "rust"],
      "area:devswarm": ["devswarm", "workspace", "hivecontrol", "mesh"],
      "area:hooks": ["hook", "hooks.json", "pretooluse", "posttooluse"],
      "area:statusline": ["statusline", "status line"],
      "area:codex": ["codex"],
      "area:ci": ["github actions", "workflow", "ci "],
      "area:docs": ["docs", "readme", "documentation"],
      "area:release": ["release", "changelog", "version"],
      "area:command-guard": ["command-guard", "scan-throttle"],
      "area:git-guard": ["git-guard", "merge-gate"],
      "area:edit-guard": ["edit-guard", "api-guard", "ship-it-guard"],
      "area:agent-guards": ["swarm-guard", "model-routing-guard", "phase-tracker"],
      "area:stop-guards": ["task-guard", "speculation-guard", "stop hook", "claim-ledger"]
    },
    "priority_keywords": {
      "priority:P0": ["security", "vulnerability", "data loss", "deletes", "bricks", "cannot start"],
      "priority:P1": ["regression", "blocks", "blocked all", "every session"]
    },
    "default_priority": {
      "type:bug": "priority:P2",
      "type:feature": "priority:P3",
      "type:docs": "priority:P3",
      "type:chore": "priority:P3"
    },
    "default_size": { "type:bug": "size:M", "type:feature": "size:M", "type:docs": "size:S", "type:chore": "size:S" },
    "size_hours": { "size:S": 2, "size:M": 6, "size:L": 16, "size:XL": 40 },
    "qa_category": "q-a",
    "qa_links": {
      "install": "https://github.com/talas9/anti-hall#readme",
      "guide": "https://github.com/talas9/anti-hall/blob/main/docs/GUIDE.md",
      "hook": "https://github.com/talas9/anti-hall/blob/main/docs/KB-claude-code-hooks.md",
      "codex": "https://github.com/talas9/anti-hall/blob/main/docs/KB-claude-codex.md",
      "devswarm": "https://github.com/talas9/anti-hall/blob/main/docs/KB-devswarm-hivecontrol.md",
      "jev": "https://github.com/talas9/anti-hall/blob/main/docs/KB-jev-classifier.md",
      "handover": "https://github.com/talas9/anti-hall/blob/main/docs/KB-session-handover.md",
      "wiki": "https://github.com/talas9/anti-hall/wiki"
    },
    "qa_max_links": 3,
    "research": {
      "categories": ["ideas", "q-a"],
      "min_body_chars": 80,
      "complete_form_max_body_chars": 400,
      "similar_limit": 10,
      "max_turns": 8,
      "web_search_types": ["type:feature"],
      "rerun_min_hours": 24
    },
    "milestones": {
      "v1.0": ["node removal", "remove node", "engine hardening", "harden", "1.0", "stability", "soak"],
      "v0.301 engine-only (Node removed)": ["engine", "ah-engine", "rust", "engine-only"],
      "v0.300.0": []
    },
    "default_milestone": "v0.300.0"
  },
  "pr": {
    "size_thresholds": [["size:S", 50], ["size:M", 250], ["size:L", 1000]],
    "size_max": "size:XL",
    "title_regex": "^(feat|fix|docs|chore|ci|build|refactor|perf|test|style|revert)(\\([a-z0-9._/-]+\\))?!?: \\S",
    "title_type": {
      "feat": "type:feature",
      "fix": "type:bug",
      "docs": "type:docs",
      "chore": "type:chore",
      "ci": "type:chore",
      "build": "type:chore",
      "refactor": "type:chore",
      "perf": "type:chore",
      "test": "type:chore",
      "style": "type:chore",
      "revert": "type:chore"
    },
    "linked_issue_regex": "\\b(close[sd]?|fix(e[sd])?|resolve[sd]?)\\s+(talas9/anti-hall)?#\\d+",
    "needs_issue_exempt_heads": ["dev"],
    "risk_paths": {
      "workflow": ["^\\.github/workflows/", "^\\.github/actions/", "^\\.github/scripts/"],
      "shell": ["\\.(sh|bash|zsh|ps1)$", "^scripts/", "^plugins/anti-hall/scripts/"],
      "engine_config": ["^plugins/anti-hall/engine/", "\\.toml$", "ah-engine\\.lock$"],
      "guards": ["guard", "^plugins/anti-hall/hooks/", "^SECURITY\\.md$", "^\\.github/CODEOWNERS$"],
      "dependencies": ["(^|/)package(-lock)?\\.json$", "(^|/)Cargo\\.(toml|lock)$", "(^|/)requirements[^/]*\\.txt$", "^\\.github/dependabot\\.yml$"]
    },
    "risk_labels": { "workflow": "risk:workflow", "guards": "risk:security" },
    "code_paths": ["^plugins/anti-hall/(hooks|scripts|statusline|companion|monitors)/", "^ah-engine/src/"],
    "test_paths": ["^tests/", "^ah-engine/tests/", "_test\\.rs$", "\\.test\\.js$"],
    "doc_paths": ["^docs/", "\\.md$", "^llms\\.txt$"],
    "user_facing_paths": ["^plugins/anti-hall/(hooks|skills|commands|statusline|companion|monitors)/", "^plugins/anti-hall/engine/defaults/", "^plugins/anti-hall/\\.claude-plugin/", "^ah-engine/src/"],
    "docs_drift_paths": ["^CHANGELOG\\.md$", "^docs/", "^README\\.md$", "^llms\\.txt$", "^plugins/anti-hall/skills/.*\\.md$", "^plugins/anti-hall/codex/.*\\.md$", "^AGENTS\\.md$"],
    "docs_drift_label": "docs:needed",
    "docs_drift_base": "main",
    "scanning_max_listed": 10,
    "diff_max_chars": 20000
  },
  "project": {
    "owner": "talas9",
    "number": 3,
    "status_from_label": {
      "status:triage": "Triage",
      "status:accepted": "Accepted",
      "status:in-progress": "In progress",
      "status:blocked": "Blocked"
    },
    "done_status": "Done",
    "status_precedence": ["status:blocked", "status:in-progress", "status:accepted", "status:triage"],
    "stale_hours": 48,
    "stale_label": "status:stale-check",
    "fields": { "last_update": "Last update", "progress": "Progress" },
    "progress_max_chars": 80,
    "progress_regex": "^[>*\\s-]*(Done|Left|Milestone|Progress)\\**\\s*:\\s*(.+)$",
    "trusted_associations": ["OWNER", "MEMBER", "COLLABORATOR"],
    "status_update_status": { "risk": "AT_RISK", "ok": "ON_TRACK" },
    "max_adds_per_run": 30,
    "max_field_writes_per_run": 120,
    "digest_title": "Roadmap digest",
    "digest_marker": "<!-- roadmap-digest -->",
    "digest_next": 5
  },
  "model": {
    "providers": ["claude", "copilot"],
    "default_chain": "claude,copilot",
    "default_daily_cap": 50,
    "models_doc": "Model per job and provider slot. claude = alias used by the primary and secondary Claude tokens (aliases only, never a pinned version). copilot = Copilot CLI --model value, used only on the Copilot fallback; set repo variable COPILOT_MODEL (e.g. auto) to override all jobs when the Copilot plan allows only Auto. The 'default' row applies to any job not listed (strongest). Sources: Copilot CLI model ids https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-command-reference ; Codex model list: codex CLI models cache (codex-cli 0.160) and https://developers.openai.com/codex/models",
    "models": {
      "moderate": { "claude": "haiku", "copilot": "claude-haiku-4.5" },
      "brief": { "claude": "sonnet", "copilot": "claude-sonnet-5.5" },
      "qa-answer": { "claude": "sonnet", "copilot": "claude-sonnet-5.5" },
      "pr-summary": { "claude": "sonnet", "copilot": "claude-sonnet-5.5" },
      "explain": { "claude": "haiku", "copilot": "claude-haiku-4.5" },
      "docs-inspector": { "claude": "sonnet", "copilot": "claude-sonnet-5.5" },
      "digest": { "claude": "sonnet", "copilot": "claude-sonnet-5.5" },
      "default": { "claude": "opus", "copilot": "claude-opus-5.5" }
    },
    "max_input_chars": 20000,
    "max_summary_chars": 1500,
    "allowed_link_prefixes": ["https://github.com/talas9/anti-hall", "https://talas9.github.io/anti-hall"]
  },
  "privacy": {
    "_doc": "Privacy scrub for PR diffs (added lines) and new issue/comment/discussion text. Private names come from the PRIVATE_DENYLIST secret, never from this file.",
    "rules": {
      "home-path": "(/Users/|/home/|[Cc]:\\\\Users\\\\)(?!(you|user|username|me|name|runner|example|someone|alice|bob|jane|john|dev|test|foo|bar|x|USER|USERNAME)[/\\\\])[A-Za-z0-9_-][A-Za-z0-9._-]+[/\\\\]",
      "email": "(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "session-id": "session[\\s_-]?(id)?[\"'\\s:=]{0,4}[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    },
    "email_allow": ["@example\\.(com|org|net|test|invalid)$", "\\.(test|invalid|example|local)$", "noreply", "@users\\.noreply\\.github\\.com$", "@anthropic\\.com$", "@github\\.com$", "^git@github\\.com$", "^git@bitbucket\\.org$", "@(a\\.(com|io)|evil\\.com|openai\\.com)$", "@(p\\.iam\\.gserviceaccount|a\\.googleapis)\\.com$"],
    "skip_paths": ["^tests/fixtures/", "^\\.github/moderation/config\\.json$", "(^|/)package-lock\\.json$", "\\.lock$"],
    "commit_email_allow": ["talas9@gmail.com", "*@users.noreply.github.com", "noreply@github.com"],
    "commit_email_allow_doc": "Author and committer emails allowed on commits in a PR or push range (maintainer identity, GitHub noreply incl. bots, web-merge noreply). Case-insensitive; * matches any local part.",
    "identity_check_since": "2026-10-10T00:00:00Z",
    "identity_check_since_doc": "Commits whose author AND committer dates are both before this instant are grandfathered (not identity-checked); the rule was introduced then. Every later commit is checked against commit_email_allow.",
    "max_hits_reported": 30
  }
}
