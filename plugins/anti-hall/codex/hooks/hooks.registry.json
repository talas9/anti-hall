{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/merge-side-pick.js\" --post",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/git-guard.js\" --audit",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-parent-reply-tracker.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-child-drain.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/agent-reminders\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/precompact-snapshot.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/git-guard.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/command-guard.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/merge-side-pick.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/merge-gate.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/compact-declaration-guard.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(?:collaboration)?spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/orch-on-spawn.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/api-guard.js\"",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/ship-it-guard.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/edit-guard.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/procwatch-advisory\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/engine-role-guard\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/broad-kill-guard\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/lane-test-guard\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/verify-first-full.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/verify-first-orch.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-child-role.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/version-alert.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/codex-availability.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-version.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/claude-cli-version.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/repo-self-drift.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/progress-prune.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/handover-resume.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/handover-hygiene\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/jev-weekly-scorecard.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/jev-review-reminder.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/emit-dedupe-reset.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/defect-nudge.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/repair-on-reload.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/procwatch-advisory\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/engine-role-note\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/task-guard.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/tasklist-guard.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/speculation-guard.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/speculation-judge.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/claim-ledger.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-parent-gate.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-child-gate.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/auto-handover-pause-nag.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/silent-agent-nudge.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/compact-advice-guard.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/sibling-sweep\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/sibling-sweep\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/verify-first.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/task-tracker.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/idle-agent-sweep.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/limit-conserve-inject.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-parent-inbox.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/devswarm-rt-advisory\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-child-turn.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/../anti-hall-node/hooks/repair-on-reload.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node --no-concurrent-recompilation --no-concurrent-sparkplug \"${PLUGIN_ROOT}/../anti-hall-node/hooks/auto-handover.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/procwatch-advisory\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/agent-reminders\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/gh-rt-advisory\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
