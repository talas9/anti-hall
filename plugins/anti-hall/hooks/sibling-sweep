#!/bin/sh
# sibling-sweep is ENGINE-ONLY: there is no Node twin, the ah-engine answers its dispatch-table entry in-process. This no-op is
# the command the table falls back to when the engine cannot answer (engine down, deferral), so the entry keeps an id and a
# readable script like every other entry (the wrapper refuses a ${PLUGIN_ROOT}/... command whose file is missing). It does nothing.
exit 0
