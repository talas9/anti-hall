# Generated from the dispatch table by `ah-engine gen-hooks`. Event rows are: @Event<TAB>timeout[<TAB>empty]; hook rows are: matcher<TAB>timeout<TAB>command.
@PostToolUse	10
Bash	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/merge-side-pick.js" --post
Bash	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/git-guard.js" --audit
Bash	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-parent-reply-tracker.js"
Bash	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-child-drain.js"
*	10	sh "${PLUGIN_ROOT}/hooks/agent-reminders"
@PreCompact	10
*	10	node --no-concurrent-recompilation --no-concurrent-sparkplug "${PLUGIN_ROOT}/../anti-hall-node/hooks/precompact-snapshot.js"
@PreToolUse	45
Bash	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/git-guard.js"
Bash	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/command-guard.js"
Bash	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/merge-side-pick.js"
Bash	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/merge-gate.js"
Bash	10	node --no-concurrent-recompilation --no-concurrent-sparkplug "${PLUGIN_ROOT}/../anti-hall-node/hooks/compact-declaration-guard.js"
^(?:collaboration)?spawn_agent$	10	node --no-concurrent-recompilation --no-concurrent-sparkplug "${PLUGIN_ROOT}/../anti-hall-node/hooks/orch-on-spawn.js"
apply_patch|Bash	45	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/api-guard.js"
apply_patch|Bash	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/ship-it-guard.js"
apply_patch	10	node --no-concurrent-recompilation --no-concurrent-sparkplug "${PLUGIN_ROOT}/../anti-hall-node/hooks/edit-guard.js"
Bash	10	sh "${PLUGIN_ROOT}/hooks/procwatch-advisory"
Bash	10	sh "${PLUGIN_ROOT}/hooks/engine-role-guard"
Bash	10	sh "${PLUGIN_ROOT}/hooks/broad-kill-guard"
*	10	sh "${PLUGIN_ROOT}/hooks/burn-breaker"
apply_patch	10	sh "${PLUGIN_ROOT}/hooks/uncommitted-guard"
Bash	10	sh "${PLUGIN_ROOT}/hooks/queued-wait-guard"
Bash	10	sh "${PLUGIN_ROOT}/hooks/lane-test-guard"
@SessionStart	10
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/verify-first-full.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/verify-first-orch.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-child-role.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/version-alert.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/codex-availability.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-version.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/claude-cli-version.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/repo-self-drift.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/progress-prune.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/handover-resume.js"
*	10	sh "${PLUGIN_ROOT}/hooks/handover-hygiene"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/jev-weekly-scorecard.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/jev-review-reminder.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/emit-dedupe-reset.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/defect-nudge.js"
*	10	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/repair-on-reload.js"
*	10	sh "${PLUGIN_ROOT}/hooks/procwatch-advisory"
*	10	sh "${PLUGIN_ROOT}/hooks/engine-role-note"
@Stop	30
*	30	node --no-concurrent-recompilation --no-concurrent-sparkplug "${PLUGIN_ROOT}/../anti-hall-node/hooks/task-guard.js"
*	30	node --no-concurrent-recompilation --no-concurrent-sparkplug "${PLUGIN_ROOT}/../anti-hall-node/hooks/tasklist-guard.js"
*	30	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/speculation-guard.js"
*	30	node "${PLUGIN_ROOT}/../anti-hall-node/hooks/speculation-judge.js"
