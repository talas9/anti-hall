*	30	node --no-concurrent-recompilation --no-concurrent-sparkplug "${PLUGIN_ROOT}/../anti-hall-node/hooks/compact-advice-guard.js"
*	10	sh "${PLUGIN_ROOT}/hooks/sibling-sweep"
@SubagentStop	10
