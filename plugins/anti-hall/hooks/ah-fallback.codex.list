*	10	node --no-concurrent-recompilation --no-concurrent-sparkplug "${PLUGIN_ROOT}/../anti-hall-node/hooks/devswarm-parent-inbox.js"
*	10	sh "${PLUGIN_ROOT}/hooks/devswarm-rt-advisory"
