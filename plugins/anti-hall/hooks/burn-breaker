#!/bin/sh
# burn-breaker is ENGINE-ONLY: there is no Node twin, the ah-engine answers its dispatch-table entry in-process (the thresholds, lists and
# texts are plugin data, engine/defaults/burn.toml). This no-op is the command the table falls back to when the engine cannot answer, so
# the entry keeps an id and a readable script like every other entry. It does nothing.
exit 0
