{
  "version": 1,
  "rules": [
    {
      "id": "git-no-force-push",
      "events": ["PreToolUse"],
      "tools": ["Bash"],
      "field": "command",
      "pattern": "\\bgit\\s+(?:-\\S+\\s+)*push\\b[^|;&\\n]*(?:\\s--force(?:-with-lease)?\\b|\\s-[a-zA-Z]*f[a-zA-Z]*\\b|\\s\\+\\S|\\s--(?:delete|mirror)\\b|\\s-d\\b|\\s:\\S)",
      "action": "deny",
      "message_ref": "git.msg_force_push"
    },
    {
      "id": "git-no-ai-self-credit",
      "events": ["PreToolUse"],
      "tools": ["Bash"],
      "field": "command",
      "pattern": "(?is)\\bgit\\b[^\\n]*\\bcommit\\b.*(?:co-authored-by\\s*[:=]\\s*(?:claude|codex|gpt|openai|anthropic|copilot)|generated with\\s*\\[?\\s*(?:claude|codex|chatgpt))",
      "action": "deny",
      "message_ref": "git.msg_commit_credit"
    },
    {
      "id": "rm-rf-root-or-home",
      "events": ["PreToolUse"],
      "tools": ["Bash"],
      "field": "command",
      "pattern": "\\brm\\s+(?:-[a-zA-Z]*\\s+)*-[a-zA-Z]*(?:rf|fr)[a-zA-Z]*\\s+(?:--\\s+)?(?:/|~|\\$HOME)/?(?:\\s|$)",
      "action": "warn",
      "message": "`rm -rf` on / or the home directory. Confirm with the owner before deleting data."
    }
  ]
}
